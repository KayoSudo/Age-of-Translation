msgstr "[farm/] Almshouse"

msgid "CULTURE_THEO_RESEARCH@SKILL_2@DESCRIPTION"
msgstr "Grants non-Theocracy units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.PILGRIM.Hyperlink} if a {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}, {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} or {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.CRUSEDER.Hyperlink} if a {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink} or {GLOBAL.PROPERTIES.FIGHTER.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.VENERATED.Hyperlink} if a {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}."

