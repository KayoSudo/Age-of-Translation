msgstr "Order Initiation"

msgid "CULTURE_THEO_RESEARCH@SKILL_2@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.PILGRIM.Hyperlink}"

msgid "CULTURE_THEO_RESEARCH@SKILL_1@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CRUSEDER.Hyperlink}"

msgid "PILGREIMABILTY1@E01@SPELL"
msgstr "Target friendly unit:[bulletlist][bullet/]Gains {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[bullet/]Heals for +5 <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]For each friendly {GLOBAL.PROPERTIES.PILGRIM.Hyperlink} unit in battle heal 3 <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "CRUSADERBILTY1@E01@SPELL"
msgstr "Target enemy unit:[bulletlist][bullet/]Inflict {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Deal 3 {GLOBAL.SpiritDamageConcept.Hyperlink} and 3 {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]For each friendly {GLOBAL.PROPERTIES.CRUSEDER.Hyperlink} unit this spell deals 2 {GLOBAL.SpiritDamageConcept.Hyperlink} and 2 {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "CRUSADERBILTY1@SKILL_2@NAME"
msgstr "Divine Smite"

msgid "CRUSADERBILTY1@SKILL_1@NAME"
msgstr "Blessing of Health"

msgid "HOSPITAL@SKILL_1@NAME"
msgstr "[bulletlist][bullet/]+10 {GLOBAL.FoodConcept.Hyperlink}.[bullet/]+10 {GLOBAL.StructureProductionConcept.Hyperlink}[bullet/]+5 {GLOBAL.CityStabilityConcept.Hyperlink} and +3 per adjacent {GLOBAL.ProvinceImprovementConcept.Hyperlink}.[bullet/]Count as a {GLOBAL.FarmConcept.Hyperlink}."

msgid "CULTUREDISCRIPT@LORE@LORE"
msgstr "A pious and zealous society that lead the masses by the heart. They prefer a defensive or aggressive tactic based on the chosen Order."

msgid "CULTUREDISCRIPT@LORE@LORE1"
msgstr "A pious and zealous society that lead the masses by the heart. They prefer a defensive or aggressive tactics based on the chosen Order."

msgid "CULTUREDISCRIPT@PILGRIM@LORE"
msgstr "Your people are pious monks and healers with a focus on helping allies and outlasting your enemies.[bulletlist][bullet/]Unit roster is support focused with abilities that help allies.[bullet/]Granges adds Add all tier 3 and tier 2 Knightly units to the Rally of Lieges."

msgid "CULTUREDISCRIPT@CRUSADER@LORE"
msgstr "Your people are zealous knights and soldiers with a focus on damaging your enemies.[bulletlist][bullet/]Unit roster is damage focused with abilities that damage or debuff enemies.[bullet/]Commandery Add all tier 3 and tier 2 Monastic units to the Rally of Lieges."

msgid "HEALER@TRITDSCRIPT"
msgstr "Units regenerate an additional +8<<m:{GLOBAL.HitPointConcept.Hyperlink}>> on the strategic map. This bonus stacks."

msgid "DIVCAMPOIN@TRITDSCRIPT"
msgstr "[battlesaint/]Divine Champions"

msgid "DIVCAMPOIN@DISCRIPTIONS"
msgstr "While this unit is in the army all units gain, Doesn't stack.[br/]+1 {GLOBAL.DefenseConcept.Hyperlink}[br/]+1 {GLOBAL.ResistanceConcept.Hyperlink}[br/]+2 {GLOBAL.FireResistanceConcept.Hyperlink}[br/]+2 {GLOBAL.SpiritResistanceConcept.Hyperlink}"

msgid "DIVCAMPOIN1@DISCRIPTIONS"
msgstr "This resource is used to recruit and maintain Divine Champion units. (Limit 1)[br/]Income is based on number of vassals, Commandery and Monastic Grange."

msgid "PAVAESIRSHIEL@DESCRIPTION31"
msgstr "Reduce range and movement by 1 and {GLOBAL.DefenseModeConcept.Hyperlink} {GLOBAL.SHIELD_WALL.Hyperlink} grant adjacent units +3 {GLOBAL.DefenseConcept.Hyperlink}.[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink}.[bullet/]Lose {GLOBAL.PROPERTIES.ALL_ROUND_AWARENESS.Hyperlink} and {GLOBAL.PROPERTIES.SIHIELDATCCKA.Hyperlink}."

msgid "PAVAESIRSHIELON@DESCRIPTION31"
msgstr "Increase range and movement by 1 and {GLOBAL.DefenseModeConcept.Hyperlink} {GLOBAL.SHIELD_WALL.Hyperlink} no longer grant adjacent units +3 {GLOBAL.DefenseConcept.Hyperlink}.[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.ALL_ROUND_AWARENESS.Hyperlink} {GLOBAL.PROPERTIES.SIHIELDATCCKA.Hyperlink}.[bullet/]Lose {GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink}."

msgid "PAVAESIRSHIEL@NAME"
msgstr "Defensive Stance"

msgid "PAVAESIRSHIELON@NAME"
msgstr "Offensive Stance"
