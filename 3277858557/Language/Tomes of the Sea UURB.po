msgid "TOME@STORMSIREN@UURB@ONE@NAME"
msgstr "Storm Cloak"

msgid "TOME@STORMSIREN@UURB@ONE@DESC"
msgstr "+4 lightning resistance and has {GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink}"

msgid "TOME@STORMSIREN@UURB@TWO@NAME"
msgstr "Storm-Infused"

msgid "TOME@STORMSIREN@UURB@TWO@DESC"
msgstr "Your basic magic attacks now chains to another enemy target within 3 hexes"

msgid "TOME@UNDINE@UURB@ONE@NAME"
msgstr "Sea's Loving Embrace"

msgid "TOME@UNDINE@UURB@ONE@DESC"
msgstr "Your base attacks grant adjacent friendly units by 6 {GLOBAL.TemporaryHitPointConcept.Hyperlink}"

msgid "TOME@UNDINE@UURB@TWO@NAME"
msgstr "Sea's Protection"

msgid "TOME@UNDINE@UURB@TWO@DESC"
msgstr "This unit gains {GLOBAL.PROPERTIES.SUPPORT_BOLSTERED_DEFENSE_ABILITY_MODIFIER.Hyperlink} and {GLOBAL.PROPERTIES.SUPPORT_BOLSTERED_RESISTANCE_ABILITY_MODIFIER.Hyperlink}"

msgid "TOME@SHOCKSHELL@UURB@TWO@NAME"
msgstr "Self-Sustaining Shell"

msgid "TOME@SHOCKSHELL@UURB@TWO@DESC"
msgstr "At the start and end of this unit's turn, remove all stacks of {GLOBAL.PROPERTIES.SUNDERED_DEFENSE_DEFENSE.Hyperlink}"

msgid "TOME@BEHEMOTH@UURB@ONE@NAME"
msgstr "Greater Intimidation"

msgid "TOME@BEHEMOTH@UURB@ONE@DESC"
msgstr "Gain 2 stacks of {GLOBAL.SKILLS.KNIGHT_TYRANT_DEMORALIZING_AURA.Hyperlink}"

msgid "TOME@BEHEMOTH@UURB@TWO@NAME"
msgstr "Monarch of the Sea"

msgid "TOME@BEHEMOTH@UURB@TWO@DESC"
msgstr "Has {GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink} and {GLOBAL.PROPERTIES.BOLSTERING_REGENERATION.Hyperlink}"

msgid "TOME@FLYINGNIMU@UURB@ONE@NAME"
msgstr "Nimu's Care"

msgid "TOME@FLYINGNIMU@UURB@ONE@DESC"
msgstr "This unit gains {GLOBAL.PROPERTIES.SUPPORT_STRENGTHENED_ABILITY_MODIFIER.Hyperlink} and {GLOBAL.PROPERTIES.SUPPORT_REGENERATION_ABILITY_MODIFIER.Hyperlink}"

msgid "TOME@RUTHLESSRAIDER@UURB@ONE@NAME"
msgstr "Raider's Glee"

msgid "TOME@RUTHLESSRAIDER@UURB@ONE@DESC"
msgstr "When this unit kills another unit, this unit gains 2 {GLOBAL.UnitMoraleConcept.Hyperlink} per tier of the unit killed."

msgid "TOME@RUTHLESSRAIDER@UURB@TWO@NAME"
msgstr "Imbodiment of Greed"

msgid "TOME@RUTHLESSRAIDER@UURB@TWO@DESC"
msgstr ""
"This unit's base attacks have a 30% chance to inflict {GLOBAL.PROPERTIES.GILDED.Hyperlink}\n"
"Effects [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]are increased[/hyperlink] for non-repeating attacks."
