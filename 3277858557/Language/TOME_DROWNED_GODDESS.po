msgid "TOME_DROWNED_GODDESS@TOME@NAME"
msgstr "Tome of the Drowned Goddess"

msgid "TOME_DROWNED_GODDESS@TOME@LORE_DESCRIPTION"
msgstr "“There is, one knows not what sweet mystery about this sea, whose gently awful stirrings seem to speak of some hidden soul beneath...”"

msgid "TOME_DROWNED_GODDESS@TOME@LORE_AUTHOR"
msgstr "Herman Melville"

msgid "TOME_DROWNED_GODDESS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Receive the blessings of the Drowned Goddess and pull your foes into the depths for eternity."

msgid "TOME_DROWNED_GODDESS@SKILL_1@NAME"
msgstr "Thousand Year Storm"

msgid "TOME_DROWNED_GODDESS@SKILL_1@DESCRIPTION"
msgstr "At the start of combat:[bulletlist][bullet/]Towers and support structures are destroyed.[bullet/]Enemy units sustain {GLOBAL.PROPERTIES.WET.Hyperlink}, 10 {GLOBAL.FrostDamageConcept.Hyperlink}, and 10 {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "TOME_DROWNED_GODDESS@UNIT1@ABILITY1@NAME"
msgstr "Sea's Blessing"

msgid "TOME_DROWNED_GODDESS@SKILL_2@NAME"
msgstr "Swarm of the Deep"

msgid "TOME_DROWNED_GODDESS@SKILL_2@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.KRAKEN.Hyperlink} and a full army of random Tier II Ocean Units on target water hex with a small chance of a Tier III Ocean Unit."

msgid "TOME_DROWNED_GODDESS@SKILL_3@NAME"
msgstr "Goddess' Tears"

msgid "TOME_DROWNED_GODDESS@SKILL_3@DESCRIPTION"
msgstr "All units in a 3 hex radius become {GLOBAL.PROPERTIES.WET.Hyperlink} and:[bulletlist][bullet/]Target friendly unit heals +20 <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]Fiendly units heals 5 fewer<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> for each hex away from the target.[bullet/]Enemy units within the hexes suffers 2x {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}"

msgid "TOME_DROWNED_GODDESS@SKILL_4@NAME"
msgstr "Touch of the Drowned"

msgid "TOME_DROWNED_GODDESS@SKILL_4@DESCRIPTION"
msgstr "Blessed by the Drowned Goddess, your race gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VEC_WATER_CAMO.Hyperlink}.[bullet/]Attackers have a 60% chance to become {GLOBAL.PROPERTIES.ENTHRALLED.Hyperlink}.[bullet/]Ignore defensive penalties of and start every combat {GLOBAL.PROPERTIES.WET.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.BURNING.Hyperlink} immunity.[bullet/]+2 {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.AMPHIBIOUS_MOVEMENT.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ELUSIVE.Hyperlink}"

msgid "TOME_DROWNED_GODDESS@SKILL_5@NAME"
msgstr "Summon Undine"

msgid "TOME_DROWNED_GODDESS@SKILL_5@DESCRIPTION"
msgstr "Summons an Undine to target hex."

msgid "TOME_DROWNED_GODDESS@SKILL_6@NAME"
msgstr "Drowned Behemoth"

msgid "TOME_DROWNED_GODDESS@SKILL_6@DESCRIPTION"
msgstr ""

msgid "TOME_DROWNED_GODDESS@HERO_SKILL@NAME"
msgstr "Enhancing Symbiosis"

msgid "TOME_DROWNED_GODDESS@HERO_SKILL@DESCRIPTION"
msgstr "Enhancing Symbiosis"

msgid "TOME_DROWNED_GODDESS@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[Conduit/] Tomb of the Drowned Goddess"

msgid "TOME_DROWNED_GODDESS@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]Must be built on a Coastal province in your {GLOBAL.ThroneCityConcept.Hyperlink}.[bullet/]+2 {GLOBAL.ImperiumConcept.Hyperlink} and +3 {GLOBAL.GoldConcept.Hyperlink} for each Coastal Region in the Domain.[bullet/]Spells can be cast even if the {GLOBAL.LeaderConcept.Hyperlink} is in the void.[bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink}."

msgid "TOME_DROWNED_GODDESS@ENTHRALLED@NAME"
msgstr "Enthralled"

msgid "TOME_DROWNED_GODDESS@ENTHRALLED@DESCRIPTION"
msgstr "All attacks targeting this unit are {GLOBAL.FlankingConcept.Hyperlink} attacks."

msgid "TOME_DROWNED_GODDESS@ABILITY1@DESCRIPTION"
msgstr "Friendly units in a 2-hex radius gain:[bulletlist][bullet/]2 {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[bullet/]Heal +10 {GLOBAL.TemporaryHitPointConcept.Hyperlink}. [bullet/]Gain 2 {GLOBAL.PROPERTIES.FORTUNE.Hyperlink}."

msgid "TOME_DROWNED_GODDESS@UNIT1@ABILITY2@NAME"
msgstr "Hypnotize"

msgid "TOME_DROWNED_GODDESS@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Grants a base 60% chance of making target {GLOBAL.PROPERTIES.ENTHRALLED.Hyperlink} enemy unit become {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} for 3 turns. If the effect fails, or the target is not {GLOBAL.PROPERTIES.ENTHRALLED.Hyperlink}, the target is {GLOBAL.PROPERTIES.ENTHRALLED.Hyperlink} instead."

msgid "TOME_DROWNED_GODDESS@UNIT2@ABILITY1@NAME"
msgstr "Frost Breath"

msgid "TOME_DROWNED_GODDESS@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Frost Breath"

msgid "TOME_DROWNED_GODDESS@UNIT2@ABILITY2@NAME"
msgstr "Ancient Symbiosis"

msgid "TOME_DROWNED_GODDESS@UNIT2@ABILITY2@DESCRIPTION"
msgstr ""
"Link to a friendly unit.\n"
"\n"
"While linked:[bulletlist][bullet/]Friendly unit gains 2 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} each turn.[bullet/]This unit gains {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} and {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} each turn.[bullet/]Damage sustained by linked unit is transferred to this unit with a 20% reduction. Re-casting the ability will move the Enhancing Symbiosis portion of this ability to a separate target."

msgid "TOME_DROWNED_GODDESS@UNIT2@ABILITY3@NAME"
msgstr "Ancient Blessing"

msgid "TOME_DROWNED_GODDESS@UNIT2@ABILITY3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain +30 {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Has negative status effects removed.[bullet/]Enters defense mode."

msgid "TOME_DROWNED_GODDESS@TOME@UNIT1@NAME"
msgstr "Undine"

msgid "TOME_DROWNED_GODDESS@TOME@TOUGH_WATERS@NAME"
msgstr "Rough Waters"

msgid "TOME_DROWNED_GODDESS@TOME@TOUGH_WATERS@DESC"
msgstr ""
"Enemies in water hexes in your friendly territories:[bulletlist][bullet/]Suffer 1x {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink} until the end of battle (unless unit has {GLOBAL.PROPERTIES.WATER_MOVEMENT.Hyperlink})[bullet/]Must spend 4 more movement points to move through the water hex[/bulletlist]\n"
"Friendly units with {GLOBAL.PROPERTIES.WATER_MOVEMENT.Hyperlink} in water hexes in your friendly territories:[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.HASTENED.Hyperlink}  until the end of battle[/bulletlist]\n"
"Upkeep: 30 {GLOBAL.ManaConcept.Hyperlink}"
