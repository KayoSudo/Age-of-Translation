msgid "TOME_DREAD_PIRATES@TOME@NAME"
msgstr "Tome of the Scourge Captain"

msgid "TOME_DREAD_PIRATES@TOME@LORE_DESCRIPTION"
msgstr "\"No survivors? Then, where do the stories come from, I wonder?\""

msgid "TOME_DREAD_PIRATES@TOME@LORE_AUTHOR"
msgstr "Jack Sparrow"

msgid "TOME_DREAD_PIRATES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Curse your enemies and pillage their treasures with the might of the scourge in your sails. They will learn to fear to fear the things dancing in the corrupted shadows in the sea."

msgid "TOME_DREAD_PIRATES@SKILL_1@NAME"
msgstr "Restless Raider"

msgid "TOME_DREAD_PIRATES@SKILL_1@DESCRIPTION"
msgstr "A ghostly pirate, sent to Davey Jones' locker, now returned to plunder once more."

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY1@NAME"
msgstr "Soul Shot"

msgid "TOME_DREAD_PIRATES@SKILL_2@NAME"
msgstr "Summon Ghost Ship"

msgid "TOME_DREAD_PIRATES@SKILL_2@DESCRIPTION"
msgstr "Summons a ghost ship to target hex"

msgid "TOME_DREAD_PIRATES@SKILL_3@NAME"
msgstr "Wailing Call"

msgid "TOME_DREAD_PIRATES@SKILL_3@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.BANSHEE_UNIT.Hyperlink} in target hex with 1 AP."

msgid "TOME_DREAD_PIRATES@SKILL_4@NAME"
msgstr "Surge of Corrupted Tide"

msgid "TOME_DREAD_PIRATES@SKILL_4@DESCRIPTION"
msgstr "At the start of battle: [bulletlist][bullet/]Summon 6 Lesser Tide Spirits to attacker's side until end of battle. [bullet/]Defenders are afflicted with 2 {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}."

msgid "TOME_DREAD_PIRATES@SKILL_5@NAME"
msgstr "Ghostly Bazaar"

msgid "TOME_DREAD_PIRATES@SKILL_5@DESCRIPTION"
msgstr "Gain +2 {GLOBAL.GoldConcept.Hyperlink} and +1 {GLOBAL.SoulConcept.Hyperlink} for each coastal province in domain."

msgid "TOME_DREAD_PIRATES@SKILL_6@NAME"
msgstr "Golden Pact"

msgid "TOME_DREAD_PIRATES@SKILL_6@DESCRIPTION"
msgstr ""
"Share in the plunder of the Scourge Captain, granting enchanted units: [bulletlist][bullet/]{GLOBAL.PROPERTIES.FIGHTER.Hyperlink}, {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}, and {GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink}:[bulletlist][bullet/]{GLOBAL.PROPERTIES.DROWNING_AURA.Hyperlink}[/bulletlist][/bulletlist][bulletlist][bullet/]{GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink}, {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink}, {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}:[bulletlist][bullet/]Base {GLOBAL.MagicConcept.Hyperlink} and {GLOBAL.RangedConcept.Hyperlink} attacks have a 60% chance to inflict {GLOBAL.PROPERTIES.TREASURE_MARKED.Hyperlink}.[/bulletlist][/bulletlist]\n"
"\n"
"Effects [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]are increased[/hyperlink] for non-repeating attacks."

msgid "TOME_DREAD_PIRATES@HERO_SKILL@NAME"
msgstr "Drowner's Chosen"

msgid "TOME_DREAD_PIRATES@HERO_SKILL@DESCRIPTION"
msgstr "Attackers have a 60% chance of being afflicted with {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}."

msgid "TOME_DREAD_PIRATES@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[Researchpost/] Haunted Cove"

msgid "TOME_DREAD_PIRATES@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]Must be built on a Coast province.[bullet/]+20 {GLOBAL.KnowledgeConcept.Hyperlink}. [bullet/]+2 {GLOBAL.ManaConcept.Hyperlink} per adjacent coastal hex. [bullet/]Enemy attackers in the domain begin battle suffering from 2 {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}. [bullet/]Counts as a {GLOBAL.ResearchPostConcept.Hyperlink}."

msgid "TOME_DREAD_PIRATES@ENTHRALLED@NAME"
msgstr "Enthralled"

msgid "TOME_DREAD_PIRATES@ENTHRALLED@DESCRIPTION"
msgstr "All attacks targeting this unit are {GLOBAL.FlankingConcept.Hyperlink} attacks."

msgid "TOME_DREAD_PIRATES@ABILITY1@DESCRIPTION"
msgstr "Fires a bolt at a target within range, dealing damage and:[bulletlist] [bullet/]Inflicting 2 {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}."

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY2@NAME"
msgstr "Drowning Aura"

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY2@DESCRIPTION"
msgstr "At the start of each turn, adjacent enemies have a 60% chance of sustained {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}. Does not stack."

msgid "TOME_DREAD_PIRATES@UNIT2@ABILITY1@NAME"
msgstr "Frost Breath"

msgid "TOME_DREAD_PIRATES@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Frost Breath"

msgid "TOME_DREAD_PIRATES@UNIT2@ABILITY2@NAME"
msgstr "Armour of Thorns"

msgid "TOME_DREAD_PIRATES@UNIT2@ABILITY2@DESCRIPTION"
msgstr "Armour of Thorns"

msgid "TOME_DREAD_PIRATES@UNIT2@ABILITY3@NAME"
msgstr "Ancient Blessing"

msgid "TOME_DREAD_PIRATES@UNIT2@ABILITY3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain +30 {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Has negative status effects removed.[bullet/]Enters defense mode."

msgid "TOME_DREAD_PIRATES@UNIT1@NAME_OVERRIDE"
msgstr "Base 60% chance of inflicting {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}."

msgid "TOME_DREAD_PIRATE@STATUS1@NAME"
msgstr "Curse of Drowning"

msgid "TOME_DREAD_PIRATE@STATUS2@NAME"
msgstr "Treasure Marked"

msgid "TOME_DREAD_PIRATE@STATUS1@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]Units suffer 4 {GLOBAL.FrostDamageConcept.Hyperlink} for each stack per turn.[bullet/]On unit death, up to 2 hostile units up to 2 hexes away gain a stack of {GLOBAL.PROPERTIES.CURSE_OF_DROWNING.Hyperlink}. [bullet/]Stacks up to 5 times.\n"
"Has no effect on units with {GLOBAL.PROPERTIES.AMPHIBIOUS_MOVEMENT.Hyperlink} or {GLOBAL.PROPERTIES.WATER_MOVEMENT.Hyperlink} "

msgid "TOME_DREAD_PIRATE@STATUS2@DESCRIPTION"
msgstr "When this unit dies, the winner of the battle gains 3 {GLOBAL.GoldConcept.Hyperlink} and 1 {GLOBAL.SoulConcept.Hyperlink} per unit tier."

msgid "TOME_DREAD_PIRATE@STATUS1@BLOCK_STRING"
msgstr "Blocked: Immune to Mana Burn"

msgid "TOME_DREAD_PIRATE@STATUS3@NAME"
msgstr "Base 60% chance of inflicting {GLOBAL.PROPERTIES.TREASURE_MARKED.Hyperlink}"

msgid "TOME_DREAD_PIRATE@STATUS3@DESCRIPTION"
msgstr "Base 90% chance of inflicting {GLOBAL.PROPERTIES.TREASURE_MARKED.Hyperlink}"

msgid "TOME_DREAD_PIRATE@STATUS4@NAME"
msgstr ""
"Base 60% chance of inflicting {GLOBAL.PROPERTIES.TREASURE_MARKED.Hyperlink}\n"
"\n"
"Effects [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]are increased[/hyperlink] for Single Shot attacks"

msgid "TOME_DREAD_PIRATE@STATUS4@DESCRIPTION"
msgstr "Purge Ramp II"

msgid "TOME_DREAD_PIRATE@STATUS5@NAME"
msgstr "Mana Burn"

msgid "TOME_DREAD_PIRATE@STATUS5@DESCRIPTION"
msgstr "Mana Rod"

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY3@NAME"
msgstr "Nimu Surge"

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY3@DESCRIPTION"
msgstr "Nimu Surge Description"

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY4@NAME"
msgstr "Mana Vent"

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY4@DESCRIPTION"
msgstr "Hypnotize"

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY5@NAME"
msgstr "Hypnotize"

msgid "TOME_DREAD_PIRATES@UNIT1@ABILITY5@DESCRIPTION"
msgstr "Hypnotize"

msgid "TOME_DREAD_PIRATES@PASSIVE@NAME"
msgstr "Sea Ghost Lord"

msgid "TOME_DREAD_PIRATES@PASSIVE@DESCRIPTION"
msgstr "Units you control with {GLOBAL.PROPERTIES.WATER_MOVEMENT.Hyperlink} become {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} and have {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} to traverse on land"
