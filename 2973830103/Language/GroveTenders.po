msgid "SocietyTrait@GroveTenders@Name"
msgstr "Grove Tenders"

msgid "SocietyTrait@GroveTenders@Lore"
msgstr "They coexist with nature and thrive in forests."

msgid "SocietyTrait@GroveTenders@Bio"
msgstr "They coexist with nature and thrive in forests."

msgid "SocietyTrait@GroveTenders@VineFortress"
msgstr ""
"Cities gain +2 [garrison/][hyperlink,GLOBAL."
"FortificationHealthConcept]Fortification Health[/hyperlink] for every forest "
"in their domain."

msgid "SocietyTrait@GroveTenders@ForestMana"
msgstr ""
"Forests grant +1 [mana/] [hyperlink,GLOBAL.ManaConcept]Mana[/hyperlink] and "
"+1 [food/] [hyperlink,GLOBAL.FoodConcept]Food[/hyperlink]."

msgid "SocietyTrait@GroveTenders@PlantRank"
msgstr "{GLOBAL.PROPERTIES.PLANT.Hyperlink} units have + 1 Rank."

msgid "SocietyTrait@GroveTenders@PlantUnit"
msgstr "Starts with an additional {GLOBAL.PROPERTIES.PLANT.Hyperlink} unit."

msgid "SocietyTrait@GroveTenders@HealingRoots"
msgstr ""
"All {GLOBAL.PROPERTIES.PLANT.Hyperlink} units gain {GLOBAL.PROPERTIES."
"HEALING_ROOTS_PROPERTY_GROUP.Hyperlink}."
