msgid "TOME_SHADOWFLAME@SHADOWMIST@NAME"
msgstr "Shadow Mist"

msgid "TOME_SHADOWFLAME@SHADOWMIST@DESCRIPTION"
msgstr ""
"At start of combat, this unit is {GLOBAL.PROPERTIES.OBSCURED.Hyperlink} for "
"3 turns"

msgid "TOME_DESIRE@SHADOWFEY@NAME"
msgstr "Darkfey Guile"

msgid "TOME_DESIRE@SHADOWFEY@DESCRIPTION"
msgstr ""
"At the start of its turn, if this unit is {GLOBAL.PROPERTIES.OBSCURED."
"Hyperlink} or in a {GLOBAL.MistConcept.Hyperlink} cloud, it gains {GLOBAL."
"PROPERTIES.HASTENED.Hyperlink} for 1 turn"

msgid "TOME_DESIRE@SHADOWFLAME_AUTOSPELL@NAME"
msgstr "Shadowflame Curse"

msgid "TOME_DESIRE@SHADOWFLAME_AUTOSPELL@DESCRIPTION"
msgstr ""
"This unit, at the start of its turn, if inflicted with {GLOBAL.PROPERTIES."
"SHADOWFLAME.Hyperlink}, {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink}, {GLOBAL."
"PROPERTIES.FROZEN.Hyperlink} or {GLOBAL.PROPERTIES.BURNING.Hyperlink}, has "
"all healing they received reduced by 50%"

msgid "TOME_DESIRE@UNIT_PROPERTY1@EXTRA"
msgstr "Inflict {GLOBAL.PROPERTIES.SHADOWFLAME.Hyperlink}"

msgid "TOME_DESIRE@HELLISH_UNDEAD@NAME"
msgstr "Shadowflame Undead"

msgid "TOME_DESIRE@HELLISH_UNDEAD@DESC"
msgstr ""
"Most Shadowflame Undead have lost {GLOBAL.PROPERTIES.FLYING_MOVEMENT."
"Hyperlink}, but their affinity grants them:[bulletlist][bullet/]{GLOBAL."
"PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.SHADOWFLAME."
"Hyperlink} Immunity[bullet/]{GLOBAL.PROPERTIES."
"STATUS_EFFECT_IMMUNITY_BURNING.Hyperlink} Immunity[bullet/]+4 {GLOBAL."
"FireResistanceConcept.Hyperlink}[bullet/]Lava Walk"

msgid "TOME_DESIRE@NON_RACIAL@NAME"
msgstr "Non-Racial"

msgid "TOME_DESIRE@NON_RACIAL@DESC"
msgstr "Units that are not of any particular race"
