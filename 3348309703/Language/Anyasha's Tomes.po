msgstr ""
"Transform into a {GLOBAL.UNITS.VEC_SABLESERPENT_UNIT.Hyperlink} for 3 turns"

msgid "TOME_SABLE@UNIT_4@NAME"
msgstr "Midnight Boar"

msgid "TOME_SABLE@SKILL_3@NAME"
msgstr "Fearsome Beasts"

msgid "TOME_SABLE@SKILL_3@DESCRIPTION"
msgstr ""
"Enchanted units' attacks intimidate their enemies and gains {GLOBAL."
"PROPERTIES.JOY_SIPHONERS_PROPERTY_GROUP.Hyperlink}"

msgid "TOME_SABLE@SKILL_4@NAME"
msgstr "New Moon Rite"

msgid "TOME_SABLE@SKILL_4@DESCRIPTION"
msgstr ""
"Target enemy suffering {GLOBAL.LowMoraleConcept.Hyperlink} or worse {GLOBAL."
"UnitMoraleConcept.Hyperlink}:[bulletlist][bullet/]Suffers 10 {GLOBAL."
"LightningDamageConcept.Hyperlink} and 10 {GLOBAL.FrostDamageConcept."
"Hyperlink}[bullet/]60% chance to cause {GLOBAL.PROPERTIES.LUNACY.Hyperlink}"
"[bullet/]Friendly units within 2-hexes are healed +10{GLOBAL."
"TemporaryHitPointConcept.Hyperlink}"

msgid "TOME_SABLE@SKILL_5@NAME"
msgstr "Blessing of Lunacy"

msgid "TOME_SABLE@SKILL_5@DESCRIPTION"
msgstr ""
"Enchanted units spread a mystic euphoria to their enemies, causing their "
"base attacks:[bulletlist][bullet/]Base 20% chance to inflict {GLOBAL."
"PROPERTIES.LUNACY.Hyperlink} to targets with {GLOBAL.PROPERTIES.MOONFIRE."
"Hyperlink} and {GLOBAL.LowMoraleConcept.Hyperlink}[bullet/]Base 60% chance "
"to inflict {GLOBAL.PROPERTIES.MOONFIRE.Hyperlink}[/bulletlist]\n"
"Effects [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]are increased[/"
"hyperlink] for non-repeating attacks"

msgid "TOME_DEMON@HELLISH_REANIMATION@NAME"
