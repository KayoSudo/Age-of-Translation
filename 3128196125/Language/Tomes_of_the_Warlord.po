msgstr "placeholder name"

msgid "DESCRIPTION@PLACEHOLDER"
msgstr "placeholder description"

msgid "TOME_LEGIONS@TOME@NAME"
msgstr "Tome of Legions"

msgid "TOME_LEGIONS@TOME@DESCRIPTION"
msgstr ""
"Muster relentless armies instilled with martial discipline and led by "
"experienced veterans."

msgid "TOME_LEGIONS@TOME@LORE_DESCRIPTION"
msgstr ""
"\"I gathered the most vigorous orcs of my forces and informed them they would "
"be wearing armor and wielding a pike.  The brutes chafed at this order, but "
"after decapitating a few insubordinates they agreed to fight according to my "
"way.  A price worth paying; a trained cohort in close formation will defeat "
"many times their number of disordered rabble.\""

msgid "TOME_LEGIONS@TOME@LORE_AUTHOR"
msgstr "Khatun Shura, Shad'rai Warlord"

msgid "TOME_LEGIONS@SKILL_01@NAME"
msgstr "Cohort"

msgid "TOME_LEGIONS@SKILL_01@DESCRIPTION"
msgstr ""
"A {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} that specializes in [hyperlink,"
"GLOBAL.RetaliationConcept]Retaliation Attacks[/hyperlink].\n"
"Can also be created by the Form Cohort spell."

msgid "TOME_LEGIONS@SKILL_01@UNIT@NAME"
msgstr ""

msgid "TOME_LEGIONS@SKILL_01@MODIFIER@NAME"
msgstr "Spear Wall"

msgid "TOME_LEGIONS@SKILL_01@MODIFIER@DESCRIPTION"
msgstr ""
"This unit has +3 {GLOBAL.DefenseConcept.Hyperlink} against non-{GLOBAL."
"FlankingConcept.Hyperlink} {GLOBAL.MeleeConcept.Hyperlink} attacks."

msgid "TOME_LEGIONS@SKILL_01@SPELL@NAME"
msgstr "Form Cohort"

msgid "TOME_LEGIONS@SKILL_01@SPELL@DESCRIPTION"
msgstr ""
"Combine two non-Scout Tier I or II units into a {GLOBAL.UNITS.COHORT_UNIT."
"Hyperlink}.\n"
"Cannot target {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}, {GLOBAL.PROPERTIES."
"CONSTRUCT.Hyperlink} or {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} units."

msgid "TOME_LEGIONS@SKILL_01@ABILITY_01@NAME"
msgstr "Vanguard Strike"

msgid "TOME_LEGIONS@SKILL_01@ABILITY_01@DESCRIPTION"
msgstr ""
"Target enemy unit takes damage and has base "
"{VANGAURD_STRIKE_TAUNTED_RESISTANCE>ResolvedStrength}% chance to become "
"{GLOBAL.PROPERTIES.TAUNTED.Hyperlink} for "
"{VANGUARD_STRIKE_TAUNTED_LINK_EFFECT>Duration} [turn/] [hyperlink,GLOBAL."
"TurnConcept]Turns[/hyperlink]. Enter {GLOBAL.DefenseModeConcept.Hyperlink} "
"after use."

msgid "TOME_LEGIONS@SKILL_02@NAME"
msgstr "Standard Bearers"

msgid "TOME_LEGIONS@SKILL_02@DESCRIPTION"
msgstr ""
"Makes {GLOBAL.SupportConcept.Hyperlink} abilities of enchanted units:"
"[bulletlist][bullet/]Grant 2 {GLOBAL.PROPERTIES.RALLYING.Hyperlink} to "
"affected units without {GLOBAL.HighMoraleConcept.Hyperlink}.[bullet/]Grant 1 "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and 1 {GLOBAL.PROPERTIES.FORTUNE."
"Hyperlink} to affected units with High Morale."

#, fuzzy
msgid "TOME_LEGIONS@SKILL_02@MODIFIER@NAME"
msgstr "Demoralizing Death"

msgid "TOME_LEGIONS@SKILL_02@MODIFIER@DESCRIPTION"
msgstr ""
"{GLOBAL.SupportConcept.Hyperlink} abilities grant:[bulletlist][bullet/]2 "
"{GLOBAL.PROPERTIES.RALLYING.Hyperlink} to affected units without {GLOBAL."
"HighMoraleConcept.Hyperlink}.[bullet/]1 {GLOBAL.PROPERTIES.STRENGTHENED."
"Hyperlink} and 1 {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} to affected units with "
"High Morale."

msgid "TOME_LEGIONS@SKILL_02@MODIFIER_02@DESCRIPTION"
msgstr ""
"Target gains 2 {GLOBAL.PROPERTIES.RALLYING.Hyperlink}, or 1 {GLOBAL."
"PROPERTIES.STRENGTHENED.Hyperlink} and 1 {GLOBAL.PROPERTIES.FORTUNE."
"Hyperlink} if it has {GLOBAL.HighMoraleConcept.Hyperlink}."

msgid "TOME_LEGIONS@SKILL_03@NAME"
msgstr "Veteran Instructors"

msgid "TOME_LEGIONS@SKILL_03@DESCRIPTION"
msgstr ""
"Your units with Legendary Rank gain {GLOBAL.PROPERTIES."
"LEGION_INSTRUCTORS_STACK_PROPERTY.Hyperlink}."

#, fuzzy
msgid "TOME_LEGIONS@SKILL_03@PROPERTY@NAME"
msgstr "Raze Fortification"

msgid "TOME_LEGIONS@SKILL_03@PROPERTY@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]{GLOBAL.PROPERTIES.INSPIRING_KILLER.Hyperlink}."
"[bullet/]Non-{GLOBAL.HeroConcept.Hyperlink} units in this army gain "
"+{LEGION_INSTRUCTORS_XP_BONUS>ResolvedProportion}% {GLOBAL.ExperienceConcept."
"Hyperlink} from combat. (Does not stack)[/bulletlist]"

msgid "TOME_LEGIONS@SKILL_03@PROPERTY_02@DESCRIPTION"
msgstr ""
"+{LEGION_INSTRUCTORS_XP_BONUS>ResolvedProportion}% {GLOBAL.ExperienceConcept."
"Hyperlink} from combat."

msgid "TOME_LEGIONS@SKILL_04@NAME"
msgstr "Dread March"

msgid "TOME_LEGIONS@SKILL_04@DESCRIPTION"
msgstr ""
"Target friendly army suffers 20 {GLOBAL.FireDamageConcept.Hyperlink} and "
"regains all of their Movement points if they are on land, or half if they are "
"on water.\n"
"A unit cannot benefit from this spell more than once per turn."

msgid "TOME_LEGIONS@SKILL_05@NAME"
msgstr "Castigate"

#, fuzzy
msgid "TOME_LEGIONS@SKILL_05@DESCRIPTION"
msgstr "Placeholder description"

msgid "TOME_LEGIONS@SKILL_06@NAME"
msgstr "Deploy Reserves"

msgid "TOME_LEGIONS@SKILL_06@DESCRIPTION"
msgstr ""
"Summon {GLOBAL.PROPERTIES.REINFORCEMENTS_PROPERTY.Hyperlink} adjacent to "
"target friendly unit. One of four different units can be summoned depending "
"on the unit type of the target.\n"
"Cannot target [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink], [hyperlink,"
"GLOBAL.PROPERTIES.MYTHIC_UNIT]Mythic Units[/hyperlink] or [hyperlink,GLOBAL."
"PROPERTIES.COMBAT_SUMMON]Combat Summons[/hyperlink]."

msgid "TOME_LEGIONS@SKILL_06@UNIT_01@NAME"
msgstr "Shield Cohort"

msgid "TOME_LEGIONS@SKILL_06@UNIT_01@DESCRIPTION"
msgstr "Summon Shield Cohort"

msgid "TOME_LEGIONS@SKILL_06@UNIT_02@NAME"
msgstr "Crossbow Cohort"

msgid "TOME_LEGIONS@SKILL_06@UNIT_02@DESCRIPTION"
msgstr "Summon Crossbow Cohort"

msgid "TOME_LEGIONS@SKILL_06@UNIT_03@NAME"
msgstr "Legion Bannerman"

msgid "TOME_LEGIONS@SKILL_06@UNIT_03@DESCRIPTION"
msgstr "Summon Legion Bannerman"

msgid "TOME_LEGIONS@SKILL_06@UNIT_04@NAME"
msgstr "Shock Cohort"

msgid "TOME_LEGIONS@SKILL_06@UNIT_04@DESCRIPTION"
msgstr "Summon Shock Cohort"

msgid "TOME_LEGIONS@SKILL_06@ABILITY_01@NAME"
msgstr "Rousing Call"

msgid "TOME_LEGIONS@SKILL_06@ABILITY_01@DESCRIPTION"
msgstr ""
"Target friendly unit:[bulletlist][bullet/]Gains {GLOBAL.PROPERTIES.RALLYING."
"Hyperlink}."

msgid "TOME_LEGIONS@SKILL_06@MODIFIER@NAME"
msgstr "Reinforcements"

msgid "TOME_LEGIONS@SKILL_06@MODIFIER@DESCRIPTION"
msgstr ""
"This unit:[bulletlist][bullet/]Cannot regain [hyperlink,GLOBAL."
"HitPointConcept][hp/] Hit Points[/hyperlink].[bullet/]Sustains "
"{REINFORCEMENTS_PROPERTY_DAMAGE>DAMAGE>Physical} {GLOBAL."
"PhysicalDamageConcept.Hyperlink} at the end of each turn."

msgid "TOME_LEGIONS@SPECIAL_PROVINCE_IMPROVEMENT@NAME"
msgstr "[researchpost/] Gladiator Pit"

msgid "TOME_LEGIONS@SPECIAL_PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+3 {GLOBAL.CityStabilityConcept.Hyperlink} per adjacent "
"{GLOBAL.ProvinceImprovementConcept.Hyperlink}.[bullet/]Gain 15% of {GLOBAL."
"UnitProductionConcept.Hyperlink} income as {GLOBAL.KnowledgeConcept."
"Hyperlink}.[bullet/]Counts as a {GLOBAL.ResearchPostConcept.Hyperlink}.[/"
"bulletlist]"

msgid "TOME_LEGIONS@HERO_SKILL@NAME"
msgstr "Rousing Support"

msgid "TOME_LEGIONS@HERO_SKILL@DESCRIPTION"
msgstr ""
"{GLOBAL.SupportConcept.Hyperlink} abilities grant +1 {GLOBAL.PROPERTIES."
"STRENGTHENED.Hyperlink} to affected units."

msgid "TOME_LEGIONS@HERO_SKILL@MODIFIER@DESCRIPTION"
msgstr "Target gains +1 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

#, fuzzy
msgid "TOME_LEGIONS@PASSIVE@NAME"
msgstr "Reinforcement Killed"

#, fuzzy
msgid "TOME_LEGIONS@PASSIVE@DESCRIPTION"
msgstr ""
"Either a {GLOBAL.UNITS.SHIELD_COHORT_UNIT.Hyperlink}, {GLOBAL.UNITS."
"RANGED_COHORT_UNIT.Hyperlink}, {GLOBAL.UNITS.SHOCK_COHORT_UNIT.Hyperlink} or "
"{GLOBAL.UNITS.BANNER_COHORT_UNIT.Hyperlink} can be summoned, depending on the "
"unit type of the target."

msgid "TOME_WARLORD@TOME@NAME"
msgstr "Tome of the Warlord"

msgid "TOME_WARLORD@TOME@DESCRIPTION"
msgstr ""
"Master the art of war. Employ cunning tactics that harness the superior "
"{GLOBAL.UnitMoraleConcept.Hyperlink} of your armies and specialize in "
"coordinating a variety of Unit Types."

msgid "TOME_WARLORD@TOME@LORE_DESCRIPTION"
msgstr ""
"\"Leadership, above all else, is paramount in war.  Even the most disciplined "
"soldiers, most ferocious war beasts and most destructive spells are "
"squandered in the hands of a weak-willed leader or feeble-minded tactician.  "
"I am more afraid of an army of sheep led by a lion, than an army of lions led "
"by a sheep!\""

msgid "TOME_WARLORD@TOME@LORE_AUTHOR"
msgstr "Khatun Shura, Shad'rai Warlord"

msgid "TOME_WARLORD@SKILL_01@NAME"
msgstr "Warlord"

msgid "TOME_WARLORD@SKILL_01@DESCRIPTION"
msgstr ""
"A supporting [hyperlink,GLOBAL.PROPERTIES.MYTHIC_UNIT]Mythic Unit[/hyperlink] "
"that can summon Reinforcements and direct your units with tactical commands."

msgid "TOME_WARLORD@SKILL_01@UNIT@NAME"
msgstr ""

msgid "TOME_WARLORD@SKILL_01@MODIFIER@NAME"
msgstr "Coordinated Strike"

msgid "TOME_WARLORD@SKILL_01@MODIFIER@DESCRIPTION"
msgstr ""
"For each friendly unit adjacent to the target, this attack gains "
"+{TACTICIAN_STRIKE_ADJACENT_COUNT>DAMAGE>Physical} {GLOBAL."
"PhysicalDamageConcept.Hyperlink}."

msgid "TOME_WARLORD@SKILL_01@ABILITY_01@NAME"
msgstr "Rousing Command"

msgid "TOME_WARLORD@SKILL_01@ABILITY_01@DESCRIPTION"
msgstr ""
"Target friendly unit with {GLOBAL.HighMoraleConcept.Hyperlink} regains its "
"[hyperlink,GLOBAL.ActionPointConcept]Action Points[/hyperlink].\n"
"Cannot target {GLOBAL.HeroConcept.Hyperlink} or [hyperlink,GLOBAL.PROPERTIES."
"MYTHIC_UNIT]Mythic[/hyperlink] units.\n"
"A unit cannot benefit from this ability more than once per turn."

msgid "TOME_WARLORD@SKILL_01@ABILITY_02@NAME"
msgstr "Deploy Reserves"

msgid "TOME_WARLORD@SKILL_01@ABILITY_02@DESCRIPTION"
msgstr ""
"Summon {GLOBAL.PROPERTIES.REINFORCEMENTS_WEAKENED.Hyperlink} of target "
"friendly unit that is Tier 2 or lower. This summon lasts for 3 turns.  Target "
"also heals {REINFORCEMENTS_HEAL>NumHitpointsToRestore} [hyperlink,GLOBAL."
"TemporaryHitPointConcept][temphp/] Temporary Hit Points[/hyperlink]. \n"
"Cannot target [hyperlink,GLOBAL.PROPERTIES.COMBAT_SUMMON]Combat Summons[/"
"hyperlink] or {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} units."

msgid "TOME_WARLORD@SKILL_01@ABILITY_03@NAME"
msgstr "Coordinated Strike"

msgid "TOME_WARLORD@SKILL_01@ABILITY_03@DESCRIPTION"
msgstr "A single magical attack at target unit."

msgid "TOME_WARLORD@SKILL_02@NAME"
msgstr "Martial Culture"

msgid "TOME_WARLORD@SKILL_02@DESCRIPTION"
msgstr ""
"Imbues target race with a warlike ethos, granting them:[bulletlist]"
"[bullet/]+2 {GLOBAL.UnitMoraleConcept.Hyperlink} at the end of each turn for "
"each stack of {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} they have."
"[bullet/]+1 {GLOBAL.RetaliationConcept.Hyperlink}.[bullet/]Damage penalties "
"from [hyperlink,GLOBAL.CasualtyConcept]Casualties[/hyperlink] are reduced by "
"{WARLORD_TRANSFORMATION_PENALTYREDUCTION>ResolvedPenaltyMultiplie}%."

msgid "TOME_WARLORD@SKILL_03@NAME"
msgstr "Fist of War"

msgid "TOME_WARLORD@SKILL_03@DESCRIPTION"
msgstr ""
"All units in a 2-hex radius:[bulletlist][bullet/]Sustain 20 {GLOBAL."
"PhysicalDamageConcept.Hyperlink} if they are adjacent to an opposing unit, "
"plus {FIST_OF_WAR_COUNT_ADJACENT_ENEMY>DAMAGE>Physical} {GLOBAL."
"PhysicalDamageConcept.Hyperlink} for each additional adjacent opposing unit."
"[bullet/]Friendly units are dealt 50% of the damage.[bullet/]Friendly units "
"with {GLOBAL.HighMoraleConcept.Hyperlink} are dealt no damage."

msgid "TOME_WARLORD@SKILL_04@NAME"
msgstr "Mass Levy"

msgid "TOME_WARLORD@SKILL_04@DESCRIPTION"
msgstr ""
"Target friendly city converts 50% of their {GLOBAL.StructureProductionConcept."
"Hyperlink} income, gaining {GLOBAL.UnitProductionConcept.Hyperlink} income "
"equal to the converted    {GLOBAL.StructureProductionConcept.Hyperlink} "
"income."

msgid "TOME_WARLORD@SKILL_05@NAME"
msgstr "Combined Arms"

msgid "TOME_WARLORD@SKILL_05@DESCRIPTION"
msgstr ""
"When enchanted units attack, they gain:[bulletlist][bullet/]A stack of "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} if they are adjacent to a friendly "
"[hyperlink,GLOBAL.PROPERTIES.SHOCK_UNIT]Shock[/hyperlink] or [hyperlink,"
"GLOBAL.PROPERTIES.FIGHTER]Fighter[/hyperlink] unit.[bullet/]A stack of "
"{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} if they are adjacent to a "
"friendly [hyperlink,GLOBAL.PROPERTIES.SHIELD_UNIT]Shield[/hyperlink] or "
"[hyperlink,GLOBAL.PROPERTIES.POLEARM_UNIT]Polearm[/hyperlink] unit.[bullet/]A "
"base 60% chance of inflicting {GLOBAL.PROPERTIES.MARKED.Hyperlink} if they "
"are adjacent to a friendly [hyperlink,GLOBAL.PROPERTIES.RANGED_UNIT]Ranged[/"
"hyperlink] or [hyperlink,GLOBAL.PROPERTIES.SKIRMISHER]Skirmisher[/hyperlink] "
"unit.\n"
"Effects [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]are increased[/"
"hyperlink] for Single Shot attacks."

msgid "TOME_WARLORD@SKILL_05@MODIFIER_01@DESCRIPTION"
msgstr ""
"When this unit attacks it gains additional effects if it is adjacent to "
"friendly units with {GLOBAL.PROPERTIES.COMBINED_ARMS_PROPERTY_GROUP_STRENGTH."
"Hyperlink}."

msgid "TOME_WARLORD@SKILL_05@PROPERTY_01@NAME"
msgstr "Combined Arms: Strength"

msgid "TOME_WARLORD@SKILL_05@PROPERTY_01@DESCRIPTION"
msgstr "placeholder description"

msgid "TOME_WARLORD@SKILL_05@PROPERTY_02@NAME"
msgstr "Combined Arms: Defense"

msgid "TOME_WARLORD@SKILL_05@PROPERTY_02@DESCRIPTION"
msgstr "placeholder description"

msgid "TOME_WARLORD@SKILL_05@PROPERTY_03@NAME"
msgstr "Combined Arms: Marked"

msgid "TOME_WARLORD@SKILL_05@PROPERTY_03@DESCRIPTION"
msgstr "placeholder description"

msgid "TOME_WARLORD@SKILL_06@NAME"
msgstr "placeholder name 6"

msgid "TOME_WARLORD@SKILL_06@DESCRIPTION"
msgstr "placeholder description 6"

msgid "TOME_WARLORD@SPECIAL_PROVINCE_IMPROVEMENT@NAME"
msgstr "placeholder name"

msgid "TOME_WARLORD@SPECIAL_PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "placeholder description"

msgid "TOME_WARLORD@HERO_SKILL@NAME"
msgstr "Battle Plan"

msgid "TOME_WARLORD@HERO_SKILL@DESCRIPTION"
msgstr ""
"Target a friendly unit. Depending on the unit type of the target, all "
"friendly units gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES."
"BATTLE_PLAN_EFFECT_PROP_GROUP_1.Hyperlink} from a {GLOBAL.PROPERTIES."
"SHIELD_UNIT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"BATTLE_PLAN_EFFECT_PROP_GROUP_3.Hyperlink} from a {GLOBAL.PROPERTIES."
"POLEARM_UNIT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"BATTLE_PLAN_EFFECT_PROP_GROUP_6.Hyperlink} from a {GLOBAL.PROPERTIES.FIGHTER."
"Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.BATTLE_PLAN_EFFECT_PROP_GROUP_8."
"Hyperlink} from a {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}.[bullet/]{GLOBAL."
"PROPERTIES.BATTLE_PLAN_EFFECT_PROP_GROUP_5.Hyperlink} from a {GLOBAL."
"PROPERTIES.RANGED_UNIT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"BATTLE_PLAN_EFFECT_PROP_GROUP_7.Hyperlink} from a {GLOBAL.PROPERTIES."
"SKIRMISHER.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"BATTLE_PLAN_EFFECT_PROP_GROUP_2.Hyperlink} from a {GLOBAL.PROPERTIES."
"SUPPORT_UNIT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"BATTLE_PLAN_EFFECT_PROP_GROUP_4.Hyperlink} from a {GLOBAL.PROPERTIES."
"BATTLE_MAGE.Hyperlink}.[/bulletlist]\n"
"Effect lasts for 2 [turn/] [hyperlink,GLOBAL.TurnConcept]Turns[/hyperlink].\n"
"Only one Battle Plan can be active at a time.\n"
"Does not affect [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] and "
"[hyperlink,GLOBAL.PROPERTIES.MYTHIC_UNIT]Mythic Units[/hyperlink]."

