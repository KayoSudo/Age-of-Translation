msgid "TOME_WARLORD@HERO_SKILL@COMBAT_PROPERTY@NAME"
msgstr "Shield Wall"

msgid "TOME_WARLORD@HERO_SKILL@COMBAT_PROPERTY@DESCRIPTION"
msgstr ""
"A {GLOBAL.UNITS.TACTICIAN_UNIT.Hyperlink} Battle Plan is currently in effect "
"for this army."

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_01@NAME"
msgstr "Shield Wall"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_01@DESCRIPTION"
msgstr ""
"+{BATTLE_PLAN_EFFECT_PROP_DEFENSE_1>BONUS>DEFENSE>Armor} {GLOBAL."
"DefenseConcept.Hyperlink}"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_02@NAME"
msgstr "Warding Chant"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_02@DESCRIPTION"
msgstr ""
"+{BATTLE_PLAN_EFFECT_PROP_DEFENSE_2>BONUS>DEFENSE>Resistance} {GLOBAL."
"ResistanceConcept.Hyperlink}"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_03@NAME"
msgstr "Tyrantslayer"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_03@DESCRIPTION"
msgstr ""
"+{BATTLE_PLAN_EFFECT_PROP_3_DAMAGE>ResolvedMultiplier}% damage against "
"[hyperlink,GLOBAL.HeroConcept]Hero[/hyperlink] units."

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_04@NAME"
msgstr "Suppressive Fire"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_04@DESCRIPTION"
msgstr ""
"Attacks ignore up to "
"{BATTLE_PLAN_EFFECT_PROP_GROUP_4_RESISTANCE_BOOST>ResistanceBypas} {GLOBAL."
"StatusResistanceConcept.Hyperlink}."

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_05@NAME"
msgstr "Focused Fire"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_05@DESCRIPTION"
msgstr ""
"Grants {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} "
"attacks +{BATTLE_PLAN_EFFECT_PROP_GROUP_5_RANGE>ADD>OptimalRange}[range/] "
"range."

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_06@NAME"
msgstr "Death or Glory"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_06@DESCRIPTION"
msgstr ""
"[bullet/]+{BATTLE_PLAN_EFFECT_PROP_GROUP_6_DAMAGE_MULTIPLIER>ResolvedMultip}% "
"{GLOBAL.CriticalHitConcept.Hyperlink} damage."

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_07@NAME"
msgstr "Skirmish Screen"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_07@DESCRIPTION"
msgstr ""
"[bulletlist]"
"[bullet/]+{BATTLE_PLAN_EFFECT_PROP_GROUP_7_STATUS_RESISTANCE>Resistance} "
"{GLOBAL.StatusResistanceConcept.Hyperlink}."
"[bullet/]+{BATTLE_PLAN_EFFECT_PROP_GROUP_7_EVASION_ACCURACY>ResolvedAccurac}% "
"{GLOBAL.EvasionConcept.Hyperlink}."

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_08@NAME"
msgstr "Encirclement"

msgid "TOME_WARLORD@HERO_SKILL@PROPERTY_08@DESCRIPTION"
msgstr ""
"+{BATTLE_PLAN_EFFECT_PROP_GROUP_8_FLANKER_DAMAGE>ResolvedMultiplie}% damage "
"when {GLOBAL.FlankingConcept.Hyperlink}."

