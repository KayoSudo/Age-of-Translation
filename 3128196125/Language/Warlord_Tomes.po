msgid "MOD@WARLORD@TOME_LEGIONS@TOME@NAME"
msgstr "Tome of Legions"

msgid "MOD@WARLORD@TOME_LEGIONS@TOME@DESCRIPTION"
msgstr ""
"Master the art of war. Muster relentless armies and specialize in "
"coordinating a variety of Units."

msgid "MOD@WARLORD@TOME_LEGIONS@TOME@LORE_DESCRIPTION"
msgstr ""
"\"Leadership, above all else, is paramount in war.  Even the most "
"disciplined soldiers, most ferocious war beasts and most destructive spells "
"are squandered in the hands of a weak-willed leader or feeble-minded "
"tactician.  I am more afraid of an army of sheep led by a lion, than an army "
"of lions led by a sheep!\""

msgid "MOD@WARLORD@TOME_LEGIONS@TOME@LORE_AUTHOR"
msgstr "Khatun Shura, Shad'rai Warlord"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_01@NAME"
msgstr "Legion Standard"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_01@DESCRIPTION"
msgstr ""
"A {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} that summons a legion of {GLOBAL."
"UNITS.LEGIONS_COHORT_UNIT.Hyperlink} units to overwhelm the enemy."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_02@NAME"
msgstr "Deploy Reserves"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_02@DESCRIPTION"
msgstr ""
"Summon 2 {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} and 2 {GLOBAL.UNITS."
"LEGIONS_COHORT_UNIT.Hyperlink} units.\n"
"Must target a position within 2 hexes of a friendly unit."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_03@NAME"
msgstr "Combined Arms"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_03@DESCRIPTION"
msgstr ""
"For each other friendly Unit Class with {GLOBAL.PROPERTIES.LEGION_PROPERTY."
"Hyperlink} in combat, enchanted units gain:[bulletlist]"
"[bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% "
"{GLOBAL.CriticalHitChanceConcept.Hyperlink}."
"[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage "
"with [hyperlink,GLOBAL.CriticalHitConcept]Critical Hits[/hyperlink].[/"
"bulletlist]"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_03@PROPERTY@DESCRIPTION"
msgstr ""
"For each other friendly Unit Class with Combined Arms in combat, this unit "
"gains:[bulletlist]"
"[bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% "
"{GLOBAL.CriticalHitChanceConcept.Hyperlink}."
"[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage "
"with [hyperlink,GLOBAL.CriticalHitConcept]Critical Hits[/hyperlink].[/"
"bulletlist]"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_04@NAME"
msgstr "Legion Retinue"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_04@DESCRIPTION"
msgstr ""
"Grants enchanted units:[bulletlist][bullet/]At the start of battle, summon a "
"{GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink} unit."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_04@PROPERTY@DESCRIPTION"
msgstr ""
"At the start of battle, summon a {GLOBAL.UNITS.LEGIONS_COHORT_UNIT."
"Hyperlink} unit."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_05@NAME"
msgstr "Dread March"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_05@DESCRIPTION"
msgstr ""
"All friendly units in the target Province regain half their Movement "
"points.\n"
"A unit cannot benefit from this spell more than once per turn."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_06@NAME"
msgstr "College of War"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_06@DESCRIPTION"
msgstr ""
"All Heroes under your control gain:[bulletlist][bullet/]20 {GLOBAL."
"ExperienceConcept.Hyperlink} per {GLOBAL.TurnConcept.Hyperlink} on the world "
"map.[bullet/]The {GLOBAL.PROPERTIES.LEGIONS_BATTLE_PLAN.Hyperlink} ability, "
"which can grant all units in battle a choice of different Positive Status "
"Effects."

msgid "MOD@WARLORD@TOME_LEGIONS@SPECIAL_PROVINCE_IMPROVEMENT@NAME"
msgstr "[quarry/] Colosseum"

msgid "MOD@WARLORD@TOME_LEGIONS@SPECIAL_PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+1 {GLOBAL.ImperiumConcept.Hyperlink} for each {GLOBAL."
"CityStabilityConcept.Hyperlink} level above Neutral.[bullet/]+5 {GLOBAL."
"CityStabilityConcept.Hyperlink} per adjacent {GLOBAL."
"ProvinceImprovementConcept.Hyperlink}.[bullet/]20% of {GLOBAL."
"UnitProductionConcept.Hyperlink} income in the city is converted to {GLOBAL."
"CityStabilityConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.QuarryConcept."
"Hyperlink}.[/bulletlist]"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_01@NAME"
msgstr "Legion Standard"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_01@DESCRIPTION"
msgstr "placeholder"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_02@NAME"
msgstr "Cohort"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_02@DESCRIPTION"
msgstr "placeholder"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_01@NAME"
msgstr "Call of the Legion"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_01@DESCRIPTION"
msgstr ""
"At the start of battle, summon 2 {GLOBAL.UNITS.LEGIONS_COHORT_UNIT."
"Hyperlink} units."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@NAME"
msgstr "Legion Banner"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@DESCRIPTION"
msgstr ""
"Adjacent friendly units gain:[bulletlist]"
"[bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL."
"DefenseConcept.Hyperlink}."
"[bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL."
"ResistanceConcept.Hyperlink}."
"[bullet/]+{UNDER_LEGION_BANNER_STATUS_RESISTANCE>Resistance} {GLOBAL."
"StatusResistanceConcept.Hyperlink}.[/bulletlist]\n"
"Does not stack."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@PROPERTY@NAME"
msgstr "Under Legion Banner"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@PROPERTY@DESCRIPTION"
msgstr ""
"This unit has:[bulletlist]"
"[bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL."
"DefenseConcept.Hyperlink}."
"[bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL."
"ResistanceConcept.Hyperlink}."
"[bullet/]+{UNDER_LEGION_BANNER_STATUS_RESISTANCE>Resistance} {GLOBAL."
"StatusResistanceConcept.Hyperlink}.[/bulletlist]\n"
"Does not stack."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_03@NAME"
msgstr "Sundering Shields"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_03@DESCRIPTION"
msgstr ""
"Melee range attackers have base "
"{SUNDERED_DEFENSE_RESISTANCE>ResolvedStrength}% chance to suffer {GLOBAL."
"PROPERTIES.SUNDERED_DEFENSE.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_04@NAME"
msgstr "Defense Mode: Plant Banner"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_04@DESCRIPTION"
msgstr ""
"This unit ends its turn and goes into a defensive mode. The unit:[bulletlist]"
"[bullet/]Extends its {GLOBAL.ZoneOfControlConcept.Hyperlink} to all adjacent "
"hexes.[bullet/]Gains +{DEFENSE_MODE_DEFENSE>DEF_MOD>Armor} {GLOBAL."
"DefenseConcept.Hyperlink}.[bullet/]Gains "
"+{DEFENSE_MODE_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept."
"Hyperlink}.[bullet/]Becomes immune to {GLOBAL.FlankingConcept.Hyperlink}."
"[bullet/]Friendly units in a {RAISE_BANNER_AUTO_SPELL_TARGETER>AREA>Radius}-"
"hex radius gain +{RAISE_BANNER_MORALE>Morale Change} {GLOBAL."
"UnitMoraleConcept.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_01@NAME"
msgstr "Sundering Combo"

msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_01@MODIFIER"
msgstr ""
"Third attack in a turn inflicts 2 {GLOBAL.PROPERTIES.SUNDERED_DEFENSE."
"Hyperlink}."

#, fuzzy
msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_02@NAME"
msgstr ""
"For each other friendly Unit Class with this enchantment in combat, "
"enchanted units gain:[bulletlist]"
"[bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% "
"{GLOBAL.CriticalHitChanceConcept.Hyperlink}."
"[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage "
"with [hyperlink,GLOBAL.CriticalHitConcept]Critical Hits[/hyperlink]."

#, fuzzy
msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_02@MODIFIER"
msgstr ""
"For each other friendly Unit Class with this enchantment in combat, this "
"unit gains:[bulletlist]"
"[bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% "
"{GLOBAL.CriticalHitChanceConcept.Hyperlink}."
"[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage "
"with [hyperlink,GLOBAL.CriticalHitConcept]Critical Hits[/hyperlink]."

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_01@NAME"
msgstr "Fist of War"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_01@DESCRIPTION"
msgstr "placeholder desc"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_01@MODIFIER@DESCRIPTION"
msgstr ""
"For each friendly unit adjacent to the target, this attack gains "
"+{TACTICIAN_STRIKE_ADJACENT_COUNT>DAMAGE>Physical} {GLOBAL."
"PhysicalDamageConcept.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_02@NAME"
msgstr "Call Reinforcements"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_02@DESCRIPTION"
msgstr ""
"Summon a {GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink} unit.\n"
"This summon lasts for {LEGION_REINFORCEMENTS_SUMMON_EFFECT>TurnsToLive} "
"[turn/] [hyperlink,GLOBAL.TurnConcept]Turns[/hyperlink]"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@NAME"
msgstr "Stratagem"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@DESCRIPTION"
msgstr ""
"Target a friendly unit. Depending on the target's Unit Class, all friendly "
"units gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}: 3 "
"{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"POLEARM_UNIT.Hyperlink}: 3 {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}."
"[bullet/]{GLOBAL.PROPERTIES.FIGHTER.Hyperlink}: 3 {GLOBAL.PROPERTIES."
"STRENGTHENED.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}: "
"{GLOBAL.PROPERTIES.HASTENED.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"RANGED_UNIT.Hyperlink}: 3 {GLOBAL.PROPERTIES.FORTUNE.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink}: 3 {GLOBAL.PROPERTIES.EVASION."
"Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}: 3 {GLOBAL."
"PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"BATTLE_MAGE.Hyperlink}: 3 {GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink}."
"[bullet/]{GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}: {GLOBAL.PROPERTIES."
"PRECOGNITION.Hyperlink}.[/bulletlist]\n"
"Does not affect [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] and "
"[hyperlink,GLOBAL.PROPERTIES.MYTHIC_UNIT]Mythic Units[/hyperlink].\n"
"All friendly units with this ability share a 2 {GLOBAL.TurnConcept."
"Hyperlink} cooldown."

#, fuzzy
msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@PROPERTY@NAME"
msgstr "Battle Plan"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@PROPERTY@DESCRIPTION"
msgstr ""
"This Hero gains 20 {GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL."
"TurnConcept.Hyperlink} on the world map."

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_04@NAME"
msgstr "Vanguard Strike"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_04@DESCRIPTION"
msgstr "Strike at target unit and enter {GLOBAL.DefenseModeConcept.Hyperlink}."
