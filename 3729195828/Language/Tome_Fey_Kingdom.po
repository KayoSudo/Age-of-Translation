msgid "THYRON_TOME_FEY_KINGDOM@TOME@NAME"
msgstr "Tome of the Fey Kingdom"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@DESCRIPTION"
msgstr ""
"Unite the mysterious {GLOBAL.PROPERTIES.FEY.Hyperlink} under your rule, and "
"use their uncanny powers to outshine your foes."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@LORE_DESCRIPTION"
msgstr ""
"\"The jungle and glade, the spirit and shade, all will surrender. For we know "
"the gaze of light and of flames, who call from the embers. Now time will "
"attest, no joke and no jest, we rise and we won't rest!\""

msgid "THYRON_TOME_FEY_KINGDOM@TOME@AUTHOR_NAME"
msgstr "Ho'ran Sil'an, Emissary Anointed"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@NAME"
msgstr "Summon Fairy"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]Choose a Tier III Fairy {GLOBAL.PROPERTIES.FEY.Hyperlink} "
"unit to add to your army.[bullet/]The available "
"{GLOBAL.PROPERTIES.FEY.Hyperlink} units depend on the type of terrain the "
"spell is cast on.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_02@NAME"
msgstr "Children of the Seelie"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_02@DESCRIPTION"
msgstr ""
"Connects the target race with ascended fey powers, granting them:[bulletlist]"
"[bullet/]The {GLOBAL.PROPERTIES.FEY.Hyperlink} unit type.[bullet/]"
"{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} Movement, which increases "
"mobility.[bullet/]{GLOBAL.PROPERTIES.THYRON_FEY_RHYTHM_SEASONS.Hyperlink}.[/"
"bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_02@MODIFIER_DESCRIPTION"
msgstr ""
"Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.FEY.Hyperlink} unit type."
"[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} Movement.[bullet/]"
"{GLOBAL.PROPERTIES.THYRON_FEY_RHYTHM_SEASONS.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_03@NAME"
msgstr "Reign of Seasons"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_03@DESCRIPTION"
msgstr ""
"When cast and for the next 2 <<m:{GLOBAL.TurnConcept}>>, apply effect to the "
"battle in the following order:[bulletlist][bullet/]All non-"
"{GLOBAL.PROPERTIES.FEY.Hyperlink} enemy units sustain "
"{THYRON_SPELL_REIGN_OF_SEASONS_DAMAGE_EFFECT_FIRE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink}, summon a "
"{GLOBAL.UNITS.SUMMER_FAIRY.Hyperlink} for "
"{THYRON_SPELL_REIGN_OF_SEASONS_SUMMON_EFFECT_FIRE>TurnsToLive} <<m:"
"{GLOBAL.TurnConcept}>>.[bullet/]All non-{GLOBAL.PROPERTIES.FEY.Hyperlink} "
"enemy units sustain "
"{THYRON_SPELL_REIGN_OF_SEASONS_DAMAGE_EFFECT_COLD>DAMAGE>Frost} "
"{GLOBAL.FrostDamageConcept.Hyperlink}, summon a "
"{GLOBAL.UNITS.WINTER_FAIRY.Hyperlink} for "
"{THYRON_SPELL_REIGN_OF_SEASONS_SUMMON_EFFECT_COLD>TurnsToLive} <<m:"
"{GLOBAL.TurnConcept}>>.[bullet/]All non-{GLOBAL.PROPERTIES.FEY.Hyperlink} "
"enemy units sustain "
"{THYRON_SPELL_REIGN_OF_SEASONS_DAMAGE_EFFECT_BLIGHT>DAMAGE>Blight} "
"{GLOBAL.BlightDamageConcept.Hyperlink}, summon a "
"{GLOBAL.UNITS.SPRING_FAIRY.Hyperlink} for "
"{THYRON_SPELL_REIGN_OF_SEASONS_SUMMON_EFFECT_BLIGHT>TurnsToLive} <<m:"
"{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_03@EFFECT1@DESCRIPTION"
msgstr ""
"All non-{GLOBAL.PROPERTIES.FEY.Hyperlink} enemy units sustain "
"{THYRON_SPELL_REIGN_OF_SEASONS_DAMAGE_EFFECT_FIRE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink}, summon a "
"{GLOBAL.UNITS.SUMMER_FAIRY.Hyperlink} for 2 <<m:{GLOBAL.TurnConcept}>>."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_03@EFFECT2@DESCRIPTION"
msgstr ""
"All non-{GLOBAL.PROPERTIES.FEY.Hyperlink} enemy units sustain "
"{THYRON_SPELL_REIGN_OF_SEASONS_DAMAGE_EFFECT_COLD>DAMAGE>Frost} "
"{GLOBAL.FrostDamageConcept.Hyperlink}, summon a "
"{GLOBAL.UNITS.WINTER_FAIRY.Hyperlink} for 2 <<m:{GLOBAL.TurnConcept}>>."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_03@EFFECT3@DESCRIPTION"
msgstr ""
"All non-{GLOBAL.PROPERTIES.FEY.Hyperlink} enemy units sustain "
"{THYRON_SPELL_REIGN_OF_SEASONS_DAMAGE_EFFECT_BLIGHT>DAMAGE>Blight} "
"{GLOBAL.BlightDamageConcept.Hyperlink}, summon a "
"{GLOBAL.UNITS.SPRING_FAIRY.Hyperlink} for 2 <<m:{GLOBAL.TurnConcept}>>."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_04@NAME"
msgstr "Emissary"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_04@DESCRIPTION"
msgstr ""
"Royal {GLOBAL.PROPERTIES.FEY.Hyperlink} "
"{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} that powers up other Fey and wields "
"a variety of impressive {GLOBAL.MagicConcept.Hyperlink} abilities."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_05@NAME"
msgstr "Eternal Weapons"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_05@DESCRIPTION"
msgstr ""
"Grants enchanted units:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.UNDEAD_SLAYER.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.CONSTRUCT_SLAYER.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_05@MODIFIER_DESCRIPTION"
msgstr ""
"Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.UNDEAD_SLAYER.Hyperlink}."
"[bullet/]{GLOBAL.PROPERTIES.CONSTRUCT_SLAYER.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_06@NAME"
msgstr "Enchanting Decree"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_06@DESCRIPTION"
msgstr ""
"At the start of combat:[bulletlist][bullet/]Friendly units gain:[bulletlist]"
"[bullet/]{GLOBAL.PROPERTIES.HASTENED.Hyperlink} for "
"{HASTENED_EFFECT_DESCRIPTION_3>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/"
"bulletlist][bullet/]Enemy units gain:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.PACIFIED.Hyperlink} for "
"{PACIFICED_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/"
"bulletlist][/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY0@NAME"
msgstr "Blast of Authority"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY1@NAME"
msgstr "Challenging Light"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY1@DESCRIPTION"
msgstr "Deal damage to enemy units in a 1-hex radius."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY1@MODIFIER@NAME"
msgstr "Worthy Challenger"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY1@MODIFIER@DESCRIPTION"
msgstr ""
"+{THYRON_FEY_CHALLENGING_LIGHT_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} "
"{GLOBAL.SpiritDamageConcept.Hyperlink} for each Unit Tier of the target."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY2@NAME"
msgstr "Rejuvenating Respite"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY2@DESCRIPTION"
msgstr ""
"Friendly units in a 1-hex radius:[bulletlist][bullet/]Heal "
"{THYRON_FEY_REJUVENATING_RESPITE_HEAL>NumHitpointsToRestore} <<m:"
"{GLOBAL.TemporaryHitPointConcept}>>.[bullet/]If "
"{GLOBAL.PROPERTIES.FEY.Hyperlink}, gain a random "
"{GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist][br/]Enter "
"{GLOBAL.DefenseModeConcept.Hyperlink} after use."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY3@NAME"
msgstr "Call the Hurricane"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@ABILITY3@DESCRIPTION"
msgstr "Deal damage to enemy units in a 2-hex cone and knock them away."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@PASSIVE1@NAME"
msgstr "Servant of the Fey"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@PASSIVE1@DESCRIPTION"
msgstr ""
"While in the army, other {GLOBAL.PROPERTIES.FEY.Hyperlink} units without "
"{GLOBAL.PROPERTIES.THYRON_SERVANT_OF_FEY.Hyperlink} gain +1 "
"{GLOBAL.StatusResistanceConcept.Hyperlink} and +25% healing received in combat."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@PASSIVE1@MODIFIER@NAME"
msgstr "Emissary Support"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@UNIT_RABBIT@PASSIVE1@MODIFIER@DESCRIPTION"
msgstr ""
"Has +1 {GLOBAL.StatusResistanceConcept.Hyperlink} and +25% healing received in "
"combat."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_02@PASSIVE@NAME"
msgstr "Rhythm of the Seasons"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_02@PASSIVE@DESCRIPTION"
msgstr ""
"Unit gains a blessing depending on the current {GLOBAL.TurnConcept}:"
"[bulletlist][bullet/]{GLOBAL.TurnConcept} 1: Summer. All attacks deal +2 "
"{GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]{GLOBAL.TurnConcept} 2: "
"Autumn. Attacks and {GLOBAL.DebuffConcept.Hyperlink} abilities ignore up to 3 "
"{GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]{GLOBAL.TurnConcept} 3: "
"Winter. +2 {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]{GLOBAL.TurnConcept} 4: "
"Spring. Heal for 20 <<m:{GLOBAL.TemporaryHitPointConcept}>>.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@IMPROVEMENT@NAME"
msgstr "[teleporter/] Court's Worldgate"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@IMPROVEMENT@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+10 {GLOBAL.FoodConcept.Hyperlink}.[bullet/]+10 "
"{GLOBAL.GoldConcept.Hyperlink}.[bullet/]When placed, alter terrain into "
"Grasslands.[bullet/]Allows the drafting of "
"{GLOBAL.UNITS.SPRING_FAIRY.Hyperlink}.[bullet/]{GLOBAL.UnitConcept.Hyperlink} "
"deployment location.[bullet/]Functions as a "
"{GLOBAL.TeleporterConcept.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@SUMMER@NAME"
msgstr "Rhythm of the Seasons: Summer"

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@SUMMER@DESCRIPTION"
msgstr "All attacks deal +2 {GLOBAL.SpiritDamageConcept.Hyperlink}."

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@AUTUMN@NAME"
msgstr "Rhythm of the Seasons: Autumn"

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@AUTUMN@DESCRIPTION"
msgstr ""
"Attacks and {GLOBAL.DebuffConcept.Hyperlink} abilities ignore up to 3 "
"{GLOBAL.StatusResistanceConcept.Hyperlink}."

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@WINTER@NAME"
msgstr "Rhythm of the Seasons: Winter"

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@WINTER@DESCRIPTION"
msgstr "+2 {GLOBAL.DefenseConcept.Hyperlink}."

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@SPRING@NAME"
msgstr "Rhythm of the Seasons: Spring"

msgid "THYRON_TOME_FEY_KINGDOM@STATUS_EFFECT@SPRING@DESCRIPTION"
msgstr "Heals 20 <<m:{GLOBAL.TemporaryHitPointConcept}>>."

msgid "THYRON_TOME_FEY_KINGDOM@ASCENSION_TRAIT@NAME"
msgstr "Ascension: Fey Emissary"

msgid "THYRON_TOME_FEY_KINGDOM@ASCENSION_TRAIT@ABILITY_NAME"
msgstr "Ascended Emissary"

msgid "THYRON_TOME_FEY_KINGDOM@ASCENSION_TRAIT@DESCRIPTION"
msgstr ""
"While army leader, non-hero {GLOBAL.PROPERTIES.FEY.Hyperlink} units in the "
"army have:[bulletlist][bullet/]+"
"{THYRON_FEY_KINGDOM_ASCENSION_PASSIVE_BUFF_STAT_BONUS>BONUS>HitPo} <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+2 "
"{GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.MELEE_MAGE.Hyperlink}.[bullet/]Immunity to "
"{GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@ASCENSION_TRAIT@BUFF@ABILITY_NAME"
msgstr "Led by Ascended Emissary"

msgid "THYRON_TOME_FEY_KINGDOM@ASCENSION_TRAIT@BUFF@DESCRIPTION"
msgstr ""
"Unit has:[bulletlist][bullet/]+"
"{THYRON_FEY_KINGDOM_ASCENSION_PASSIVE_BUFF_STAT_BONUS>BONUS>HitPo} <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+2 "
"{GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.MELEE_MAGE.Hyperlink}.[bullet/]Immunity to "
"{GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_ARCTIC_UNDERGROUND"
msgstr ""
"Several fairies emerge from the frozen caves, ready to assist in your rightful "
"cause."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_ASTRAL_BARRENS"
msgstr ""
"Oops! The terrain has caused the summoning to go flat. No fairies have "
"responded."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_COLD"
msgstr ""
"A fairy emerges from the freezing mists, ready to assist in your rightful "
"cause."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_DEFAULT"
msgstr ""
"Several fairies emerge from the surroundings, ready to assist in your rightful "
"cause."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_HOT"
msgstr ""
"A fairy emerges from the burning wastes, ready to assist in your rightful "
"cause."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_SUNLESS"
msgstr ""
"A fairy emerges from the shadowy wastes, ready to assist in your rightful "
"cause."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_UNDERGROUND"
msgstr ""
"Several fairies emerge from the shadowy caves, ready to assist in your "
"rightful cause."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_UNDERGROUND_FIRE"
msgstr ""
"Several fairies emerge from the fiery caves, ready to assist in your rightful "
"cause."

msgid "THYRON_TOME_FEY_KINGDOM@TOME@SKILL_01@DIALOG_SUBHEADER_WATER"
msgstr ""
"Several fairies emerge from beneath the waves, ready to assist in your "
"rightful cause."

