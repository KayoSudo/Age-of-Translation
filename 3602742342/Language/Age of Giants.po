msgid "Tome_of_Cryogenics@PROPERTY@NAME"
msgstr "Cryo"

msgid "Tome_of_Cryogenics@PROPERTY@DESCRIPTION"
msgstr ""
"This unit cannot move or attack but gains immunity to:[bulletlist][bullet/]"
"{GLOBAL.FrostDamageConcept.Hyperlink}[bullet/]"
"{GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]"
"{GLOBAL.LightningDamageConcept.Hyperlink} [br/][br/]Cryo "
"{GLOBAL.OpposingStatusEffectsConcept.Hyperlink} "
"{GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Cryogenics@ABILITY_02@NAME"
msgstr "Arctic Charge Strike"

msgid "Tome_of_Cryogenics@ABILITY_02@DESCRIPTION"
msgstr ""
"A Charge attack:[bulletlist][bullet/]Gains +"
"{ARCTIC_CHARGE_STRIKE_DISTANCE_DAMAGE>DAMAGE>Frost} "
"{GLOBAL.FrostDamageConcept.Hyperlink} per hex traveled, up to "
"{ARCTIC_CHARGE_STRIKE_DISTANCE_DAMAGE>MaxCount} hexes.[bullet/]Cancels "
"{GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Removes "
"{GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Cryogenics@ABILITY_03@NAME"
msgstr "Hoarfrost Slam"

msgid "Tome_of_Cryogenics@ABILITY_03@DESCRIPTION"
msgstr ""
"Smash the ground in front of you dealing damage to all enemy units in a "
"{HOARFROST_SLAM_POSITION_TARGETER>AREA>Length}-hex line, leaving behind a "
"{GLOBAL.PROPERTIES.WET.Hyperlink} area."

msgid "Tome_of_Cryogenics@GAMEPLAY@DESCRIPTION"
msgstr ""
"Harness the power of Cryogenics to freeze, manipulate ice, and uncover the "
"mysteries of long-forgotten civilizations."

msgid "Tome_of_Cryogenics@PROVINCE_IMPROVEMENT@TITLE"
msgstr "[researchpost/] Weather Control Device"

msgid "Tome_of_Cryogenics@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+10 {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+3 "
"{GLOBAL.KnowledgeConcept.Hyperlink} per adjacent "
"{GLOBAL.ConduitConcept.Hyperlink}[bullet/]+3 "
"{GLOBAL.KnowledgeConcept.Hyperlink} per adjacent "
"{GLOBAL.ResearchPostConcept.Hyperlink}.[bullet/]Enemy <<m:"
"{GLOBAL.ArmyConcept.Hyperlink}>> in this City's "
"{GLOBAL.DomainConcept.Hyperlink} suffers from "
"{GLOBAL.PROPERTIES.HYPOTHERMIA_UNIT_PROPERTY.Hyperlink}.[bullet/]Counts as a "
"{GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Cryogenics@PROVINCE_IMPROVEMENT@PROPERTY_NAME"
msgstr "Hypothermia"

msgid "Tome_of_Cryogenics@PROVINCE_IMPROVEMENT@EFFECT"
msgstr ""
"This unit is under the effects of extreme weather conditions and is subject "
"to the following:[bulletlist][bullet/]This unit "
"{GLOBAL.PROPERTIES.CANNOT_REGENERATE.Hyperlink}.[bullet/]This Unit suffers -"
"{Visionrangereduction} {GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]"
"{HYPOTHERMIA_DEFENSE>REDUCTION>Frost} "
"{GLOBAL.FrostResistanceConcept.Hyperlink}.[bulletlist][bullet/]Units with "
"{GLOBAL.PROPERTIES.FROSTLING_TRANSFORMATION_PROPERTY_GROUP.Hyperlink} and/or "
"{GLOBAL.PROPERTIES.SUB_ZERO_ADAPTATION_PROPERTY_GROUP.Hyperlink} are "
"unaffected.[/bulletlist]"

msgid "Tome_of_Cryogenics@HERO_SKILL@NAME"
msgstr "Ash of War: Hoarfrost Slam"

