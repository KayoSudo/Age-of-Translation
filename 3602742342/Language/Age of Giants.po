msgid "Tome_of_Fire_Giants@TOME@NAME"
msgstr "Tome of Fire Giants"

msgid "Tome_of_Fire_Giants@Tome@LORE_DESCRIPTION"
msgstr ""
"\"In this majestic world, fire giants are ancient beings born from the very "
"essence of the core itself. Towering over mountains, their colossal strength "
"and wisdom make them revered guardians of nature. Legends speak of their "
"ability to shape the land and wield elemental powers, ensuring the balance "
"between mortal races and the forces of chaos.\""

msgid "Tome_of_Fire_Giants@TOME@LORE_AUTHOR"
msgstr "Ophelia Evergreen, the Enchantress of Words"

msgid "Tome_of_Fire_Giants@SKILL_01@NAME"
msgstr "Summon Fire Giant"

msgid "Tome_of_Fire_Giants@SKILL_01@DESCRIPTION"
msgstr ""
"Summons a {GLOBAL.UNITS.FIRE_GIANT.Hyperlink}, a "
"{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} that conjures runestones that "
"picks off enemies, and burns them with fiery smashes."

msgid "Tome_of_Fire_Giants@SKILL_02@NAME"
msgstr "Crusher Volcano"

msgid "Tome_of_Fire_Giants@SKILL_02@DESCRIPTION"
msgstr ""
"Units in a 2-hex radius:[bulletlist][bullet/]Receive 25 "
"{GLOBAL.FireDamageConcept.Hyperlink} and 10 "
"{GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Gain 2 "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink}.[bullet/]Gain 2 "
"{GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Fire_Giants@GAMEPLAY@DESCRIPTION"
msgstr ""
"Call upon the ancient Fire [hyperlink,GLOBAL.GiantsLoreConcept]Giants[/"
"hyperlink] and wield devastating powers of the past. Invoke powerful "
"{fireDamage} {GLOBAL.FireDamageConcept.Hyperlink} spells and summons. Use "
"the power of the Giants to wreck total domination."

msgid "Tome_of_Fire_Giants@SKILL_03@NAME"
msgstr "Towering Might"

msgid "Tome_of_Fire_Giants@SKILL_03@DESCRIPTION"
msgstr ""
"Makes {GLOBAL.MeleeConcept.Hyperlink} attacks of enchanted units deal:"
"[bulletlist][bullet/]+{TOWERING_MIGHT_EXTRA_DAMAGE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]"
"{TOWERING_MIGHT_EXTRA_DAMAGE>DAMAGE>Physical} "
"{GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]A base "
"{SCORCHED_RESISTANCE>ResolvedStrength}% chance of inflicting "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink}.[bullet/]Whenever this unit kills "
"another unit:[bulletlist][bullet/]The killed unit explodes, dealing 10 "
"{GLOBAL.FireDamageConcept.Hyperlink} to adjacent enemy units."
"[bullet/]Inflicts {GLOBAL.PROPERTIES.SCORCHED.Hyperlink} in a 1-hex radius.[/"
"bulletlist][/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "Tome_of_Fire_Giants@SKILL_03@PROPERETY"
msgstr ""
"Unit's {GLOBAL.MeleeConcept.Hyperlink} attacks have:[bulletlist][bullet/]+"
"{TOWERING_MIGHT_EXTRA_DAMAGE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]"
"{TOWERING_MIGHT_EXTRA_DAMAGE>DAMAGE>Physical} "
"{GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]A base "
"{SCORCHED_RESISTANCE>ResolvedStrength} % chance of inflicting "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink}.[bullet/]Whenever this unit kills "
"another unit:[bulletlist][bullet/]The killed unit explodes, dealing 10 "
"{GLOBAL.FireDamageConcept.Hyperlink} to adjacent enemy units."
"[bullet/]Inflicts {GLOBAL.PROPERTIES.SCORCHED.Hyperlink} in a 1-hex radius.[/"
"bulletlist][/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "Tome_of_Fire_Giants@SKILL_03@MODIFIER_DESCRIPTION"
msgstr ""
"Killing a unit causes it to explode, dealing "
"{TOWERING_MIGHT_UNIT_DAMAGE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} to adjacent units and applying 1 "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink}."

msgid "Tome_of_Fire_Giant@PROVINCE_01@NAME"
msgstr "[quarry/] Surtr's Altar"

msgid "Tome_of_Fire_Giant@PPROVINCE_01@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+10 {GLOBAL.StructureProductionConcept.Hyperlink}."
"[bullet/]+5 {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]+10 "
"{GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+5 "
"{GLOBAL.StructureProductionConcept.Hyperlink} per adjacent "
"{GLOBAL.QuarryConcept.Hyperlink}[bullet/]+5 "
"{GLOBAL.UnitProductionConcept.Hyperlink} per adjacent "
"{GLOBAL.QuarryConcept.Hyperlink}.[bullet/]Counts as a "
"{GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Fire_Giant@SKILL_04@NAME"
msgstr "Surtr's Kin"

msgid "Tome_of_Fire_Giant@SKILL_04DESCRIPTION"
msgstr ""
"Form a pact with Surtr and be blessed with the power of a Fire Giant:"
"[bulletlist][bullet/]+20 {GLOBAL.HitPointConcept.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}, "
"{GLOBAL.PROPERTIES.JUGGERNAUT.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}, "
"{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}.[bullet/]+6 "
"{GLOBAL.FireResistanceConcept.Hyperlink}, -4 "
"{GLOBAL.FrostResistanceConcept.Hyperlink}. [bullet/]+2 "
"{GLOBAL.DefenseConcept.Hyperlink}, +2 {GLOBAL.ResistanceConcept.Hyperlink}.[/"
"bulletlist]"

msgid "Tome_of_Fire_Giant@SKILL_05@NAME"
msgstr "Flowing Magma"

msgid "Tome_of_Fire_Giant@SKILL_05@DESCRIPTION"
msgstr ""
"Target enemy army:[bulletlist][bullet/]Sustains 25 "
"{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Loses 25% of its Move Points "
"on the {GLOBAL.WorldMapConcept.Hyperlink} for 1 "
"{GLOBAL.TurnConcept.Hyperlink}.[Bullet/]At the start of battle all units "
"suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} and 3 "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Fire_Giant@SKILL_06@NAME"
msgstr "Pyro Knight"

msgid "Tome_of_Fire_Giant@SKILL_06@DESCRIPTION"
msgstr ""
"A dangerous {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} who excels at duels, "
"even forcing one onto a chosen target."

msgid "Tome_of_Fire_Giants@PROPERETY@NAME"
msgstr "Scorched"

msgid "Tome_of_Fire_Giants@PROPERTY@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]-1 {GLOBAL.FireResistanceConcept.Hyperlink}."
"[bullet/]Adjacent units suffer 2 {GLOBAL.FireDamageConcept.Hyperlink} at the "
"end of the turn.[bullet/]Stacks up to 5 times.[/bulletlist]"

msgid "Tome_of_Fire_Giants@PROPERTY@MODIFIER_DESCRIPTION"
msgstr ""
"Base {SCORCHED_RESISTANCE>ResolvedStrength}% chance of inflicting "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink} for "
"{SCORCHED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "Tome_of_Fire_Giants@SKILL_06@ABILITY_NAME"
msgstr "Prelate's Charge"

msgid "Tome_of_Fire_Giants@SKILL_06@ABILITY_DESCRIPTION"
msgstr ""
"Strike target enemy, dealing damage and applying:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.TAUNTED.Hyperlink} to the target for 2 "
"{GLOBAL.TurnConcept.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.BERSERK.Hyperlink} to yourself for 2 "
"{GLOBAL.TurnConcept.Hyperlink}.[bullet/]{amount1} "
"{GLOBAL.FireDamageConcept.Hyperlink} to each adjacent enemy unit.[bullet/]"
"{amount2} {GLOBAL.PhysicalDamageConcept.Hyperlink} to each adjacent enemy "
"unit.[bullet/]All units affected have a chance to be affected by "
"{GLOBAL.PROPERTIES.BURNING.Hyperlink} and "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Rock_Giants@TOME@NAME"
msgstr "Tome of Rock Giants"

msgid "Tome_of_Rock_Giants@TOME@LORE_DESCRIPTION"
msgstr ""
"\"Rock Giants, ancient behemoths of the land, towered over the landscape, "
"their colossal forms merging with the very essence of nature. With skin "
"resembling rugged stone, their immense presence commanded reverence and awe. "
"These gentle giants, guardians of the earth, possessed an unwavering "
"connection to the earth's core, granting them unparalleled strength and "
"resilience. Legends whispered of their ability to shape mountains and sculpt "
"valleys with a mere touch, harmonizing the elements in a dance of creation. "
"In the annals of time, Rock Giants stood as eternal sentinels, embodying the "
"raw power and harmony that exists within the heart of our world.\""

msgid "Tome_of_Rock_Giants@TOME@LORE_AUTHOR"
msgstr "Aerethian Stonesong"

msgid "Tome_of_Rock_Giants@SKILL_01@NAME"
msgstr "Tomahawk Archers"

msgid "Tome_of_Rock_Giants@SKILL_01@DESCRIPTION"
msgstr "Placeholder"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_NAME_1"
msgstr "Shoot Tomahawkbow"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_DESCRIPTION_1"
msgstr ""
"Take a balanced stance and fire a devastating arrow at target enemy unit."

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_NAME_2"
msgstr "Placeholder"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_DESCRIPTION_2"
msgstr "Placeholder"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_NAME_2A"
msgstr "Name1"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_DESCRIPTION_2A"
msgstr "Ammo 1"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_NAME_2B"
msgstr "Name 2"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_DESCRIPTION_2B"
msgstr "Ammo 2"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_NAME_2C"
msgstr "Name 3"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_DESCRIPTION_2C"
msgstr "Ammo 3"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_NAME_3"
msgstr "Placeholder"

msgid "Tome_of_Rock_Giants@UNIT@ABILITY_DESCRIPTION_3"
msgstr "Placeholder"

msgid "Tome_of_Rock_Giants@SKILL_02@NAME"
msgstr "Earthquake"

msgid "Tome_of_Rock_Giants@SKILL_02@DESCRIPTION"
msgstr ""
"When cast and for 2 {GLOBAL.TurnConcept.Hyperlink} afterwards, all enemies:"
"[bulletlist][bullet/]Sustain 10 {GLOBAL.PhysicalDamageConcept.Hyperlink}."
"[bullet/]Have a 90% chance to be afflicted with "
"{GLOBAL.PROPERTIES.BLEEDING_DAMAGE_OVER_TIME.Hyperlink}.[bullet/]Have a 60% "
"chance to be afflicted with {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}"
"[bullet/]Have a 60% chance to be afflicted with "
"{GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}.[bullet/]All obstacles on the map "
"have a 25% chance of being destroyed.[/bulletlist]"

msgid "Tome_of_Rock_Giants@SKILL_03@NAME"
msgstr "Supply Line"

msgid "Tome_of_Rock_Giants@SKILL_03@DESCRIPTION"
msgstr ""
"Target friendly city sends all able bodies into the mines, converting their "
"{GLOBAL.UnitProductionConcept.Hyperlink} income into "
"{GLOBAL.GoldConcept.Hyperlink} and {GLOBAL.ManaConcept.Hyperlink} equal to "
"50% of total {GLOBAL.UnitProductionConcept.Hyperlink} income."

msgid "Tome_of_Rock_Giants@SKILL_04@NAME"
msgstr "Obsidian Arrows"

msgid "Tome_of_Rock_Giants@SKILL_04@DESCRIPTION"
msgstr ""
"{GLOBAL.RangedConcept.Hyperlink} attacks of enchanted units gain:[bulletlist]"
"[bullet/]+2 {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]A "
"{OBSIDIAN_ARROWS_ACCURACY_BOOST>ResolvedAccuracyModifier}% boost to "
"{GLOBAL.AccuracyConcept.Hyperlink}.[bullet/]Inflict a stack of "
"{GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Specialized arrows "
"causes units to suffer from {GLOBAL.PROPERTIES.SLOWED.Hyperlink} in combat "
"for the first 2 <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "Tome_of_Rock_Giants@SKILL_05@NAME"
msgstr "Jagged Defense"

msgid "Tome_of_Rock_Giants@SKILL_05@DESCRIPTION"
msgstr ""
"Your body forms specialized sharp rocks granting you:[bulletlist][bullet/]A "
"50% chance to reflect {GLOBAL.PhysicalDamageConcept.Hyperlink} sustained "
"back onto attackers.[bullet/]A 60% chance of applying "
"{GLOBAL.PROPERTIES.BLEEDING.Hyperlink} to attackers.[/bulletlist]"

msgid "Tome_of_Rock_Giants@SKILL_06@NAME"
msgstr "Metamorphic"

msgid "Tome_of_Rock_Giants@SKILL_06@DESCRIPTION"
msgstr ""
"Grants enchanted units:[bulletlist][bullet/]+10 "
"{GLOBAL.HitPointConcept.Hyperlink}.[bullet/]+3 "
"{GLOBAL.DefenseConcept.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.ROCK_SMASH.Hyperlink}, an AOE damage ability for use in "
"battle.[/bulletlist]"

msgid "Tome_of_Rock_Giants@PROVINCE_01@NAME"
msgstr "[mine/] Osmium Mine"

msgid "Tome_of_Rock_Giants@PROVINCE_01@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+15 {GLOBAL.GoldConcept.Hyperlink}.[bullet/]+7 "
"{GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]+7 "
"{GLOBAL.GoldConcept.Hyperlink} per adjacent {GLOBAL.QuarryConcept.Hyperlink} "
"or {GLOBAL.MineConcept.Hyperlink}.[bullet/]+7 "
"{GLOBAL.StructureProductionConcept.Hyperlink} per adjacent "
"{GLOBAL.QuarryConcept.Hyperlink} or {GLOBAL.MineConcept.Hyperlink}."
"[bullet/]Counts as a {GLOBAL.MineConcept.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Rock_Giants@PROPERTY@UNIT_DAMAGE_REFLECT@PHYSICAL"
msgstr ""
"Reflect {Value}% {GLOBAL.PhysicalDamageConcept.Hyperlink} of damage "
"sustained."

msgid "Tome_of_Rock_Giants@SKILL_04@PROPERETY"
msgstr ""
"Unit's attacks have:[bulletlist][bullet/]+"
"{OBSIDIAN_ARROWS_EXTRA_DAMAGE>DAMAGE>Physical} "
"{GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]"
"{OBSIDIAN_ARROWS_ACCURACY_BOOST>ResolvedAccuracyModifier}% boost to "
"{GLOBAL.AccuracyConcept.Hyperlink}.[bullet/}Inflict a stack of "
"{GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Specialized arrows "
"causes units to suffer from {GLOBAL.PROPERTIES.SLOWED.Hyperlink} in combat "
"for the first 2 <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "Tome_of_Rock_Giants@GAMEPLAY@DESCRIPTION"
msgstr ""
"With the power of the Rock [hyperlink,GLOBAL.GiantsLoreConcept]Giants[/"
"hyperlink] in your hands, use powerful spells to control the flow of battle. "
"Afflict your foes with "
"{GLOBAL.PROPERTIES.BLEEDING_DAMAGE_OVER_TIME.Hyperlink} and stop them with "
"massive {GLOBAL.PhysicalDamageConcept.Hyperlink} incantations."

msgid "Tome_of_Rock_Giants@SKILL_06@ABILITY_NAME"
msgstr "Rock Smash"

msgid "Tome_of_Rock_Giants@SKILL_06@ABILITY_DESCRIPTION"
msgstr "Deals damage to target unit and enemy units within 1-hex."

msgid "Tome_of_Storm_Giants@TOME@NAME"
msgstr "Tome of Storm Giants"

msgid "Tome_of_Storm_Giants@TOME@LORE_DESCRIPTION"
msgstr ""
"\"In the heart of the tempestuous mountains, where lightning danced among "
"towering peaks, the Storm Giants ruled with indomitable might. Their booming "
"footsteps shook the earth, their roars echoed through the valleys, and their "
"luminous eyes cast an eternal storm upon the world\"."

msgid "Tome_of_Storm_Giants@TOME@LORE_AUTHOR"
msgstr "Magnus Stormweaver"

msgid "Tome_of_Storm_Giants@SKILL_01@NAME"
msgstr "Summon Storm Giant"

msgid "Tome_of_Storm_Giants@SKILL_01@DESCRIPTION"
msgstr ""
"Summons a {GLOBAL.UNITS.STORM_GIANT.Hyperlink}, a "
"{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} that strikes enemies with bolts of "
"lighting, either from a distance or up close."

msgid "Tome_of_Storm_Giants@SKILL_02@NAME"
msgstr "Twister"

msgid "Tome_of_Storm_Giants@SKILL_02@DESCRIPTION"
msgstr ""
"Enemies in a 2-hex radius:[bulletlist][bullet/]Have a 90% chance to gain 2 "
"{GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}.[bullet/]Have a 90% chance "
"to be afflicted by {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[bullet/]Have "
"{GLOBAL.PROPERTIES.DISPLACEMENT.Hyperlink}.[bullet/]Become "
"{GLOBAL.PROPERTIES.WET.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Storm_Giants@SKILL_03@NAME"
msgstr "Thunderbolt"

msgid "Tome_of_Storm_Giants@SKILL_03@DESCRIPTION"
msgstr ""
"Enemy units in a 1-hex radius:[bulletlist][bullet/]Sustain 35 "
"{GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Have a 90% of becoming "
"{GLOBAL.PROPERTIES.CONDUCTIVE.Hyperlink}.[bullet/]Have a 60% chance of "
"becoming {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Storm_Giants@SKILL_04@NAME"
msgstr "Storm Weaver"

msgid "Tome_of_Storm_Giants@SKILL_04@DESCRIPTION"
msgstr ""
"Grants enchanted units:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.ASTRAL_MEMBRANE.Hyperlink}, which stuns attackers."
"[bullet/]{GLOBAL.PROPERTIES.BOLT.Hyperlink}, a damage ability for use in "
"battle.[/bulletlist]"

msgid "Tome_of_Storm_Giants@SKILL_05@NAME"
msgstr "Summon the Storm"

msgid "Tome_of_Storm_Giants@SKILL_05@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]Summon 3 {GLOBAL.UNITS.STORM_SPIRIT.Hyperlink}s on the "
"attacker's side until the end of battle.[bullet/]Units defending the city "
"take 20 {GLOBAL.LightningDamageConcept.Hyperlink} at the start of combat.[/"
"bulletlist]"

msgid "Tome_of_Storm_Giants@SKILL_06@NAME"
msgstr "Derecho Storm"

msgid "Tome_of_Storm_Giants@SKILL_06@DESCRIPTION"
msgstr ""
"Target enemy Army:[bulletlist][bullet/]Takes 25 "
"{GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Becomes "
"{GLOBAL.PROPERTIES.CONDUCTIVE.Hyperlink} and "
"{GLOBAL.PROPERTIES.WET.Hyperlink} for 3 {GLOBAL.TurnConcept.Hyperlink}.[/"
"bulletlist]"

msgid "Tome_of_Storm_Giants@PROVINCE_01@NAME"
msgstr "[conduit/] Lightning Rod"

msgid "Tome_of_Storm_Giants@PROVINCE_01@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+15 {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+5 "
"{GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+5 "
"{GLOBAL.KnowledgeConcept.Hyperlink} per adjacent "
"{GLOBAL.QuarryConcept.Hyperlink}.[bullet/]Counts as a "
"{GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Storm_Giants@SKILL_PROPERETY@NAME"
msgstr "Conductive"

msgid "Tome_of_Storm_Giants@SKILL_PROPERTY@DESCRIPTION"
msgstr ""
"Until end of combat unit suffers:[bulletlist][bullet/]-4 "
"{GLOBAL.LightningResistanceConcept.Hyperlink}.[bullet/]5 "
"{GLOBAL.LightningDamageConcept.Hyperlink} at the end of the turn. [br][br]"
"[bulletlist][bullet/]A 60% of passing debuff onto adjacent allies.[/"
"bulletlist]"

msgid "Tome_of_Storm_Giants@GAMEPLAY@DESCRIPTION"
msgstr ""
"Harnessing the crackling power of lightning, weaving them into spells that "
"can illuminate the darkest skies, electrocute foes, or even afflict them "
"with {GLOBAL.PROPERTIES.CONDUCTIVE.Hyperlink}."

msgid "Tome_of_Storm_Giants@SKILL_04@ABILITY_NAME"
msgstr "Bolt"

msgid "Tome_of_Storm_Giants@SKILL_04@ABILITY_DESCRIPTION"
msgstr ""
"Deals damage to target and up to 2 other units within 3 hexes. They have a "
"60% of being afflicted with {GLOBAL.PROPERTIES.CONDUCTIVE.Hyperlink}."

msgid "Tome_of_Storm_Giants@PROPERTY@ASTRAL_ATTUNEMENT@EFFECT"
msgstr ""
"{Value.Sign} {GLOBAL.LightningDamageConcept.Hyperlink} to target and all "
"adjacent units"

msgid "Tome_of_Storm_Giants@HERO_SKILL@DESCRIPTION"
msgstr "Gain the {GLOBAL.PROPERTIES.BOLT.Hyperlink} ability."

msgid "Tome_of_Scorched@TOME@NAME"
msgstr "Tome of Scorching"

msgid "Tome_of_Scorched@TOME@LORE_DESCRIPTION"
msgstr ""
"\"Scorched\" evokes images of desolation and change wrought by intense heat "
"or fire, whether in the charred remnants of a once-lush landscape after a "
"wildfire, or the emotional aftermath of a turbulent experience."

msgid "Tome_of_Scorched@TOME@LORE_AUTHOR"
msgstr "Amelia Sterling, World Renowned Alchemist"

msgid "Tome_of_Scorched@GAMEPLAY@DESCRIPTION"
msgstr ""
"Turn the tide of battle using powerful "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink} invocations, and even transcend your "
"flesh with steel."

msgid "Tome_of_Scorched@MK2ROVINGFURNACE@NAME"
msgstr "Scorching Furnace"

msgid "Tome_of_Scorched@MK2ROVINGFURNACE@DESCRIPTION"
msgstr ""
"A heavy {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} that applies "
"{GLOBAL.PROPERTIES.SCORCHED.Hyperlink} when attacking or being attacked."

msgid "Tome_of_Scorched@MK2ROVINGFURNACE@ABILITY01@NAME"
msgstr "Scorched Waste"

msgid "Tome_of_Scorched@MK2ROVINGFURNACE@ABILITY01@DESCRIPTION"
msgstr ""
"When this unit attacks or is attacked, adjacent units:[bulletlist]"
"[bullet/]Sustain {amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Have "
"a {chance}% chance of becoming {GLOBAL.PROPERTIES.SCORCHED.Hyperlink}.[/"
"bulletlist]"

msgid "Tome_of_Scorched@MK2ROVINGFURNACE@ABILITY01@MOD_DESCRIPTION"
msgstr ""
"Adjacent units:[bulletlist][bullet/]Sustain {amount} "
"{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Have a {chance}% chance of "
"becoming {GLOBAL.PROPERTIES.SCORCHED.Hyperlink}.[/bulletlist]"

msgid "Tome_of_Scorched@MK2ROVINGFURNACE@ABILITY02@NAME"
msgstr "Reactor Dump"

msgid "Tome_of_Scorched@MK2ROVINGFURNACE@ABILITY02@DESCRIPTION"
msgstr ""
"Dumps some fuel from it's core, damaging all units in a "
"{REACTOR_DUMP_TARGETER>AREA>Length}-hex line."

msgid "Tome_of_Scorched@SKILL_02@NAME"
msgstr "Rad Storm"

msgid "Tome_of_Scorched@SKILL_02@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]A {GLOBAL.RadStormConcept.Hyperlink} forms over head in "
"a {RAD_STORM_POSITION_TARGETER_CRICLE_1>AREA>Radius}-hex radius."
"[bullet/]Each turn, the radius increases by 1 hex. [bullet/]Lasts for "
"{RAD_STORM_AUTO_SPELL_1>Duration}<<:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "Tome_of_Scorched@SKILL_03@NAME"
msgstr "Ready for Battle"

msgid "Tome_of_Scorched@SKILL_03@DESCRIPTION"
msgstr ""
"[bulletlist]Friendly {GLOBAL.MeleeConcept.Hyperlink} units in a 1-hex radius:"
"[bullet/]Have 1 {GLOBAL.NegativeStatusEffectConcept.Hyperlink} dispelled."
"[bullet/]Gain 1 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Gain 1 "
"{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]Gain 1 "
"{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}.[/bulletlist][br/]Enemy "
"{GLOBAL.MeleeConcept.Hyperlink} units in that same radius:[bulletlist]"
"[bullet/]Gain 1 {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[bullet/]Gain 1 "
"{GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Gain 1 "
"{GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}.[/bulletlist}"

msgid "Tome_of_Scorched@SKILL_04@NAME"
msgstr "Operation Orchid"

