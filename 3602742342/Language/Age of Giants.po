"{GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:"
"{GLOBAL.ProvinceConcept.Hyperlink}>> within or adjacent to the "
"{GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Gain "
"{GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]Lose "
"{GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, "
"{GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, "
"{GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, "
"{GLOBAL.CavernFloorConcept.Hyperlink}, and "
"{GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]Provinces in "
"the domain provide +1 {GLOBAL.GoldConcept.Hyperlink}, +1 "
"{GLOBAL.KnowledgeConcept.Hyperlink}, and +1 "
"{GLOBAL.StructureProductionConcept.Hyperlink} income.[bullet/]Provinces in "
"the domain lose -4 {GLOBAL.FoodConcept.Hyperlink} and -4 "
"{GLOBAL.ManaConcept.Hyperlink}.[/bulletlist]"

