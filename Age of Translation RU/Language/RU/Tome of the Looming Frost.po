msgid "VM@TOME_LOOMING_FROST@TOME@NAME"
msgstr "Книга надвигающегося мороза"

msgid "VM@TOME_LOOMING_FROST@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Сокрушите врагов {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} и заставьте их пасть перед крадущимся холодом."

msgid "VM@TOME_LOOMING_FROST@TOME@LORE_DESCRIPTION"
msgstr "«Жизнь обрывает не внезапный холод, а медленная гибель от подкрадывающейся стужи. С каждым мгновением мороз проникает глубже, отнимая дыхание и движение, пока не угаснет сопротивление. Холод терпелив: он ждёт, пока решимость не разобьётся, как лёд»."

msgid "VM@TOME_LOOMING_FROST@TOME@LORE_AUTHOR"
msgstr "Арвик Тёмный"

msgid "VM@TOME_LOOMING_FROST@TOME@ASCENSION@TRAIT@NAME"
msgstr "Вознесение: Хранитель мороза"

msgid "VM@TOME_LOOMING_FROST@TOME@ASCENSION@ABILITY@NAME"
msgstr "Вознесённая ледяная нова"

msgid "VM@TOME_LOOMING_FROST@TOME@ASCENSION@ABILITY@EFFECT@DESCRIPTION"
msgstr "Накладывает {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} на {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL1@NAME"
msgstr "Леденящая сосредоточенность"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL1@DESCRIPTION"
msgstr "{GLOBAL.MagicConcept.Hyperlink} атаки зачарованных отрядов: [bulletlist][bullet/]Наносят +{VM_TLF_FREEZING_FOCUS_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}. [bullet/]Имеют базовый шанс 90% наложить {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} на {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL2@NAME"
msgstr "Леденящее присутствие"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL2@DESCRIPTION"
msgstr "Даёт зачарованным отрядам: [bulletlist][bullet/]{GLOBAL.PROPERTIES.VM_TLF_FROST_ARMOR_PROPERTY_GROUP.Hyperlink}, снижающее {GLOBAL.FrostResistanceConcept.Hyperlink} и {GLOBAL.StatusResistanceConcept.Hyperlink} ближайших соседних вражеских отрядов.[/bulletlist]"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL2@EFFECT@DESCRIPTION"
msgstr "Соседние враги без этой черты получают: [bulletlist][bullet/]{VM_TLF_CHILLING_AURA_RESISTANCE_DOWN>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[bullet/]{VM_TLF_CHILLING_AURA_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}[/bulletlist][br/][br/]Этот эффект складывается."

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL2@EFFECT@ENEMY_DESCRIPTION"
msgstr "Отряд получает: [bulletlist][bullet/]{VM_TLF_CHILLING_AURA_RESISTANCE_DOWN>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[bullet/]{VM_TLF_CHILLING_AURA_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL3@NAME"
msgstr "Хранитель мороза"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL3@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}, изнуряющий врагов холодом."

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL4@NAME"
msgstr "Дрожащая буря"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL4@DESCRIPTION"
msgstr "В конце хода владельца все враги без иммунитета к {GLOBAL.PROPERTIES.FROZEN.Hyperlink} с базовой вероятностью 60% получают {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} на {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL4@PROP_DESCRIPTION"
msgstr "В конце хода владельца: [bulletlist][bullet/]Все враги без иммунитета к {GLOBAL.PROPERTIES.FROZEN.Hyperlink} с базовой вероятностью {STATUS_VULNERABILITY_RESISTANCE>ResolvedStrength}% получают {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} на {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL5@NAME"
msgstr "Ледяной выброс"

msgid "VM@TOME_LOOMING_FROST@TOME@SKILL5@DESCRIPTION"
msgstr "Вражеские отряды в радиусе {VM_TLF_FROZEN_BURST_TARGETER>AREA>Radius} клеток: [bulletlist][bullet/]Получают {VM_TLF_FROZEN_BURST_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}. [bullet/]С базовой вероятностью {SLOWED_RESISTANCE>ResolvedStrength}% получают {GLOBAL.PROPERTIES.SLOWED.Hyperlink} на {SLOWED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]Если уже имеют {GLOBAL.PROPERTIES.SLOWED.Hyperlink} или {GLOBAL.PROPERTIES.WET.Hyperlink}, с базовой вероятностью {VM_TLF_FROZEN_BURST_FROZEN_RESISTANCE_CHECK>ResolvedStrength}% получают {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "VM@TOME_LOOMING_FROST@UNIT@NAME"
msgstr "Хранитель мороза"

msgid "VM@TOME_LOOMING_FROST@UNIT@ABILITY@NAME"
msgstr "Ледяная нова"

msgid "VM@TOME_LOOMING_FROST@UNIT@ABILITY@DESCRIPTION"
msgstr "Этот отряд входит в {GLOBAL.DefenseModeConcept} и наносит {GLOBAL.FrostDamageConcept.Hyperlink} всем соседним вражеским отрядам."

msgid "VM@TOME_LOOMING_FROST@UNIT@ABILITY2@NAME"
msgstr "Щит обморожения"

msgid "VM@TOME_LOOMING_FROST@UNIT@ABILITY2@DESCRIPTION"
msgstr "Когда попадает {GLOBAL.MeleeConcept.Hyperlink} атака, атакующий получает {REFLECTION_FROST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}."

