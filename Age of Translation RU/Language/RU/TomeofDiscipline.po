msgid "TOME@DISC@PANTHEON@NAME5"
msgstr ""

msgid "TOME@DISC@PANTHEON@NAME@1"
msgstr "Голос командира"

msgid "TOME@DISC@PANTHEON@NAME@2"
msgstr "Когда этот отряд входит в {GLOBAL.DefenseModeConcept.Hyperlink}: [bulletlist][bullet/]Соседние союзные отряды получают 1 ед. {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

