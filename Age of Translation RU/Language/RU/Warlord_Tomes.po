msgid "NAME@PLACEHOLDER"
msgstr "описание-заполнитель"

msgid "DESCRIPTION@PLACEHOLDER"
msgstr "описание-заполнитель"

msgid "MOD@WARLORD@TOME_LEGIONS@TOME@NAME"
msgstr "Книга легионов"

msgid "MOD@WARLORD@TOME_LEGIONS@TOME@DESCRIPTION"
msgstr "Овладейте искусством войны. Соберите безжалостные армии и специализируйтесь на координации различных подразделений."

msgid "MOD@WARLORD@TOME_LEGIONS@TOME@LORE_DESCRIPTION"
msgstr "«Лидерство превыше всего на войне имеет первостепенное значение. Даже самые дисциплинированные солдаты, самые свирепые боевые звери и самые разрушительные заклинания растрачиваются в руках слабовольного лидера или слабоумного тактика. Я больше боюсь армии овец, возглавляемой львом, чем армии львов, возглавляемой овцой!»"

msgid "MOD@WARLORD@TOME_LEGIONS@TOME@LORE_AUTHOR"
msgstr "Хатун Шура, военачальник Шад'рай"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_01@NAME"
msgstr "Стандарт Легиона"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_01@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}, который призывает легион отрядов {GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink}, чтобы сокрушить врага."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_02@NAME"
msgstr "Развертывание резервов"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_02@DESCRIPTION"
msgstr "Призовите 2 отряда {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} и 2 {GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink}.\nНеобходимо нацелиться на позицию в пределах 2 гексов от дружественного отряда."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_03@NAME"
msgstr "общевойсковой"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_03@DESCRIPTION"
msgstr "За каждый другой дружественный класс отряда с {GLOBAL.PROPERTIES.LEGION_PROPERTY.Hyperlink} в бою зачарованные отряды получают: [bulletlist][bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% урона с [hyperlink,GLOBAL.CriticalHitConcept]Критические удары[/hyperlink].[/bulletlist]"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_03@PROPERTY@DESCRIPTION"
msgstr "За каждый другой дружественный класс отряда с общевойсковым оружием в бою этот отряд получает: [bulletlist][bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% урона с [hyperlink,GLOBAL.CriticalHitConcept]Критический урон. Обращения[/hyperlink].[/bulletlist]"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_04@NAME"
msgstr "Свита Легиона"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_04@DESCRIPTION"
msgstr "Предоставляет зачарованные юниты: [bulletlist][bullet/]. В начале битвы вызовите отряд {GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_04@PROPERTY@DESCRIPTION"
msgstr "В начале битвы призовите отряд {GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_05@NAME"
msgstr "Страшный марш"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_05@DESCRIPTION"
msgstr "Все дружественные отряды в целевой провинции восстанавливают половину своих очков движения.\nОтряд не может получить выгоду от этого заклинания более одного раза за ход."

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_06@NAME"
msgstr "Военный колледж"

msgid "MOD@WARLORD@TOME_LEGIONS@SKILL_06@DESCRIPTION"
msgstr "Все герои под вашим контролем получают: [bulletlist][bullet/]20 {GLOBAL.ExperienceConcept.Hyperlink} за каждый {GLOBAL.TurnConcept.Hyperlink} на карте мира. [bullet/]Способность {GLOBAL.PROPERTIES.LEGIONS_BATTLE_PLAN.Hyperlink}, которая может предоставить всем юнитам в бою различные эффекты положительного статуса."

msgid "MOD@WARLORD@TOME_LEGIONS@SPECIAL_PROVINCE_IMPROVEMENT@NAME"
msgstr "[quarry/] Колизей"

msgid "MOD@WARLORD@TOME_LEGIONS@SPECIAL_PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+1 {GLOBAL.ImperiumConcept.Hyperlink} для каждого уровня {GLOBAL.CityStabilityConcept.Hyperlink} выше нейтрального.[bullet/]+5 {GLOBAL.CityStabilityConcept.Hyperlink} для каждого соседнего {GLOBAL.ProvinceImprovementConcept.Hyperlink}.[bullet/]20% от Доход {GLOBAL.UnitProductionConcept.Hyperlink} в городе конвертируется в {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]Считается как {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_01@NAME"
msgstr "Стандарт Легиона"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_01@DESCRIPTION"
msgstr "заполнитель"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_02@NAME"
msgstr "когорта"

msgid "MOD@WARLORD@TOME_LEGIONS@UNIT_02@DESCRIPTION"
msgstr "заполнитель"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_01@NAME"
msgstr "Зов Легиона"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_01@DESCRIPTION"
msgstr "В начале битвы призовите 2 отряда {GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@NAME"
msgstr "Знамя Легиона"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@DESCRIPTION"
msgstr "Прирост соседних дружественных отрядов: [bulletlist][bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]+{UNDER_LEGION_BANNER_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[/bulletlist]\nНе складывается."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@PROPERTY@NAME"
msgstr "Под знаменем Легиона"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_02@PROPERTY@DESCRIPTION"
msgstr "Данное устройство имеет: [bulletlist][bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+{UNDER_LEGION_BANNER_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]+{UNDER_LEGION_BANNER_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[/bulletlist]\nНе складывается."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_03@NAME"
msgstr "Раскалывающие щиты"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_03@DESCRIPTION"
msgstr "Атакующие в ближнем бою имеют базовый шанс {SUNDERED_DEFENSE_RESISTANCE>ResolvedStrength}% получить {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_04@NAME"
msgstr "Режим защиты: знамя растений"

msgid "MOD@WARLORD@TOME_LEGIONS@PROPERTY_04@DESCRIPTION"
msgstr "Этот отряд заканчивает свой ход и переходит в оборонительный режим. Отряд:[bulletlist][bullet/] Распространяет свой {GLOBAL.ZoneOfControlConcept.Hyperlink} на все соседние гексы.[bullet/]Gains +{DEFENSE_MODE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Gains +{DEFENSE_MODE_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/] Становится невосприимчивым к {GLOBAL.FlankingConcept.Hyperlink}.[bullet/] Дружественные подразделения в шестигранном радиусе {RAISE_BANNER_AUTO_SPELL_TARGETER>AREA>Radius} получают +{RAISE_BANNER_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_01@NAME"
msgstr "Раскалывающее комбо"

msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_01@MODIFIER"
msgstr "Третья атака за ход наносит 2 {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_02@NAME"
msgstr "За каждый класс дружественных юнитов с этим зачарованием в бою зачарованные юниты получают: [bulletlist][bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% урона с [hyperlink,GLOBAL.CriticalHitConcept]Критический урон. Обращения[/hyperlink]."

msgid "MOD@WARLORD@TOME_LEGIONS@MODIFIER_02@MODIFIER"
msgstr "За каждый другой дружественный класс отряда с этим зачарованием в бою этот отряд получает: [bulletlist][bullet/]+{COMBINED_ARMS_ENCH_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]+{COMBINED_ARMS_ENCH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% урона с [hyperlink,GLOBAL.CriticalHitConcept]Критический урон. Обращения[/hyperlink]."

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_01@NAME"
msgstr "Кулак войны"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_01@DESCRIPTION"
msgstr "описание-заполнитель"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_01@MODIFIER@DESCRIPTION"
msgstr "За каждого дружественного отряда, примыкающего к цели, эта атака получает +{TACTICIAN_STRIKE_ADJACENT_COUNT>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_02@NAME"
msgstr "Вызов подкрепления"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_02@DESCRIPTION"
msgstr "Призовите отряд {GLOBAL.UNITS.LEGIONS_COHORT_UNIT.Hyperlink}.\nЭтот призыв длится {LEGION_REINFORCEMENTS_SUMMON_EFFECT>TurnsToLive} [turn/] [hyperlink,GLOBAL.TurnConcept]Turns[/hyperlink]"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@NAME"
msgstr "Стратагема"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@DESCRIPTION"
msgstr "Нацельтесь на дружественный отряд. В зависимости от класса отряда цели все дружественные отряды получают: [bulletlist][bullet/]{GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}: 3 {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink}: 3 {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FIGHTER.Hyperlink}: 3 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}: {GLOBAL.PROPERTIES.HASTENED.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink}: 3 {GLOBAL.PROPERTIES.FORTUNE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink}: 3 {GLOBAL.PROPERTIES.EVASION.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}: 3 {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}: 3 {GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}: {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}.[/bulletlist]\nНе влияет на [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] и [hyperlink,GLOBAL.PROPERTIES.MYTHIC_UNIT]Мифические юниты [/hyperlink].\nВсе дружественные отряды с этой способностью имеют общее время восстановления 2 {GLOBAL.TurnConcept.Hyperlink}."

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@PROPERTY@NAME"
msgstr "План битвы"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_03@PROPERTY@DESCRIPTION"
msgstr "Этот герой получает 20 {GLOBAL.ExperienceConcept.Hyperlink} за каждый {GLOBAL.TurnConcept.Hyperlink} на карте мира."

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_04@NAME"
msgstr "Авангардный удар"

msgid "MOD@WARLORD@TOME_LEGIONS@ABILITY_04@DESCRIPTION"
msgstr "Ударьте по целевому отряду и введите {GLOBAL.DefenseModeConcept.Hyperlink}."

