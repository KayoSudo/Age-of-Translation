msgid "MOD@FRACTURED_TOME@TOME@NAME"
msgstr "Tome of the Fracture"

msgid "MOD@FRACTURED_TOME@TOME@LORE_DESCRIPTION"
msgstr "“Born from the folly of archmages who reached beyond creation, the Cataclysm devours all certainty. Its power rends the land, twists living essence, and unleashes violent surges of unstable magic. Few survive its touch unchanged, yet in the Withered Worlds, ruin itself has become a source of strength.”"

msgid "MOD@FRACTURED_TOME@TOME@LORE_AUTHOR"
msgstr "Ylac, The Exiled"

msgid "MOD@FRACTURED_TOME@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Unleash the devastating energies of the cataclysm upon your enemies and infuse your people with it's powers."

msgid "MOD@FRACTURED_TOME@SPI@NAME"
msgstr "Fracture Conjurer"

msgid "MOD@FRACTURED_TOME@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]The city loses 10% of its {GLOBAL.ManaConcept.Hyperlink} income, and gains triple that amount as {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/] Allow the drafting of Fractured <<m:{GLOBAL.UnitConcept.Hyperlink}>> in your cities.[/bulletlist]"

msgid "MOD@FRACTURED_TOME@PASSIVE@DESCRIPTION"
msgstr "Lose 20[caststrategic/][casttactical/] Casting Points."

msgid "MOD@FRACTURED_TOME@IRRADIANT@DESCRIPTION"
msgstr "Target army:[bulletlist][bullet/]Sustains 15 {GLOBAL.PhysicalDamageConcept.Hyperlink}, doubled if cast on an {GLOBAL.AstralBarrensConcept.Hyperlink}.[bullet/]For 1 {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, at the start of combat units in this army has a 60% chance of becoming {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[/bulletlist"

msgid "MOD@FRACTURED_TOME@TEAR@DESCRIPTION"
msgstr "Target hex becomes marked, Units in 2-hex radius of the marked hex have a 60% base chance of receiving {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}. After 1 {GLOBAL.TurnConcept.Hyperlink}, the marked hex explodes and inflicts the following in a 2-hex radius:[bulletlist][bullet/]Units suffer 48 {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Units have 60% base chance of suffering {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[bullet/]Each hex has 20% chance of creating a Mana Fracture obstacle, which have {GLOBAL.DrainingConcept.Hyperlink} and spread to adjacent hexes when spells are cast.[/bulletlist][br/][br/]This spell cannot [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "MOD@FRACTURED_TOME@DEVOURING_WINDS@NAME"
msgstr "Devouring Winds"

msgid "MOD@FRACTURED_TOME@DEVOURING_WINDS@DESCRIPTION"
msgstr "Target friendly {GLOBAL.CityConcept.Hyperlink} gains:[bulletlist][bullet/]Every {GLOBAL.TurnConcept.Hyperlink}, 1 <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> within or adjacent to the {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Gain [hyperlink,GLOBAL.AstralBarrensConcept]Astral Barrens[/hyperlink].[bullet/]Lose {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink} and {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]Provinces in the domain with Astral Barrens gain: +3 {GLOBAL.StructureProductionConcept.Hyperlink} and +3 {GLOBAL.GoldConcept.Hyperlink}[/bulletlist]"

msgid "MOD@FRACTURED_TOME@PASSIVE"
msgstr "Magical Drain"
