msgid "THYRON_TOME_RESONANCE@TOME@NAME"
msgstr "Tome of Resonance"

msgid "THYRON_TOME_RESONANCE@TOME@DESCRIPTION"
msgstr ""
"Unite different {GLOBAL.UnitConcept.Hyperlink} types and make them work "
"together in arcane formations."

msgid "THYRON_TOME_RESONANCE@TOME@LORE_DESCRIPTION"
msgstr ""
"\"It is not death I fear the most - it is dissonance. The crushing discord "
"of impossibility to connect, the void that reaches for us when we're alone - "
"even at war, even during strife, we escape this fate by putting aside our "
"differences and connecting together into a larger, beautiful whole.\""

msgid "THYRON_TOME_RESONANCE@TOME@AUTHOR_NAME"
msgstr "Reginald Hortis, Apprentice Synchromancer"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_01@NAME"
msgstr "Blades of Synergy"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_01@DESCRIPTION"
msgstr ""
"Attacks of enchanted units gain:[bulletlist][bullet/]+"
"{THYRON_BLADES_OF_SYNERGY_COUNTING_TIER_DAMAGE>DAMAGE>Shock} "
"{GLOBAL.LightningDamageConcept.Hyperlink} per each friendly Unit Type "
"present in battle: {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink}, "
"{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, "
"{GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}.[bullet/]+"
"{THYRON_BLADES_OF_SYNERGY_EXTRA_DAMAGE_CHALLENGED>ResolvedMultipl}% damage "
"against those Unit Types.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_01@UNIT_DESCRIPTION"
msgstr ""
"This unit's attacks have:[bulletlist][bullet/]+"
"{THYRON_BLADES_OF_SYNERGY_COUNTING_TIER_DAMAGE>DAMAGE>Shock} "
"{GLOBAL.LightningDamageConcept.Hyperlink} per each friendly Unit Type "
"present in battle: {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink}, "
"{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, "
"{GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}.[bullet/]+"
"{THYRON_BLADES_OF_SYNERGY_EXTRA_DAMAGE_CHALLENGED>ResolvedMultipl}% damage "
"against those Unit Types.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_01@MODIFIER_DESC"
msgstr ""
"+{THYRON_BLADES_OF_SYNERGY_COUNTING_TIER_DAMAGE>DAMAGE>Shock} "
"{GLOBAL.LightningDamageConcept.Hyperlink} per each friendly "
"{GLOBAL.RangedConcept.Hyperlink} or {GLOBAL.MagicConcept.Hyperlink} Unit "
"Type in battle."

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_02@NAME"
msgstr "Synergistic Imbuement"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_02@DESCRIPTION"
msgstr ""
"Attacks of enchanted units gain:[bulletlist][bullet/]+"
"{THYRON_SYNERGISTIC_IMBUEMENT_COUNTING_TIER_DAMAGE>DAMAGE>Physica} "
"{GLOBAL.PhysicalDamageConcept.Hyperlink} per each friendly Unit Type present "
"in battle: {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.FIGHTER.Hyperlink}, "
"{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}.[bullet/]+"
"{THYRON_SYNERGISTIC_IMBUEMENT_EXTRA_DAMAGE_CHALLENGED>ResolvedMul}% damage "
"against those Unit Types.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_02@UNIT_DESCRIPTION"
msgstr ""
"This unit's attacks have:[bulletlist][bullet/]+"
"{THYRON_SYNERGISTIC_IMBUEMENT_COUNTING_TIER_DAMAGE>DAMAGE>Physica} "
"{GLOBAL.PhysicalDamageConcept.Hyperlink} per each friendly Unit Type present "
"in battle: {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}, "
"{GLOBAL.PROPERTIES.FIGHTER.Hyperlink}, "
"{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}.[bullet/]+"
"{THYRON_SYNERGISTIC_IMBUEMENT_EXTRA_DAMAGE_CHALLENGED>ResolvedMul}% damage "
"against those Unit Types.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_02@MODIFIER_DESC"
msgstr ""
"+{THYRON_SYNERGISTIC_IMBUEMENT_COUNTING_TIER_DAMAGE>DAMAGE>Physica} "
"{GLOBAL.PhysicalDamageConcept.Hyperlink} per each friendly "
"{GLOBAL.MeleeConcept.Hyperlink} Unit Type in battle."

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_03@NAME"
msgstr "Synchronize"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_03@DESCRIPTION"
msgstr ""
"Friendly units in a 1-hex radius gain a "
"{GLOBAL.PositiveStatusEffectConcept.Hyperlink} depending on their own Unit "
"Type:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}: "
"{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} or "
"{GLOBAL.PROPERTIES.FIGHTER.Hyperlink}: "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink}: "
"{GLOBAL.PROPERTIES.HASTENED.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} or "
"{GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink}: "
"{GLOBAL.PROPERTIES.FORTUNE.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}: 2x "
"{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} or "
"{GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}: "
"{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}: "
"{GLOBAL.PROPERTIES.HASTENED.Hyperlink} and "
"{GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_04@NAME"
msgstr "Hyper-Activation"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_04@DESCRIPTION"
msgstr ""
"Target owned city has:[bulletlist][bullet/]+15 "
"{GLOBAL.StructureProductionConcept.Hyperlink}, +15 "
"{GLOBAL.FoodConcept.Hyperlink} and +15 "
"{GLOBAL.UnitProductionConcept.Hyperlink} income.[bullet/]-10 "
"{GLOBAL.FortificationHealthConcept}.[/bulletlist]"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_05@NAME"
msgstr "Resonant Golem"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_05@DESCRIPTION"
msgstr ""
"A {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} "
"{GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} that deals more damage with more "
"different Unit Types on the battlefield."

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_06@NAME"
msgstr "Summon Resonant Cubes"

msgid "THYRON_TOME_RESONANCE@TOME@SKILL_06@DESCRIPTION"
msgstr ""
"Target friendly army leader:[bulletlist][bullet/]At the start of combat, "
"summons 3 Resonant Cube units, which are stationary "
"{GLOBAL.PROPERTIES.TOWER.Hyperlink} <<m:"
"{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>> that gain a random Unit Type:"
"[bulletlist][bullet/]"
"[hyperlink,GLOBAL.UNITS.THYRON_RESONANCE_TESSERACT_BATTLE_MAGE]Battle Mage[/"
"hyperlink],[bullet/]"
"[hyperlink,GLOBAL.UNITS.THYRON_RESONANCE_TESSERACT_SUPPORT]Support[/"
"hyperlink],[bullet/]"
"[hyperlink,GLOBAL.UNITS.THYRON_RESONANCE_TESSERACT_RANGED]Ranged[/hyperlink],"
"[bullet/][hyperlink,GLOBAL.UNITS.THYRON_RESONANCE_TESSERACT_MELEE]Shield[/"
"hyperlink].[/bulletlist][/bulletlist]"

