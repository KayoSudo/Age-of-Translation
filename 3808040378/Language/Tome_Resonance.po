msgid "THYRON_TOME_RESONANCE@TOME@IMPROVEMENT@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+10 {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+2 "
"{GLOBAL.KnowledgeConcept.Hyperlink} per adjacent "
"{GLOBAL.ForesterConcept.Hyperlink}.[bullet/]+2 "
"{GLOBAL.GoldConcept.Hyperlink} per adjacent {GLOBAL.QuarryConcept.Hyperlink}."
"[bullet/]+2 {GLOBAL.ManaConcept.Hyperlink} per adjacent "
"{GLOBAL.FarmConcept.Hyperlink}.[bullet/]Counts as a "
"{GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_RESONANCE@PASSIVE@01@NAME"
msgstr "Synergy"

