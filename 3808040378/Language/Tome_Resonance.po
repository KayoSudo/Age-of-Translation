msgid "THYRON_TOME_RESONANCE@ASCENSION_TRAIT@ABILITY_NAME"
msgstr "Ascended Synergy"

msgid "THYRON_TOME_RESONANCE@ASCENSION_TRAIT@DESCRIPTION"
msgstr ""
"This unit has:[bulletlist][bullet/]All attacks deal -2 damage.[bullet/]"
"{GLOBAL.MeleeConcept.Hyperlink} and {GLOBAL.RangedConcept.Hyperlink} attacks "
"deal +{THYRON_BLADES_OF_SYNERGY_COUNTING_TIER_DAMAGE>DAMAGE>Shock} "
"{GLOBAL.LightningDamageConcept} per each friendly ranged or magic Unit Type "
"in battle.[bullet/]{GLOBAL.MagicConcept.Hyperlink} attacks deal +"
"{THYRON_SYNERGISTIC_IMBUEMENT_COUNTING_TIER_DAMAGE>DAMAGE>Physica} "
"{GLOBAL.PhysicalDamageConcept} per each friendly melee Unit Type in battle.[/"
"bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}[br/]Only "
"works with the Tome of Resonance."

