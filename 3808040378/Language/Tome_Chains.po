msgid "THYRON_TOME_CHAINS@TOME@NAME"
msgstr "Tome of Chains"

msgid "THYRON_TOME_CHAINS@TOME@DESCRIPTION"
msgstr ""
"Strike fear into the hearts of your enemies by inflicting "
"{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} and reducing their "
"{GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "THYRON_TOME_CHAINS@TOME@LORE_DESCRIPTION"
msgstr ""
"\"Fear holds us. It freezes us, overwhelms us. It bars the greatest of "
"people from action. Like a stifling chain, it withers desires and brings a "
"cold, beautiful order. So wield now the chains of terror, so that your "
"ownership of these realms may be uncontested.\""

msgid "THYRON_TOME_CHAINS@TOME@AUTHOR_NAME"
msgstr "Ilvain, the Revenant Queen"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_01@NAME"
msgstr "Dungeon of Chains"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_01@DESCRIPTION"
msgstr ""
"+2 {GLOBAL.GoldConcept.Hyperlink}, +2 {GLOBAL.ManaConcept.Hyperlink} and +2 "
"{GLOBAL.CityStabilityConcept.Hyperlink} for each "
"{GLOBAL.HeroConcept.Hyperlink} in your {GLOBAL.PrisonConcept.Hyperlink}."

msgid "THYRON_TOME_CHAINS@TOME@SKILL_02@NAME"
msgstr "Imprisonment"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_02@DESCRIPTION"
msgstr ""
"Target enemy unit:[bulletlist][bullet/]Becomes "
"{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} until the end of combat."
"[bullet/]Loses {THYRON_IMPRISONMENT_MORALE_LOSS>Morale Change} "
"{GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_03@NAME"
msgstr "Oppressing Strikes"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_03@DESCRIPTION"
msgstr ""
"{GLOBAL.MeleeConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks "
"of enchanted units gain:[bulletlist][bullet/]+"
"{THYRON_OPPRESSING_STRIKES_EXTRA_DAMAGE>DAMAGE>Frost} "
"{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Inflict "
"{THYRON_OPPRESSING_STRIKES_CHANGE_MORALE>Morale Change} "
"{GLOBAL.UnitMoraleConcept.Hyperlink} loss.[bullet/]Deal +"
"{THYRON_OPPRESSING_STRIKES_DAMAGE>ResolvedMultiplier}% damage against "
"{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} targets and against units with "
"{GLOBAL.UnitMoraleConcept.Hyperlink} of \"Low\" or worse.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_03@UNIT_DESCRIPTION"
msgstr ""
"Unit's {GLOBAL.MeleeConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} "
"attacks have:[bulletlist][bullet/]+"
"{THYRON_OPPRESSING_STRIKES_EXTRA_DAMAGE>DAMAGE>Frost} "
"{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Inflict "
"{THYRON_OPPRESSING_STRIKES_CHANGE_MORALE>Morale Change} "
"{GLOBAL.UnitMoraleConcept.Hyperlink} loss.[bullet/]Deal +"
"{THYRON_OPPRESSING_STRIKES_DAMAGE>ResolvedMultiplier}% damage against "
"{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} targets and against units with "
"{GLOBAL.UnitMoraleConcept.Hyperlink} of \"Low\" or worse.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_04@NAME"
msgstr "Dark Surveillance"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_04@DESCRIPTION"
msgstr ""
"If cast on an enemy city, it loses:[bulletlist][bullet/]-20 "
"{GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]-2 "
"{GLOBAL.VisionRangeConcept.Hyperlink}.[/bulletlist][br/]If cast on a non-"
"hostile free city, it gains:[bulletlist][bullet/] +2 "
"{GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]If targeting a free city with "
"an owned {GLOBAL.DiplomaticTokenConcept.Hyperlink}, gain +2 "
"{GLOBAL.HouseInfluenceConcept.Hyperlink} per turn.[/bulletlist][br/]Not "
"considered a Hostile Action."

msgid "THYRON_TOME_CHAINS@TOME@SKILL_05@NAME"
msgstr "Summon Jailer"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_05@DESCRIPTION"
msgstr ""
"Summons a {GLOBAL.UNITS.THYRON_PRISON_GUARD.Hyperlink} onto the target world "
"hex. A Jailer is an oppressive {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} "
"that can inflict {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}."

msgid "THYRON_TOME_CHAINS@TOME@SKILL_05@UNIT_NAME"
msgstr "Jailer"

msgid "THYRON_TOME_CHAINS@TOME@UNIT_JAILER@ABILITY1@NAME"
msgstr "Stifling Chains"

msgid "THYRON_TOME_CHAINS@TOME@UNIT_JAILER@ABILITY1@DESCRIPTION"
msgstr ""
"Deal damage to target enemy unit. If hits, they are "
"{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} until the link is broken."
"[br/]Enter {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "THYRON_TOME_CHAINS@TOME@UNIT_JAILER@ABILITY2@NAME"
msgstr "Defense Mode: Intimidate"

msgid "THYRON_TOME_CHAINS@TOME@UNIT_JAILER@ABILITY2@DESCRIPTION"
msgstr ""
"This unit ends its turn and goes into a defensive mode:[bulletlist]"
"[bullet/]Extends its {GLOBAL.ZoneOfControlConcept.Hyperlink} to all adjacent "
"hexes.[bullet/]Gains +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Armor} "
"{GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Gains +"
"{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Resistance} "
"{GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Immune to "
"{GLOBAL.FlankingConcept.Hyperlink}.[bullet/]All adjacent friendly units gain "
"+{SHIELD_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}."
"[bullet/]All adjacent enemy units lose "
"{THYRON_INTIMIDATE_CHANGE_MORALE>Morale Change} "
"{GLOBAL.UnitMoraleConcept.Hyperlink} and have a base "
"{WEAKENED_RESISTANCE>ResolvedStrength}% chance of becoming "
"{GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_CHAINS@TOME@UNIT_JAILER@ABILITY2@META"
msgstr "{GLOBAL.DEFENSES.THYRON_INTIMIDATE.Hyperlink}"

msgid "THYRON_TOME_CHAINS@TOME@UNIT_JAILER@ABILITY2@META@DESCRIPTION"
msgstr ""
"This unit ends its turn and goes into a defensive mode:[bulletlist]"
"[bullet/]Extends its {GLOBAL.ZoneOfControlConcept.Hyperlink} to all adjacent "
"hexes.[bullet/]Gains +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Armor} "
"{GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Gains +"
"{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Resistance} "
"{GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Immune to "
"{GLOBAL.FlankingConcept.Hyperlink}.[bullet/]All adjacent friendly units gain "
"+{SHIELD_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}."
"[bullet/]All adjacent enemy units lose "
"{THYRON_INTIMIDATE_CHANGE_MORALE>Morale Change} "
"{GLOBAL.UnitMoraleConcept.Hyperlink} and have a base "
"{WEAKENED_RESISTANCE>ResolvedStrength}% chance of becoming "
"{GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_CHAINS@TOME@SKILL_01@MODIFIER@NAME"
msgstr ""

msgid "THYRON_TOME_CHAINS@TOME@SKILL_01@MODIFIER@DESCRIPTION"
msgstr ""

msgid "THYRON_TOME_CHAINS@TOME@IMPROVEMENT@NAME"
msgstr "[conduit/] Overseer's Spire"

msgid "THYRON_TOME_CHAINS@TOME@IMPROVEMENT@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+5 {GLOBAL.GoldConcept.Hyperlink} and +5 "
"{GLOBAL.ManaConcept.Hyperlink}.[bullet/]+5 {GLOBAL.GoldConcept.Hyperlink} "
"per level of [hyperlink,GLOBAL.AlignmentConcept]Good[/hyperlink] [goodact/] "
"alignment.[bullet/]+5 {GLOBAL.ManaConcept.Hyperlink} per level of "
"[hyperlink,GLOBAL.AlignmentConcept]Evil[/hyperlink] [evilact/] alignment."
"[bullet/]+2 {GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]Allows drafting "
"of Jailer.[bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink}.[/"
"bulletlist]"

