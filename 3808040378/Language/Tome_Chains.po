msgid "THYRON_TOME_CHAINS@ASCENSION_TRAIT@NAME"
msgstr "Ascension: Chain Lord"

msgid "THYRON_TOME_CHAINS@ASCENSION_TRAIT@ABILITY_NAME"
msgstr "Ascended Chain Lord"

msgid "THYRON_TOME_CHAINS@ASCENSION_TRAIT@DESCRIPTION"
msgstr ""
"Inflicts {THYRON_STIFLING_CHAINS_HERO_CHANGE_MORALE>Morale Change} "
"{GLOBAL.UnitMoraleConcept.Hyperlink} loss."
