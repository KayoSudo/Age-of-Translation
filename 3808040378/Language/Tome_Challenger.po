msgid "THYRON_TOME_CHALLENGER@TOME@NAME"
msgstr "Tome of the Challenger"

msgid "THYRON_TOME_CHALLENGER@TOME@DESCRIPTION"
msgstr ""
"[hyperlink,GLOBAL.PROPERTIES.THYRON_CHALLENGED]Challenge[/hyperlink] your "
"enemies to a fair fight, and gain blessings for proving yourself worthy in "
"battle."

msgid "THYRON_TOME_CHALLENGER@TOME@LORE_DESCRIPTION"
msgstr ""
"\"You have long oppressed my people, stolen my wheat and killed my children. "
"So, now I have become the Nemesis for you, the Desolator. I dare you to step "
"forward! To prove that you are not a coward, hiding behind wards and "
"minions. To prove that you... still have a soul!\""

msgid "THYRON_TOME_CHALLENGER@TOME@AUTHOR_NAME"
msgstr "Sarik the Avenger, Infamous Gladiator"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_01@NAME"
msgstr "Rule of Two"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_01@DESCRIPTION"
msgstr ""
"When fighting alongside your alive {GLOBAL.LeaderConcept.Hyperlink}, your "
"heroes gain:[bulletlist][bullet/]+"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>HitPoints} <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>DEFENSE>Armor} "
"{GLOBAL.DefenseConcept.Hyperlink} and +"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>DEFENSE>Resistance} "
"{GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]+"
"{THYRON_RULE_OF_TWO_DAMAGE_BONUS>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} on attacks.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_01@UNIT_DESCRIPTION"
msgstr ""
"Other <<m:{GLOBAL.HeroConcept.Hyperlink}>> fighting alongside this "
"{GLOBAL.LeaderConcept.Hyperlink} have:[bulletlist][bullet/]+"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>HitPoints} <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>DEFENSE>Armor} "
"{GLOBAL.DefenseConcept.Hyperlink} and +"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>DEFENSE>Resistance} "
"{GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]+"
"{THYRON_RULE_OF_TWO_DAMAGE_BONUS>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} on attacks.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_01@BUFF_DESCRIPTION"
msgstr ""
"This unit has:[bulletlist][bullet/]+"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>HitPoints} <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>DEFENSE>Armor} "
"{GLOBAL.DefenseConcept.Hyperlink} and +"
"{THYRON_RULE_OF_TWO_STAT_BONUS>BONUS>DEFENSE>Resistance} "
"{GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]+"
"{THYRON_RULE_OF_TWO_DAMAGE_BONUS>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} on attacks.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_01@XP@DESCRIPTION"
msgstr ""
"Your {GLOBAL.LeaderConcept.Hyperlink} gains:[bulletlist][bullet/]While army "
"leader, other <<m:{GLOBAL.HeroConcept.Hyperlink}>> in the army gain +10 "
"{GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} "
"{GLOBAL.TurnConcept}.[/bulletlist]"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_01@XP@RULER_DESCRIPTION"
msgstr ""
"While army leader, other <<m:{GLOBAL.HeroConcept.Hyperlink}>> in the army "
"gain +{THYRON_RULE_OF_TWO_XP_PER_TURN>XP} "
"{GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} "
"{GLOBAL.TurnConcept}."

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_01@XP@HERO_DESCRIPTION"
msgstr ""
"Unit gains +{THYRON_RULE_OF_TWO_XP_PER_TURN>XP} "
"{GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} "
"{GLOBAL.TurnConcept}."

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_02@NAME"
msgstr "Call to Challenge"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_02@DESCRIPTION"
msgstr ""
"Target enemy unit:[bulletlist][bullet/]Sustains "
"{THYRON_CALL_TO_CHALLENGE_SPELL_DAMAGE>DAMAGE>Spirit} "
"{GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Becomes "
"{GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} until the end of combat.[/"
"bulletlist]"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_03@NAME"
msgstr "Worthy Challenger"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_03@DESCRIPTION"
msgstr ""
"All attacks of enchanted units gain:[bulletlist][bullet/]+"
"{THYRON_WORTHY_CHALLENGER_EXTRA_DAMAGE_CHALLENGED>ResolvedMultipl}% damage "
"against {GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} units.[/bulletlist]"
"[br/][hyperlink,GLOBAL.EnchantingNonRepeatingConcept]Single Shot[/hyperlink] "
"attacks of enchanted units gain:[bulletlist][bullet/]+"
"{THYRON_WORTHY_CHALLENGER_COUNTING_TIER_DAMAGE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} for each Unit Tier of the target.[/"
"bulletlist]"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_03@UNIT_DESCRIPTION"
msgstr ""
"Unit's attacks deal:[bulletlist][bullet/]+"
"{THYRON_WORTHY_CHALLENGER_EXTRA_DAMAGE_CHALLENGED>ResolvedMultipl}% damage "
"against {GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} units.[bullet/]If "
"[hyperlink,GLOBAL.EnchantingNonRepeatingConcept]Single Shot[/hyperlink]: +"
"{THYRON_WORTHY_CHALLENGER_COUNTING_TIER_DAMAGE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} for each Unit Tier of the target.[/"
"bulletlist]"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_03@MODIFIER_DESCRIPTION"
msgstr ""
"+{THYRON_WORTHY_CHALLENGER_COUNTING_TIER_DAMAGE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} for each Unit Tier of the target."

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_04@NAME"
msgstr "Gladiator"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_04@DESCRIPTION"
msgstr ""
"Strong and {GLOBAL.PROPERTIES.EXPENDABLE.Hyperlink} "
"{GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} that can "
"[hyperlink,GLOBAL.PROPERTIES.THYRON_CHALLENGED]Challenge[/hyperlink] his "
"foes."

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_05@NAME"
msgstr "Declare Nemesis"

msgid "THYRON_TOME_CHALLENGER@TOME@SKILL_05@DESCRIPTION"
msgstr ""
"All <<m:{GLOBAL.UnitConcept.Hyperlink}>> in target enemy army:[bulletlist]"
"[bullet/]Become {GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} for 1 "
"{GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}.[/"
"bulletlist]"

msgid "THYRON_TOME_CHALLENGER@TOME@UNIT_GLADIATOR@ABILITY1@NAME"
msgstr "Answer the Bell"

msgid "THYRON_TOME_CHALLENGER@TOME@UNIT_GLADIATOR@ABILITY1@DESCRIPTION"
msgstr ""
"Jump onto the target {GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} enemy "
"unit, knocking them back, then gain:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.BERSERK.Hyperlink} for 1 {GLOBAL.TurnConcept.Hyperlink}."
"[bullet/]{GLOBAL.PROPERTIES.FORTUNE.Hyperlink} for 3 <<m:"
"{GLOBAL.TurnConcept.Hyperlink}>>.[/bulletlist]"

msgid "THYRON_TOME_CHALLENGER@TOME@UNIT_GLADIATOR@ABILITY2@NAME"
msgstr "Armor of Audacity"

msgid "THYRON_TOME_CHALLENGER@TOME@UNIT_GLADIATOR@ABILITY2@DESCRIPTION"
msgstr ""
"Unit has +{THYRON_ARMOR_OF_AUDACITY_DEFENSE>DEF_MOD>Armor} "
"{GLOBAL.DefenseConcept.Hyperlink} and  +"
"{THYRON_ARMOR_OF_AUDACITY_DEFENSE>DEF_MOD>Resistance} "
"{GLOBAL.ResistanceConcept.Hyperlink} against the attacks of "
"{GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} units."

msgid "THYRON_TOME_CHALLENGER@TOME@IMPROVEMENT@NAME"
msgstr "Hall of the Practice"

msgid "THYRON_TOME_CHALLENGER@TOME@IMPROVEMENT@DESCRIPTION"
msgstr ""

msgid "THYRON_TOME_CHALLENGER@STATUS_EFFECT@CHALLENGED@NAME"
msgstr "Challenged"

msgid "THYRON_TOME_CHALLENGER@STATUS_EFFECT@CHALLENGED@DESCRIPTION"
msgstr ""
"Unit has:[bulletlist][bullet/]"
"{THYRON_CHALLENGED_TACTICAL_MOVE_POINT_MODIFIER>PointBonus} "
"{GLOBAL.CombatSpeedConcept.Hyperlink}.[bullet/]+100% chance of dying when "
"{GLOBAL.RetreatingConcept.Hyperlink}.[bullet/]On death, another random "
"adjacent enemy unit becomes {GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink}."
"[/bulletlist][br/]Can't affect <<m:"
"{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>."

msgid "THYRON_TOME_CHALLENGER@STATUS_EFFECT@CHALLENGED@MODIFIER_DESC"
msgstr ""
"Base {THYRON_CHALLENGED_RESISTANCE>ResolvedStrength}% chance of inflicting "
"{GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink}."

msgid "THYRON_TOME_CHALLENGER@ASCENSION_TRAIT@NAME"
msgstr "Ascension: Tournament Begins"

msgid "THYRON_TOME_CHALLENGER@ASCENSION_TRAIT@ABILITY_NAME"
msgstr "Tournament Begins"

msgid "THYRON_TOME_CHALLENGER@ASCENSION_TRAIT@DESCRIPTION"
msgstr ""
"At the start of combat:[bulletlist][bullet/]Summon a "
"{GLOBAL.UNITS.THYRON_GLADIATOR.Hyperlink} unit.[bullet/]All enemy units "
"become {GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_CHALLENGER@PASSIVE_UNIT_PROPERTY@NAME"
msgstr "Combat Duelists"

msgid "THYRON_TOME_CHALLENGER@PASSIVE_UNIT_PROPERTY@NAME_SINGULAR"
msgstr "Combat Duelist"

msgid "THYRON_TOME_CHALLENGER@PASSIVE_UNIT_PROPERTY@DESCRIPTION"
msgstr ""
"Your <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain benefits from killing "
"{GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} enemies, depending on their "
"Unit Tier:[bulletlist][bullet/]+1 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} "
"and heal 5 <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if lower "
"[hyperlink,GLOBAL.UnitTierConcept]tier[/hyperlink].[bullet/]+2 "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and heal 10 <<m:"
"{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if equal "
"[hyperlink,GLOBAL.UnitTierConcept]tier[/hyperlink].[bullet/]+3 "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and heal 15 <<m:"
"{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if higher "
"[hyperlink,GLOBAL.UnitTierConcept]tier[/hyperlink].[/bulletlist]"

msgid "THYRON_TOME_CHALLENGER@PASSIVE_UNIT_PROPERTY@UNIT_DESCRIPTION"
msgstr ""
"This {GLOBAL.UnitConcept.Hyperlink} gains benefits from killing "
"{GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} enemies, depending on their "
"Unit Tier:[bulletlist][bullet/]+1 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} "
"and heal {THYRON_CHALLENGER_DUELIST_HEAL>NumHitpointsToRestore} <<m:"
"{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if lower "
"[hyperlink,GLOBAL.UnitTierConcept]tier[/hyperlink].[bullet/]+2 "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and heal 10 <<m:"
"{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if equal "
"[hyperlink,GLOBAL.UnitTierConcept]tier[/hyperlink].[bullet/]+3 "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and heal "
"{THYRON_CHALLENGER_DUELIST_HEAL_2>NumHitpointsToRestore} <<m:"
"{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if higher "
"[hyperlink,GLOBAL.UnitTierConcept]tier[/hyperlink] or "
"{GLOBAL.HeroConcept.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_CHALLENGER@PASSIVE_UNIT_PROPERTY@HERO_DESCRIPTION"
msgstr ""
"This {GLOBAL.HeroConcept.Hyperlink} gains benefits from killing "
"{GLOBAL.PROPERTIES.THYRON_CHALLENGED.Hyperlink} enemies, depending on their "
"unit type:[bulletlist][bullet/]+1 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} "
"and heal {THYRON_CHALLENGER_DUELIST_HEAL>NumHitpointsToRestore} <<m:"
"{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if non-"
"{GLOBAL.HeroConcept.Hyperlink}.[bullet/]+3 "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and heal "
"{THYRON_CHALLENGER_DUELIST_HEAL_2>NumHitpointsToRestore} <<m:"
"{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> if a "
"{GLOBAL.HeroConcept.Hyperlink}.[/bulletlist]"
