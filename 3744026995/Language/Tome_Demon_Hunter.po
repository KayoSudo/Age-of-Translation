msgid "THYRON_TOME_DEMON_HUNTER@TOME@NAME"
msgstr "Tome of Demon Hunters"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@DESCRIPTION"
msgstr ""
"Take up a crusade against darkness, and empower your units with overwhelming "
"firepower and {GLOBAL.SpiritDamageConcept.Hyperlink}. The time for mercy has "
"ended."

msgid "THYRON_TOME_DEMON_HUNTER@TOME@LORE_DESCRIPTION"
msgstr ""
"\"And they went forth with fire and iron, to cast down the unclean and make "
"desolate the works of the abyss.\""

msgid "THYRON_TOME_DEMON_HUNTER@TOME@AUTHOR_NAME"
msgstr "Constantius Clarius, Chronicler of the High Inquisition"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_01@NAME"
msgstr "Guns of Atonement"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_01@DESCRIPTION"
msgstr ""
"{GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks "
"of enchanted units gain:[bulletlist][bullet/]+2 "
"{GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Base "
"{THYRON_EXPOSED_BY_LIGHT_RESISTANCE>ResolvedStrength}% chance of inflicting "
"{GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for "
"{THYRON_EXPOSED_BY_LIGHT_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_02@NAME"
msgstr "Demon Slayer"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_02@DESCRIPTION"
msgstr ""
"A powerful racial {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} that  wields "
"dual Magelocks."

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_02@MODIFIER_DESCRIPTION"
msgstr ""
"Unit's {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} "
"attacks have:[bulletlist][bullet/]+2 {GLOBAL.SpiritDamageConcept.Hyperlink}."
"[bullet/]Base {THYRON_EXPOSED_BY_LIGHT_RESISTANCE>ResolvedStrength}% chance "
"of inflicting {GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for "
"{THYRON_EXPOSED_BY_LIGHT_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_03@NAME"
msgstr "Honor-Forged"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_03@DESCRIPTION"
msgstr ""
"Makes the target race shielded by a divine calling, granting them:"
"[bulletlist][bullet/]+1 {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]+1 "
"{GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]+1 "
"{GLOBAL.BlightResistanceConcept.Hyperlink}.[bullet/]When this unit's <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>> drop below 60%:[bulletlist]"
"[bullet/]Enemies within a 2-hex radius become "
"{GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for 3 <<m:"
"{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_03@MODIFIER_DESCRIPTION"
msgstr ""
"Unit has:[bulletlist][bullet/]+1 {GLOBAL.FireResistanceConcept.Hyperlink}."
"[bullet/]+1 {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]+1 "
"{GLOBAL.BlightResistanceConcept.Hyperlink}.[bullet/]When this unit's <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>> drop below 60%:[bulletlist]"
"[bullet/]Enemies within a 2-hex radius become "
"{GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for 3 <<m:"
"{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_04@NAME"
msgstr "Desolating Barrage"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_04@DESCRIPTION"
msgstr ""
"Enemy units in a 2-hex radius:[bulletlist][bullet/]Sustain "
"{THYRON_SLAYER_DESOLATING_BARRAGE_UNIT_DAMAGE>DAMAGE>Spirit} "
"{GLOBAL.SpiritDamageConcept.Hyperlink} and "
"{THYRON_SLAYER_DESOLATING_BARRAGE_UNIT_DAMAGE>DAMAGE>Physical} "
"{GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Become "
"{GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for "
"{THYRON_EXPOSED_BY_LIGHT_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_05@NAME"
msgstr "Permanent Vigilance"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_05@DESCRIPTION"
msgstr ""
"Target leader of an army gains "
"{GLOBAL.PROPERTIES.THYRON_PERMANENT_VIGILANCE_AUTO_SPELL.Hyperlink} for 3 "
"{GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>>, giving all "
"friendly non-melee units {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink} and "
"{GLOBAL.PROPERTIES.THYRON_SHROUDED_FROM_DARK.Hyperlink} at the start of "
"combat for the duration."

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_05@PROP_DESCRIPTION"
msgstr ""
"Give all friendly non-melee units {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink} "
"and {GLOBAL.PROPERTIES.THYRON_SHROUDED_FROM_DARK.Hyperlink} on combat start."

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_06@NAME"
msgstr ""

msgid "THYRON_TOME_DEMON_HUNTER@TOME@SKILL_06@DESCRIPTION"
msgstr ""

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@ABILITY1@NAME"
msgstr "Fire Twin Magelocks"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@ABILITY1@DESCRIPTION"
msgstr "Fire Magelock Pistols at target unit."

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@ABILITY2@NAME"
msgstr "Banishing Shot"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@ABILITY2@DESCRIPTION"
msgstr ""
"Fire a devastating {GLOBAL.MagicConcept.Hyperlink} barrage at target unit "
"and knock it 2 hexes away."

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@ABILITY3@NAME"
msgstr "Judgment Mark"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@ABILITY3@DESCRIPTION"
msgstr ""
"Target unit gains:[bulletlist][bullet/]3 "
"{GLOBAL.PROPERTIES.MARKED.Hyperlink}.[bullet/]"
"{GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@PASSIVE1@NAME"
msgstr ""

msgid "THYRON_TOME_DEMON_HUNTER@TOME@UNIT_MYTHIC_T5@PASSIVE1@DESCRIPTION"
msgstr ""

msgid "THYRON_TOME_DEMON_HUNTER@TOME@IMPROVEMENT@NAME"
msgstr "Hall of Repentance"

msgid "THYRON_TOME_DEMON_HUNTER@TOME@IMPROVEMENT@DESCRIPTION"
msgstr ""

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@PURGED@NAME"
msgstr "Exposed by Light"

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@PURGED@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]-1 {GLOBAL.SpiritResistanceConcept.Hyperlink}."
"[bullet/]Stacks up to 4 times.[/bulletlist][br/][br/]Exposed by Light "
"{GLOBAL.OpposingStatusEffectsConcept.Hyperlink} "
"{GLOBAL.PROPERTIES.THYRON_SHROUDED_FROM_DARK.Hyperlink}."

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@PURGED@MODIFIER_DESCRIPTION"
msgstr ""
"Base {THYRON_EXPOSED_BY_LIGHT_RESISTANCE>ResolvedStrength}% chance of "
"inflicting {GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for "
"{THYRON_EXPOSED_BY_LIGHT_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>."

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@PURGED@MODIFIER_GUARANTEED"
msgstr ""
"Inflict {GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for "
"{THYRON_EXPOSED_BY_LIGHT_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>."

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@PURGED@MODIFIER_GUARANTEED_2"
msgstr ""
"Inflict 2x {GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for "
"{THYRON_EXPOSED_BY_LIGHT_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>."

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@ANTIPURGED@NAME"
msgstr "Shrouded from Dark"

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@ANTIPURGED@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+1 {GLOBAL.FrostResistanceConcept.Hyperlink}."
"[bullet/]Stacks up to 4 times.[/bulletlist][br/][br/]Shrouded from Dark "
"{GLOBAL.OpposingStatusEffectsConcept.Hyperlink} "
"{GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink}."

msgid "THYRON_TOME_DEMON_HUNTER@STATUS_EFFECT@ANTIPURGED@MODIFIER_DESCRIPTION"
msgstr ""
"Base {THYRON_SHROUDED_FROM_DARK_RESISTANCE>ResolvedStrength}% chance of "
"applying {GLOBAL.PROPERTIES.THYRON_SHROUDED_FROM_DARK.Hyperlink} for "
"{THYRON_SHROUDED_FROM_DARK_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>."

msgid "THYRON_TOME_DEMON_HUNTER@ASCENSION_TRAIT@NAME"
msgstr "Ascension: Demon Hunter"

msgid "THYRON_TOME_DEMON_HUNTER@ASCENSION_TRAIT@PASSIVE@NAME"
msgstr "Ascended Demonslayer"

msgid "THYRON_TOME_DEMON_HUNTER@ASCENSION_TRAIT@PASSIVE@DESCRIPTION"
msgstr ""
"This hero gains:[bulletlist][bullet/]+"
"{THYRON_DEMON_HUNTER_ASCENSION_HERO_DAMAGE>DAMAGE>Spirit} "
"{GLOBAL.SpiritDamageConcept.Hyperlink} on all attacks.[bullet/]Attacks "
"inflict {GLOBAL.PROPERTIES.THYRON_EXPOSED_BY_LIGHT.Hyperlink} for "
"{THYRON_EXPOSED_BY_LIGHT_EFFECT_DESCRIPTION>NumTurns} <<m:"
"{GLOBAL.TurnConcept}>>.[bullet/]+"
"{THYRON_DEMON_HUNTER_ASCENSION_HERO_PROPERTY_DEFENSE>BONUS>REDUCT} "
"{GLOBAL.FireResistanceConcept.Hyperlink}, "
"{GLOBAL.FrostResistanceConcept.Hyperlink} and "
"{GLOBAL.BlightResistanceConcept.Hyperlink}.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"
