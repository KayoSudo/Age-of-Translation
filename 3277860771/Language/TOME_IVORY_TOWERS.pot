msgid "TOME_IVORY@NOBLE@GIFT@NAME"
msgstr "Ivoric Gift"

msgid "TOME_IVORY@NOBLE@GIFT@DESC"
msgstr ""
" Invert all negative effects of the unit and then heal it by 8 {GLOBAL."
"TemporaryHitPointConcept.Hyperlink} for each positive effect granted. "

msgid "TOME_IVORY@NOBLE@EXTRACT@NAME"
msgstr "Ivoric Extract"

msgid "TOME_IVORY@NOBLE@EXTRACT@DESC"
msgstr ""
"Inflict damage to an enemy unit. Remove all positive effects and inflict 2x "
"{GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}, {GLOBAL.PROPERTIES."
"SUNDERED_RESISTANCE.Hyperlink} , and {GLOBAL.PROPERTIES.WEAKENED."
"Hyperlink}, then heal self by 20 {GLOBAL.TemporaryHitPointConcept."
"Hyperlink}."

msgid "TOME_IVORY@NOBLE@THRALLS@NAME"
msgstr "Calling of the Thralls"

msgid "TOME_IVORY@NOBLE@THRALLS@DESC"
msgstr ""
"Gain one of the following abilities:[bulletlist][bullet/]{GLOBAL.PROPERTIES."
"ARCHONS_SMITE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.WAIL_OF_THE_BANSHEE."
"Hyperlink}[bullet/]{GLOBAL.PROPERTIES.PHASE.Hyperlink}[bullet/]{GLOBAL."
"PROPERTIES.INSPIRING_KILLER.Hyperlink}"

