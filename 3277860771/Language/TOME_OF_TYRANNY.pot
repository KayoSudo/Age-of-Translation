msgid "TOME_TYRANNY@TOME@NAME"
msgstr "Tome of the Death Knight"

msgid "TOME_TYRANNY@TOME@LORE_DESCRIPTION"
msgstr "\"I am The Ancient, I am The Land. My beginnings are lost in the darkness of the past. I was the warrior, I was good and just. I thundered across the land like the wrath of a just god, but the war years and the killing years wore down my soul as the wind wears stone into sand.\""

msgid "TOME_TYRANNY@TOME@LORE_AUTHOR"
msgstr "Strahd von Zarovich"

msgid "TOME_TYRANNY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "The weak were meant to serve the strong, and you will make them. Make use of those you have conquered to feed your dark rituals, drain their {GLOBAL.UnitMoraleConcept.Hyperlink}, and take what is rightfully yours."

msgid "TOME_TYRANNY@SKILL_1@NAME"
msgstr "Summon Wraith Knight"

msgid "TOME_TYRANNY@SKILL_1@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.WRAITH_TYRANT_GHOST.Hyperlink} to target hex. A unit specializing in hunting down nonbelievers and reducing their {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_TYRANNY@UNIT1@ABILITY1@NAME"
msgstr "Mind-Rot Breath"

msgid "TOME_TYRANNY@SKILL_2@NAME"
msgstr "Death Knight Armor"

msgid "TOME_TYRANNY@SKILL_2@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HOPELESSNESS.Hyperlink}"

msgid "TOME_TYRANNY@SKILL_3@NAME"
msgstr "Obliterating"

msgid "TOME_TYRANNY@SKILL_3@DESCRIPTION"
msgstr "Same as killing the unit, but the unit cannot be resurrected or resurged afterwards."

msgid "TOME_TYRANNY@SKILL_4@NAME"
msgstr "Sacrifice Dissidents"

msgid "TOME_TYRANNY@SKILL_4@DESCRIPTION"
msgstr "Units recruited through {GLOBAL.RequestMilitaryAidConcept.Hyperlink} from the target {GLOBAL.PvEVassalConcept.Hyperlink} are {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[br/]Target Vassal city grants the player +5 {GLOBAL.SoulConcept.Hyperlink} each {GLOBAL.TurnConcept}."

msgid "TOME_TYRANNY@SKILL_5@NAME"
msgstr "Serve the Greater Will"

msgid "TOME_TYRANNY@SKILL_5@DESCRIPTION"
msgstr "Target friendly unit's life force is expunged, {GLOBAL.PROPERTIES.VECTRA_OBLITERATE.Hyperlink} them, and then, in a 2-hex radius:[bulletlist][bullet/]Inflict 2 {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} and {GLOBAL.PROPERTIES.DESPAIRING.Hyperlink} to enemies[bullet/]Grant {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} and {GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink} to friendly units.[bullet/]If a friendly unit already has {GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}, remove 2 negative status effects instead of granting {GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}."

msgid "TOME_TYRANNY@SKILL_6@NAME"
msgstr "Confessor's Quarters"

msgid "TOME_TYRANNY@SKILL_6@DESCRIPTION"
msgstr ""
"+4 {GLOBAL.KnowledgeConcept.Hyperlink} per Confessor's Quarters built in your Empire.\n"
"For each {GLOBAL.CityStabilityConcept.Hyperlink} level above neutral the city gains:[bulletlist] [bullet/]+5 {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]+5 {GLOBAL.ManaConcept.Hyperlink}.[/bulletlist][br/]For each {GLOBAL.CityStabilityConcept.Hyperlink} level below neutral the city gains:[bulletlist][bullet/]+5 {GLOBAL.GoldConcept.Hyperlink}.[bullet/]+5 {GLOBAL.UnitProductionConcept.Hyperlink}."

msgid "TOME_TYRANNY@HERO_SKILL@NAME"
msgstr "Death Knight Armor"

msgid "TOME_TYRANNY@HERO_SKILL@DESCRIPTION"
msgstr "Grants your leader:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HOPELESSNESS.Hyperlink}"

msgid "TOME_TYRANNY@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[researchpost/] Oppressor's Bastion"

msgid "TOME_TYRANNY@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+5 <<m:{GLOBAL.SoulConcept.Hyperlink}>>.[bullet/]-10 {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]{amount} {GLOBAL.KnowledgeConcept.Hyperlink} per adjacent {GLOBAL.ResearchPostConcept.Hyperlink} or {GLOBAL.ConduitConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TYRANNY@UNIT1@NAME"
msgstr "Wraith Knight"

msgid "TOME_TYRANNY@UNIT1@DESCRIPTION"
msgstr "An undead, etheral unit specializing in hunting down nonbelievers and reducing their {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_TYRANNY@MORALE_REFLECT@DESCRIPTION"
msgstr "Melee attackers lose {morale} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_TYRANNY@MORALE_REFLECT@NAME"
msgstr "Death Knight Armor"

msgid "TOME_TYRANNY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Attacks all units in a 3-hex cone."

