msgid "THYRON_TOME_FRACTURE@TOME@NAME"
msgstr "Tome of the Fracturing"

msgid "THYRON_TOME_FRACTURE@TOME@DESCRIPTION"
msgstr ""
"Summon {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} monsters and crush your "
"enemies with the desolations of {GLOBAL.AstralBarrensConcept.Hyperlink}."

msgid "THYRON_TOME_FRACTURE@TOME@LORE_DESCRIPTION"
msgstr ""
"The -\\ e-ra-s-ed \\- are coming. Nothing escapes them -\\ us \\-. HATE "
"MAGIC. Do not let magic prosper against them -\\ u s\\-, -\\ e-ra-s-ed \\- "
"ABSORB. DEVASTATE. DISINTEGRATE. NOTHING LEFT. -\\ e-ra-s-ed \\-"

msgid "THYRON_TOME_FRACTURE@TOME@AUTHOR_NAME"
msgstr "Bdzzhk Drzzh, -\\ TITLE e--ra--s--ed \\-"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_01@NAME"
msgstr "Summon Fractured Creatures"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_01@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]Choose a Tier III, Tier IV or Tier V "
"{GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} unit to add to your army."
"[bullet/]If cast on {GLOBAL.AstralBarrensConcept.Hyperlink} terrain, the "
"chance of obtaining a {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} or "
"{GLOBAL.UNITS.FRACTURED_WORM.Hyperlink} improves.[/bulletlist]"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_01@DIALOG_SUBHEADER_NORMAL"
msgstr ""
"Several fractured creatures emerge from the surroundings, hungry for more "
"mana."

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_01@DIALOG_SUBHEADER_BARRENS"
msgstr ""
"Several fractured denizens emerge from the barrens, ready to kill and "
"devastate."

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_02@NAME"
msgstr "Violent Fracturing"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_02@DESCRIPTION"
msgstr ""
"Target {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Enemy <<m:"
"{GLOBAL.UnitConcept.Hyperlink}>> sustain 25 "
"{GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist][br/]Target "
"{GLOBAL.ProvinceConcept.Hyperlink} and adjacent Provinces:[bulletlist]"
"[bullet/]Gain {GLOBAL.AstralBarrensConcept.Hyperlink}.[bullet/]Lose "
"{GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, "
"{GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, "
"{GLOBAL.FrozenWasteConcept.Hyperlink}, "
"{GLOBAL.CavernFloorConcept.Hyperlink}, and "
"{GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Spawn a "
"{GLOBAL.STRUCTURES.FLEETING_FRACTURED_INFESTATION.Hyperlink} where possible."
"[/bulletlist]"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_03@NAME"
msgstr "Rift Marks"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_03@DESCRIPTION"
msgstr ""
"Unit has:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.THYRON_BARREN_TOUCH.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_03@SPELL@DESCRIPTION"
msgstr ""
"Enchanted units gain:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.THYRON_BARREN_TOUCH.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_03@ABILITY@NAME"
msgstr "Barren Touch"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_03@ABILITY@DESCRIPTION"
msgstr ""
"If targeting an enemy unit:[bulletlist][bullet/]Inflict "
"{GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} for 1 "
"{GLOBAL.TurnConcept.Hyperlink}.[/bulletlist][br/]If targeting a friendly "
"unit:[bulletlist][bullet/]Remove a random "
"{GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[/bulletlist]"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_04@NAME"
msgstr "Reap Magic"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_04@DESCRIPTION"
msgstr ""
"Enemy units in a {THYRON_REAP_MAGIC_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex "
"radius:[bulletlist][bullet/]Sustain "
"{THYRON_REAP_MAGIC_UNIT_DAMAGE>DAMAGE>Fire} "
"{GLOBAL.FireDamageConcept.Hyperlink} and "
"{THYRON_REAP_MAGIC_UNIT_DAMAGE>DAMAGE>Shock} "
"{GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Become "
"{GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} for 1 "
"{GLOBAL.TurnConcept.Hyperlink}.[bullet/]Place random Astral Fracture "
"obstacles in the area.[/bulletlist][br/]This spell can't "
"[hyperlink,GLOBAL.BackfireConcept]backfire[/hyperlink]."

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_05@NAME"
msgstr "Fragmented Rage"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_05@DESCRIPTION"
msgstr ""
"Fractured units and units with the Fractured Transformation under your "
"control gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}.[/"
"bulletlist]"

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_06@NAME"
msgstr ""

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_06@DESCRIPTION"
msgstr ""

msgid "THYRON_TOME_FRACTURE@TOME@SKILL_06@UNIT_PROPERTY_DESCRIPTION"
msgstr ""

msgid "THYRON_TOME_FRACTURE@TOME@PASSIVE@NAME"
msgstr "Barren Endurance"

msgid "THYRON_TOME_FRACTURE@TOME@PASSIVE@DESCRIPTION"
msgstr ""
"Non-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} units on "
"{GLOBAL.AstralBarrensConcept.Hyperlink} terrain "
"[hyperlink,GLOBAL.WorldMapRegeneration]regenerate[/hyperlink] an additional "
"10 <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per "
"{GLOBAL.TurnConcept.Hyperlink}."

msgid "THYRON_TOME_FRACTURE@TOME@PASSIVE@PROPERTY@NAME"
msgstr "Barren Endurance"

msgid "THYRON_TOME_FRACTURE@TOME@PASSIVE@PROPERTY@DESCRIPTION"
msgstr ""
"Unit [hyperlink,GLOBAL.WorldMapRegeneration]regenerates[/hyperlink] +"
"{THYRON_BARREN_HEALING_REGEN_PROP>BONUS>Regen} <<m:"
"{GLOBAL.HitPointConcept.Hyperlink}>> per {GLOBAL.TurnConcept.Hyperlink} on "
"{GLOBAL.AstralBarrensConcept.Hyperlink} terrain."

msgid "THYRON_TOME_FRACTURE@TOME@PASSIVE2@NAME"
msgstr "Astral Barrens Preference"

msgid "THYRON_TOME_FRACTURE@TOME@PASSIVE2@DESCRIPTION"
msgstr ""
"<<m: {GLOBAL.ProvinceConcept.Hyperlink}>> with "
"{GLOBAL.AstralBarrensConcept.Hyperlink} give +2 "
"{GLOBAL.GoldConcept.Hyperlink} and +2 "
"{GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "THYRON_TOME_FRACTURE@ASCENSION_TRAIT@NAME"
msgstr "Ascension: Fracturing"

msgid "THYRON_TOME_FRACTURE@ASCENSION_TRAIT@PASSIVE_NAME"
msgstr "Ascended Fracturer"

msgid "THYRON_TOME_FRACTURE@ASCENSION_TRAIT@ABILITY_NAME"
msgstr "Ascended Barren Touch"

msgid "THYRON_TOME_FRACTURE@ASCENSION_TRAIT@DESCRIPTION"
msgstr ""
"If targeting an enemy unit:[bulletlist][bullet/]Inflict "
"{GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} for 1 "
"{GLOBAL.TurnConcept.Hyperlink}.[/bulletlist][br/]If targeting a friendly "
"unit:[bulletlist][bullet/]Remove a random "
"{GLOBAL.NegativeStatusEffectConcept.Hyperlink} and give its "
"[hyperlink,GLOBAL.PositiveStatusEffectConcept]positive[/hyperlink] "
"[hyperlink,GLOBAL.OpposingStatusEffectsConcept]counter[/hyperlink].[/"
"bulletlist]"
