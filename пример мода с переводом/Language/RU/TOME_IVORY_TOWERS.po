msgstr "Терновые доспехи"

msgid "TOME_IVORY@UNIT2@ABILITY2@DESCRIPTION"
msgstr "Терновые доспехи"

msgid "TOME_IVORY@UNIT2@ABILITY3@NAME"
msgstr "Древнее благословение"

msgid "TOME_IVORY@UNIT2@ABILITY3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Получает +30 {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Снимает негативные эффекты статуса.[bullet/]Enters defense mode."

msgid "TOME_IVORY@UNIT1@NAME_OVERRIDE"
msgstr "Терновый удар"

msgid "TOME_IVORY@STATUS1@NAME"
msgstr "Блаженная жестокость"

msgid "TOME_IVORY@STATUS2@NAME"
msgstr "Один раз за ход, когда этот отряд получает урон: [bulletlist][bullet/]Получает {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}. [bullet/]Получает 3 {GLOBAL.MoraleConcept.Hyperlink}. [bullet/]Страдает {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}."

msgid "TOME_IVORY@STATUS1@DESCRIPTION"
msgstr "Один раз за ход, когда этот отряд получает урон: [bulletlist][bullet/]Получает {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}. [bullet/]Получает 3 {GLOBAL.UnitMoraleConcept.Hyperlink}. [bullet/]Страдает {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}."

