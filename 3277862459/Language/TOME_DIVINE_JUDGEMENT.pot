msgstr "Nimu Surge"

msgid "TOME_DIVINE_JUDGEMENT@UNIT1@ABILITY3@DESCRIPTION"
msgstr "Nimu Surge Description"

msgid "TOME_DIVINE_JUDGEMENT@UNIT1@ABILITY4@NAME"
msgstr "Armor of Judgement"

msgid "TOME_DIVINE_JUDGEMENT@UNIT1@ABILITY4@DESCRIPTION"
msgstr "+1 {GLOBAL.DefenseConcept.Hyperlink} and {GLOBAL.ResistanceConcept.Hyperlink} against {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} units."

