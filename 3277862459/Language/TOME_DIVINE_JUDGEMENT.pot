msgid "TOME_DIVINE_JUDGEMENT@TOME@NAME"
msgstr "Tome of Divine Judgement"

msgid "TOME_DIVINE_JUDGEMENT@TOME@LORE_DESCRIPTION"
msgstr "\"Those who oppose thee, shall know the wrath of heaven. Field and forest shall burn, the seas shall rise and devour them, the wind shall tear their nations from the face of the earth, lightning shall rain down from the sky, they shall cry out to their false gods, and find silence.\""

msgid "TOME_DIVINE_JUDGEMENT@TOME@LORE_AUTHOR"
msgstr "Andraste 7:19"

msgid "TOME_DIVINE_JUDGEMENT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Channel divine lightning to condemn all who stand against your zealous will."

msgid "TOME_DIVINE_JUDGEMENT@SKILL_1@NAME"
msgstr "Divine Maelstrom"

msgid "TOME_DIVINE_JUDGEMENT@SKILL_1@DESCRIPTION"
msgstr "At the start of battle, battlements are destroyed and enemy units:[bulletlist] [bullet/]Sustain 5 {GLOBAL.SpiritDamageConcept.Hyperlink} and 5 {GLOBAL.LightningDamageConcept.Hyperlink}. [bullet/]Are {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/br]"

msgid "TOME_DIVINE_JUDGEMENT@UNIT1@ABILITY1@NAME"
msgstr "Entangling Roots"

msgid "TOME_DIVINE_JUDGEMENT@SKILL_2@NAME"
msgstr "Judge's Fervor"

msgid "TOME_DIVINE_JUDGEMENT@SKILL_2@DESCRIPTION"
msgstr ""
"All friendly units:[bulletlist] [bullet/]Gain {GLOBAL.PROPERTIES.ZEAL.Hyperlink}. [bullet/]2 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}. [br/]\n"
"Units already with {GLOBAL.PROPERTIES.ZEAL.Hyperlink} additionally gain 2 {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

msgid "TOME_DIVINE_JUDGEMENT@SKILL_3@NAME"
msgstr "Final Judgement"

msgid "TOME_DIVINE_JUDGEMENT@SKILL_3@DESCRIPTION"
msgstr "Enemies in a 1 hex radius sustain 14 {GLOBAL.SpiritDamageConcept.Hyperlink} and 14 {GLOBAL.LightningDamageConcept.Hyperlink}. {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} units sustain an additional 50% damage."

msgid "TOME_DIVINE_JUDGEMENT@SKILL_4@NAME"
msgstr "Judge's Vow"

msgid "TOME_DIVINE_JUDGEMENT@SKILL_4@DESCRIPTION"
msgstr "Enchanted units deal 10% additional damage and gain the {GLOBAL.PROPERTIES.JUDGEMENT_DIVINE_SMITE.Hyperlink} ability."

msgid "TOME_DIVINE_JUDGEMENT@SKILL_5@NAME"
msgstr "Knight Justicar"

msgid "TOME_DIVINE_JUDGEMENT@SKILL_5@DESCRIPTION"
msgstr "A knight who condemns those deemed guilty and leads others in glorious battle against the wicked."

msgid "TOME_DIVINE_JUDGEMENT@SKILL_6@NAME"
msgstr "Shell Armor"

msgid "TOME_DIVINE_JUDGEMENT@SKILL_6@DESCRIPTION"
msgstr "Shell Armor Description"

msgid "TOME_DIVINE_JUDGEMENT@HERO_SKILL@NAME"
msgstr "Divine Smite"

msgid "TOME_DIVINE_JUDGEMENT@HERO_SKILL@DESCRIPTION"
msgstr "Target enemy unit sustains 14 {GLOBAL.SpiritDamageConcept.Hyperlink}, 14 {GLOBAL.LightningDamageConcept.Hyperlink} and is {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until the end of battle."

msgid "TOME_DIVINE_JUDGEMENT@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[Conduit/] Judge's Monastery"

msgid "TOME_DIVINE_JUDGEMENT@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+7 {GLOBAL.ManaConcept.Hyperlink}. [bullet/]+7 {GLOBAL.UnitProductionConcept.Hyperlink}. [bullet/]+1 unit rank to recruited support and battlemage units. [bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink}."

msgid "TOME_DIVINE_JUDGEMENT@ENTHRALLED@NAME"
msgstr "Enthralled"

msgid "TOME_DIVINE_JUDGEMENT@ENTHRALLED@DESCRIPTION"
msgstr "All attacks targeting this unit are {GLOBAL.FlankingConcept.Hyperlink} attacks."

msgid "TOME_DIVINE_JUDGEMENT@ABILITY1@DESCRIPTION"
msgstr "Units in a 1 hex radius sustain:[bulletlist][bullet/]22 {GLOBAL.PhysicalDamageConcept.Hyperlink}. [bullet/]Have a base 40% chance of becoming {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}. If unsuccessful, they become {GLOBAL.PROPERTIES.SLOWED.Hyperlink}."

msgid "TOME_DIVINE_JUDGEMENT@UNIT1@ABILITY2@NAME"
msgstr "Divine Smite"

msgid "TOME_DIVINE_JUDGEMENT@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Target enemy unit sustains 14 {GLOBAL.SpiritDamageConcept.Hyperlink}, 14 {GLOBAL.LightningDamageConcept.Hyperlink} and is {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until the end of battle."

msgid "TOME_DIVINE_JUDGEMENT@UNIT2@ABILITY1@NAME"
msgstr "Frost Breath"

msgid "TOME_DIVINE_JUDGEMENT@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Base 30% chance of inflicting {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until the end of battle."

msgid "TOME_DIVINE_JUDGEMENT@UNIT2@ABILITY2@NAME"
msgstr "Armour of Thorns"

msgid "TOME_DIVINE_JUDGEMENT@UNIT2@ABILITY2@DESCRIPTION"
msgstr "Armour of Thorns"

msgid "TOME_DIVINE_JUDGEMENT@UNIT2@ABILITY3@NAME"
msgstr "Ancient Blessing"

msgid "TOME_DIVINE_JUDGEMENT@UNIT2@ABILITY3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain +30 {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Has negative status effects removed.[bullet/]Enters defense mode."

msgid "TOME_DIVINE_JUDGEMENT@UNIT1@NAME_OVERRIDE"
msgstr "Thorn Strike"

