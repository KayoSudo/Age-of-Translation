msgid "VM@TOME_ENDLESS_WINTER@TOME@NAME"
msgstr "Tome of Endless Winter"

msgid "VM@TOME_ENDLESS_WINTER@TOME@GAMEPLAY_DESCRIPTION"
msgstr ""
"Bring forth the endless winter and bind your enemies to a {GLOBAL.PROPERTIES."
"FROZEN.Hyperlink} demise."

msgid "VM@TOME_ENDLESS_WINTER@TOME@LORE_DESCRIPTION"
msgstr ""
"\"The time has come to welcome the endless winter. Spread its cold embrace "
"across the realm and claim all in its path. No fire shall burn, no warmth "
"shall rise; only frost shall endure. The frozen shall stand as silent, "
"lifeless monuments to winter's eternal dominion.\""

msgid "VM@TOME_ENDLESS_WINTER@TOME@LORE_AUTHOR"
msgstr "Artica, Queen of the Frostlings"

msgid "VM@TOME_ENDLESS_WINTER@TOME@ASCENSION@TRAIT@NAME"
msgstr "Ascension: Herald of Winter"

msgid "VM@TOME_ENDLESS_WINTER@TOME@ASCENSION@PROPERTY@NAME"
msgstr "Ascended Herald of Winter"

msgid "VM@TOME_ENDLESS_WINTER@TOME@ASCENSION@PROPERTY@DESCRIPTION"
msgstr ""
"Grants:[bulletlist][bullet/]Base attacks have a "
"{FROZEN_RESISTANCE>ResolvedStrength}% chance to inflict {GLOBAL.PROPERTIES."
"FROZEN.Hyperlink}. If unsuccessful, inflicts {GLOBAL.PROPERTIES.SLOWED."
"Hyperlink}.[bullet/]Immunity to {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/"
"bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "VM@TOME_ENDLESS_WINTER@TOME@ASCENSION@SPELL@NAME"
msgstr "Summon Scourge of Ice Mount"

msgid "VM@TOME_ENDLESS_WINTER@TOME@ASCENSION@SPELL@DESCRIPTION"
msgstr ""
"Summon a {GLOBAL.EQUIPMENT.TEW_SCOURGE_OF_ICE_MOUNT.Hyperlink}, a powerful "
"steed for your [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink]."

msgid "VM@TOME_ENDLESS_WINTER@TOME@MOUNT@NAME"
msgstr "Scourge of Ice Mount^n"

msgid "VM@TOME_ENDLESS_WINTER@TOME@PROVINCE_IMPROVEMENT@NAME"
msgstr "[researchpost/] Ice Palace"

msgid "VM@TOME_ENDLESS_WINTER@TOME@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]When placed, alter terrain to Arctic.[bullet/]+10 "
"{GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+3 {GLOBAL.KnowledgeConcept."
"Hyperlink} per adjacent Snow or Ice {GLOBAL.ProvinceConcept.Hyperlink}."
"[bullet/]When a {GLOBAL.PROPERTIES.FROZEN.Hyperlink} enemy dies in battle, "
"gain 10 {GLOBAL.ManaConcept} per unit Tier. This does not stack."
"[bullet/]Counts as a {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL1@NAME"
msgstr "Icy Focus"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL1@DESCRIPTION"
msgstr ""
"Enchanted units gain:[bulletlist][bullet/]Base {GLOBAL.MagicConcept."
"Hyperlink} attacks deal +{VM_TEW_ICY_FOCUS_EXTRA_DAMAGE>DAMAGE>Frost} "
"{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES."
"VM_TEW_FROZEN_FURY.Hyperlink}, increasing the damage of base attacks against "
"{GLOBAL.PROPERTIES.FROZEN.Hyperlink} and {GLOBAL.PROPERTIES.SLOWED."
"Hyperlink} units.[bullet/]The {GLOBAL.PROPERTIES.VM_TEW_ICE_COMET.Hyperlink} "
"ability.[/bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL1@ACTIVE_ABILITY@NAME"
msgstr "Ice Comet"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL1@ACTIVE_ABILITY@DESCRIPTION"
msgstr ""
"Units in a {VM_TEW_ICE_COMET_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius "
"sustain damage."

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL2@NAME"
msgstr "Domain of Endless Winter"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL2@DESCRIPTION"
msgstr ""
"In the domain's Arctic <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>:[bulletlist]"
"[bullet/]Enemy units take attrition damage from {GLOBAL.PROPERTIES."
"VM_TEW_DOMAN_OF_WINTER_ENEMY_PROPERTY_GROUP.Hyperlink} at the end of each "
"turn on the {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]A Snow Spirit is "
"spawned on the owner's side during {GLOBAL.CombatConcept.Hyperlink}.[/"
"bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL2@COMBAT_PROPERTY@DESCRIPTION"
msgstr ""
"Spawns a {GLOBAL.UNITS.SNOW_SPIRIT.Hyperlink} on the owner's side during "
"{GLOBAL.CombatConcept.Hyperlink} in Arctic provinces."

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL2@DISPLAY_PROPERTY@DESCRIPTION"
msgstr ""
"In the domain's Arctic <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>:[bulletlist]"
"[bullet/]Enemy units take attrition damage from {GLOBAL.PROPERTIES."
"VM_TEW_DOMAN_OF_WINTER_ENEMY_PROPERTY_GROUP.Hyperlink} at the end of each "
"turn on the {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]A Snow Spirit is "
"spawned on the owner's side during {GLOBAL.CombatConcept.Hyperlink}.[/"
"bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL2@ENEMY_PROPERTY@DESCRIPTION"
msgstr ""
"This unit:[bulletlist][bullet/]Cannot regenerate <<m:{GLOBAL.HitPointConcept."
"Hyperlink}>> in the {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]Loses 6 "
"[hp/] Hit Points at the end of each {GLOBAL.TurnConcept.Hyperlink} in the "
"World Map. The unit's health cannot drop below 50%.[/bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL3@NAME"
msgstr "Summon Frost Incarnate"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL3@DESCRIPTION"
msgstr ""
"Choose then summon a Tier V {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} with "
"Frost and Freezing-related abilities on target hex:[bulletlist][bullet/]"
"{GLOBAL.UNITS.VM_TEW_FROST_QUEEN.Hyperlink}[bullet/]{GLOBAL.UNITS."
"BLUE_DRAGON.Hyperlink}[/bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL4@NAME"
msgstr "Sweeping Winter"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL4@DESCRIPTION"
msgstr ""
"Target {GLOBAL.ProvinceConcept.Hyperlink} and adjacent Provinces:[bulletlist]"
"[bullet/]Enemy <<m:{GLOBAL.UnitConcept.Hyperlink}>> suffer 20 {GLOBAL."
"FrostDamageConcept.Hyperlink}.[bullet/]The provinces gain {GLOBAL."
"SnowConcept.Hyperlink} and {GLOBAL.FrozenWasteConcept.Hyperlink}."
"[bullet/]The provinces lose {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL."
"FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL."
"SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL."
"SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL."
"FungusFieldsConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}."
"[bullet/]Summon a {GLOBAL.UNITS.SNOW_SPIRIT.Hyperlink} on the targeted hex.[/"
"bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL5@NAME"
msgstr "Hailstorm"

msgid "VM@TOME_ENDLESS_WINTER@TOME@SKILL5@DESCRIPTION"
msgstr ""
"Up to {VM_TEW_HAILSTORM_AUTO_SPELL>MaxCastCount} random enemy units and "
"enemies adjacent to those:[bulletlist][bullet/]Sustain "
"{VM_TEW_HAILSTORM_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept."
"Hyperlink}.[bullet/]Are inflicted with {GLOBAL.PROPERTIES.SLOWED.Hyperlink} "
"for {SLOWED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/"
"bulletlist][br/]This spell repeats at the start of each turn for the next "
"{VM_TEW_HAILSTORM_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>."

msgid "VM@TOME_ENDLESS_WINTER@UNIT@NAME"
msgstr "Ice Queen"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@BASE_ABILITY@NAME"
msgstr "Ice Blast"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY@NAME"
msgstr "Shardstorm"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY@DESCRIPTION"
msgstr ""
"Units in a {VM_TEW_FREEZING_BLIZZARD_UNIT_TARGETER>AREA>Radius}-hex radius "
"sustain damage."

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY2@NAME"
msgstr "Curse of Winter"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY2@DESCRIPTION"
msgstr ""
"Inflict 2 stacks of {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} on "
"the target unit."

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY3@NAME"
msgstr "Shatter Ice"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY3@DESCRIPTION"
msgstr ""
"Deals damage to target {GLOBAL.PROPERTIES.FROZEN.Hyperlink} unit, ignoring "
"defenses."

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY3@MODIFIER_DESCRIPTION"
msgstr ""
"If the target is slain:[bulletlist][bullet/]The target explodes, dealing "
"{VM_TEW_ICESHATTER_RENEWAL_CIRCLE_DAMAGE>DAMAGE>Frost}{GLOBAL."
"FrostDamageConcept.Hyperlink} to adjacent units.[bullet/]Gain "
"{CP_BONUS_OPERATION>PointsToGive} <<m:{GLOBAL.CombatCastingPointConcept."
"Hyperlink}>>.[bullet/]The caster refreshes all of its ability cooldowns.[/"
"bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY3@UPGRADE@NAME"
msgstr "Improved Shatter Ice"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@ABILITY3@UPGRADE@DESCRIPTION"
msgstr ""
"{GLOBAL.PROPERTIES.TEW_ICESHATTER_RENEWAL.Hyperlink} deals +50% damage to "
"target {GLOBAL.PROPERTIES.FROZEN.Hyperlink} unit."

msgid "VM@TOME_ENDLESS_WINTER@UNIT@PASSIVE@NAME"
msgstr "Chilling Aura"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@PASSIVE@DESCRIPTION"
msgstr ""
"At the end of this unit's turn, adjacent enemy units:[bulletlist]"
"[bullet/]Have a base {SLOWED_RESISTANCE>ResolvedStrength}% chance to be "
"inflicted with {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[bullet/]Have a base "
"{SUNDERED_RESISTANCE_RESISTANCE>ResolvedStrength}% chance to be inflicted "
"with {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@PASSIVE2@NAME"
msgstr "Presence of Winter"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@PASSIVE2@DESCRIPTION"
msgstr ""
"While this unit is in combat, all friendly units gain:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.VM_TEW_PRESENCE_OF_WINTER_PROPERTY_GROUP.Hyperlink}[/"
"bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "VM@TOME_ENDLESS_WINTER@UNIT@PASSIVE2@COMBAT_ENCHANTMENT@DESCRIPTION"
msgstr ""
"Units of this effect's owner gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES."
"VM_TEW_PRESENCE_OF_WINTER_PROPERTY_GROUP.Hyperlink}[/bulletlist][br/]{LOC."
"INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "VM@TOME_ENDLESS_WINTER@PASSIVE@FROZEN_FURY@NAME"
msgstr "Frozen Fury"

msgid "VM@TOME_ENDLESS_WINTER@PASSIVE@FROZEN_FURY@DESCRIPTION"
msgstr ""
"Base attacks deal "
"+{VM_TEW_FROZEN_FURY_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against "
"{GLOBAL.PROPERTIES.FROZEN.Hyperlink} and {GLOBAL.PROPERTIES.SLOWED."
"Hyperlink} units."

