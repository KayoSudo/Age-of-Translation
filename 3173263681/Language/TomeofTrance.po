msgid "TOME@TRANCE@NAME"
msgstr "Tome of Unchained Wrath"

msgid "TOME@TRANCE@DESC"
msgstr "Enter a mesmerizing trance of war where fear fades and fury sharpens. Raise your {GLOBAL.PROPERTIES.WARCRY.Hyperlink} and lift your {GLOBAL.UnitMoraleConcept.Hyperlink} high so you may better engage in combat."

msgid "TOME@TRANCE@AUTHOR@NAME"
msgstr "Uldra Tideweaver, uniter of the Unruly North"

msgid "TOME@TRANCE@AUTHOR@DESC"
msgstr "“Fury is no aimless chaos—it is a storm awaiting its horizon. In their trances, these warriors cast aside fear and reason… yet with a careful hand to guide them, even they find purpose.”"

msgid "TOME@TRANCE@Skill1@Name"
msgstr "Rhythm of Fury"

msgid "TOME@TRANCE@Skill1@DESC"
msgstr "Units in a 1-hex radius: [bulletlist][bullet/]Have a 60% chance of suffering {GLOBAL.PROPERTIES.BERSERK.Hyperlink} for 1 turn. [bullet/]Friendly Units are always inflicted."

msgid "TOME@TRANCE@Skill1@Unit@Skill"
msgstr "Battle Chanting"

msgid "TOME@TRANCE@Skill1@Unit@Skill2@DESC"
msgstr "Bind your army through rhythm and fury: [bulletlist][bullet/]Units gain {GLOBAL.PROPERTIES.WARCRY.Hyperlink}, an active ability that self inflicts {GLOBAL.PROPERTIES.BERSERK.Hyperlink} for 1 {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME@TRANCE@Skill1@Unit@Skill@DESC"
msgstr "Rite of the Wargods"

msgid "TOME@TRANCE@Skill1@Unit@Skill2"
msgstr "Perform a ceremonial ritual on the eve of battle: [bulletlist][bullet/]Units are healed for 10 {GLOBAL.TemporaryHitPointConcept.Hyperlink} at the start of battle. [bullet/]When the walls are breached, gain 50 {GLOBAL.ManaConcept.Hyperlink} per tier of the besieged City."

msgid "TOME@TRANCE@Skill1@Unit"
msgstr "Ursine Berserker"

msgid "TOME@TRANCE@Skill2@Name"
msgstr "A {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} that turns into an {GLOBAL.UNITS.MIDNIGHTBEAR_UNIT.Hyperlink} during the chaos of battle."

msgid "TOME@TRANCE@Skill2@SKILL@Name"
msgstr "Berserker's Trance"

msgid "TOME@TRANCE@Skill2@DESC"
msgstr "Enhance your units with {GLOBAL.PROPERTIES.BERSEKER_TRANCE.Hyperlink}, a passive ability that heals and gives a unique active to Friendly Units inflicted with {GLOBAL.PROPERTIES.BERSERK.Hyperlink}."

msgid "TOME@TRANCE@Skill3@Name"
msgstr "[happiness/] The Sharing"

msgid "TOME@TRANCE@Skill3@Skill@Name"
msgstr "[bulletlist][bullet/]+10 {GLOBAL.ManaConcept.Hyperlink}. [bullet/]Units in the province are damaged for 65 {GLOBAL.HitPointConcept.Hyperlink} in exchange for gaining 30 {GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.TurnConcept.Hyperlink}. [bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink}."

msgid "TOME@TRANCE@Skill3@Skill@DESC"
msgstr "Dire Bear"

msgid "TOME@TRANCE@Skill3@Desc"
msgstr "Berserker's Trance"

msgid "TOME@TRANCE@Skill2@Unit@Skill@DESC"
msgstr "TEMPORARY"

msgid "TOME@TRANCE@Skill4@Name"
msgstr "The Sharing: "

msgid "TOME@TRANCE@Skill4@DESC"
msgstr "Berserker's Fury"

msgid "TOME@TRANCE@Skill5@Name"
msgstr "Unleash a hail of furious strikes in a 1-hex cone, effectiveness against secondary targets is reduced."

msgid "TOME@TRANCE@Skill5@DESC"
msgstr "Eventide Bear"

msgid "TOME@TRANCE@Skill6@Name"
msgstr "Shapeshift: Eventide Bear"

msgid "TOME@TRANCE@Skill6@DESC"
msgstr "Eventide BearTransformation"

msgid "TOME@TRANCE@Skill6@Group"
msgstr "Heal for 25 {GLOBAL.TemporaryHitPointConcept.Hyperlink} and transform into a {GLOBAL.PROPERTIES.BERSERK.Hyperlink} {GLOBAL.UNITS.MIDNIGHTBEAR_UNIT.Hyperlink} for 3 {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME@TRANCE@PANTHEON@NAME"
msgstr "Ascension: Warchief"

msgid "TOME@TRANCE@PANTHEON@NAME2"
msgstr "Whenever this unit suffers {GLOBAL.PROPERTIES.BERSERK.Hyperlink}, heals for 25 {GLOBAL.TemporaryHitPointConcept.Hyperlink} and gain {GLOBAL.PROPERTIES.BERSERKER_FURY.Hyperlink} for 1 turn."

msgid "TOME@TRANCE@PANTHEON@NAME3"
msgstr "Gain berserker rage + Berserker strikes"

msgid "TOME@TRANCE@PANTHEON@NAME4"
msgstr "=="

msgid "TOME@TRANCE@PANTHEON@NAME5"
msgstr "War Cry"

msgid "TOME@TRANCE@EXTRA@NAME"
msgstr "Damage Enemy Units in a 1-hex radius: [bulletlist][bullet/]+10 {GLOBAL.UnitMoraleConcept.Hyperlink}. [bullet/]Becomes {GLOBAL.PROPERTIES.BERSERK.Hyperlink}."

msgid "TOME@TRANCE@EXTRA@NAME2"
msgstr "Warchief"

msgid "TOME@TRANCE@EXTRA@NAME3"
msgstr "=="

msgid "TOME@TRANCE@EXTRA@NAME4"
msgstr "=="

msgid "TOME@TRANCE@EXTRA@NAME5"
msgstr "Thrill of Battle"

msgid "TOME@TRANCE@EXTRA@NAME6"
msgstr "Gain at the end of each {GLOBAL.TurnConcept.Hyperlink}: [bulletlist][bullet/]+1 {GLOBAL.PROPERTIES.RALLYING.Hyperlink}. [bullet/]+1 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME@TRANCE@EXTRA@NAME7"
msgstr "The Sharing"
