msgid "TOME@ROYALS@NAME"
msgstr "Tome of the Ruling Crown"

msgid "TOME@ROYALS@DESC"
msgstr "Unlocks the true potential of your authority through Iron Rule and Divine Right, employ the might of Barons and Knights to enact the will of a true {GLOBAL.PROPERTIES.KING_OF_KINGS.Hyperlink}."

msgid "TOME@ROYALS@AUTHOR@NAME"
msgstr "Holden, newly crowned King of the Isles"

msgid "TOME@ROYALS@AUTHOR@DESC"
msgstr "“Ignorance is hardly unusual, Lady Denver. The longer I live, the more I come to realize that it is the natural state of the human mind. There are many who will strive to fight its sanctity, i however, understand that exploiting it is the true path to wear a crown.”"

msgid "TOME@ROYALS@Skill1@Name"
msgstr "Foot Knights"

msgid "TOME@ROYALS@Skill1@DESC"
msgstr "A {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} that uses its hammer to smash down enemy defenses."

msgid "TOME@ROYALS@Skill1@Unit@Skill"
msgstr "Overhead Smash"

msgid "TOME@ROYALS@Skill1@Unit@Skill2@DESC"
msgstr "Charge Attack that pierces enemy defenses."

msgid "TOME@ROYALS@Skill1@Unit@Skill@DESC"
msgstr "Veteran Defense"

msgid "TOME@ROYALS@Skill1@Unit@Skill2"
msgstr "2"

msgid "TOME@ROYALS@Skill1@Unit"
msgstr "The Crown blesses our deeds: [bulletlist] [bullet/]+4 {GLOBAL.FrostDamageConcept.Hyperlink} to it's basic attacks. [bullet/]Basic attacks are extended to a 1-hex circle around the target, dealing 30% of the original damage. [bullet/] Gain {GLOBAL.PROPERTIES.DIVINE_RIGHT_BUFF_REBIRTH.Hyperlink}."

msgid "TOME@ROYALS@Skill2@Name"
msgstr "When this unit dies: [bulletlist][bullet/]Enemies within {REIGN_TERROR_ON_DEATH_TARGETER_CIRCLE>AREA>Radius} hexes suffer -5 {GLOBAL.UnitMoraleConcept.Hyperlink}. [bullet/]{GLOBAL.PROPERTIES.HEAVYCROWNDEATH} passes on to another enemy unit within {REIGN_TERROR_ON_DEATH_TARGETER_JUMP>MaxDistance} hexes."

msgid "TOME@ROYALS@Skill2@SKILL@Name"
msgstr "Reign of Terror"

msgid "TOME@ROYALS@Skill2@DESC"
msgstr "Target enemy unit suffers: [bulletlist][bullet/]{GLOBAL.PROPERTIES.HEAVYCROWNDEATH}. [bullet/]2 {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}. [bullet/]2 {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}."

msgid "TOME@ROYALS@Skill3@Name"
msgstr "Iron Rule"

msgid "TOME@ROYALS@Skill3@Skill@Name"
msgstr "Issue the Crown's Authority unto target {GLOBAL.CityConcept.Hyperlink}: [bulletlist][bullet/]It ignores economic penalties from negative {GLOBAL.CityStabilityConcept.Hyperlink} levels. [bullet/]Prevent provinces breaking off due to low {GLOBAL.CityStabilityConcept.Hyperlink}. [bullet/]+5 {GLOBAL.GoldConcept.Hyperlink} and +5 {GLOBAL.UnitProductionConcept.Hyperlink} for each {GLOBAL.CityStabilityConcept.Hyperlink} level above Neutral."

msgid "TOME@ROYALS@Skill3@Skill@DESC"
msgstr "[influence/] Barony"

msgid "TOME@ROYALS@Skill3@Desc"
msgstr "[bulletlist] [bullet/]+5 {GLOBAL.FortificationHealthConcept.Hyperlink}. [bullet/]+10 {GLOBAL.UnitProductionConcept.Hyperlink}. [bullet/]+2 {GLOBAL.ImperiumConcept.Hyperlink} per Adjacent {GLOBAL.FarmConcept.Hyperlink}. [bullet/]-5 {GLOBAL.CityStabilityConcept.Hyperlink}. [bullet/]Counts as a {GLOBAL.FarmConcept.Hyperlink}."

msgid "TOME@ROYALS@Skill2@Unit@Skill@DESC"
msgstr "Noble Echelon"

msgid "TOME@ROYALS@Skill4@Name"
msgstr "Employ the might of the elite in your standard army, enchanted units gain: [bulletlist] [bullet/]+10 {GLOBAL.HitPointConcept.Hyperlink}. [bullet/]+1 {GLOBAL.DefenseConcept.Hyperlink}."

msgid "TOME@ROYALS@Skill4@DESC"
msgstr "Divine Right"

msgid "TOME@ROYALS@Skill5@Name"
msgstr "Faction Leader earns {GLOBAL.PROPERTIES.DIVINEWILL.Hyperlink}, a free Action Ability that gives {GLOBAL.FrostDamageConcept.Hyperlink} and {GLOBAL.PROPERTIES.DIVINE_RIGHT_BUFF_REBIRTH.Hyperlink} to buffed unit."

msgid "TOME@ROYALS@Skill5@DESC"
msgstr "Bestow Crown's Authority"

msgid "TOME@ROYALS@Skill6@Name"
msgstr "Target friendly unit gain until the end of battle: [bulletlist] [bullet/]+4 {GLOBAL.FrostDamageConcept.Hyperlink} to it's basic attacks. [bullet/]Basic attacks are extended to a 1-hex circle around the target, dealing 30% of the original damage. [bullet/] Gain {GLOBAL.PROPERTIES.DIVINE_RIGHT_BUFF_REBIRTH.Hyperlink}."

msgid "TOME@ROYALS@Skill6@DESC"
msgstr "Crown's Authority"

msgid "TOME@ROYALS@Skill6@Group"
msgstr "Unit will Resurrect with 100% of their {GLOBAL.HitPointConcept.Hyperlink} in 1 {GLOBAL.TurnConcept.Hyperlink} after death."

msgid "TOME@ROYALS@PANTHEON@NAME"
msgstr "Ascension: King of Kings"

msgid "TOME@ROYALS@PANTHEON@NAME2"
msgstr "King of Kings"

msgid "TOME@ROYALS@PANTHEON@NAME3"
msgstr "If by man or the divine, this one was recognized as the true Ruler of all that is golden: [bulletlist] [bullet/]+1 {GLOBAL.CityConcept.Hyperlink} Cap. [bullet/] +15 {GLOBAL.ImperiumConcept.Hyperlink} per turn."

msgid "TOME@ROYALS@PANTHEON@NAME4"
msgstr "DESC 7"

msgid "TOME@ROYALS@PANTHEON@NAME5"
msgstr "DESC 8"
