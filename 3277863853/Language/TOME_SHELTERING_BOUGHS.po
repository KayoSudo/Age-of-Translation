msgid "TOME_SHELTERING_BOUGHS@TOME@NAME"
msgstr "Tome of Sheltering Boughs"

msgid "TOME_SHELTERING_BOUGHS@TOME@LORE_DESCRIPTION"
msgstr "“You drove us from our land… you drove us from our Work… Into the forest you drove us. But you forget: repression works only to strengthen and knit the repressed.”"

msgid "TOME_SHELTERING_BOUGHS@TOME@LORE_AUTHOR"
msgstr "An anonymous survivor of the Dragon Wars"

msgid "TOME_SHELTERING_BOUGHS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Specialise in wars of attrition and {GLOBAL.PROPERTIES.PLANT.Hyperlink} units. Help your units survive longer while rooting your enemies in place and causing {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}."

msgid "TOME_SHELTERING_BOUGHS@SKILL_1@NAME"
msgstr "Ancient Protectors"

msgid "TOME_SHELTERING_BOUGHS@SKILL_1@DESCRIPTION"
msgstr ""
"Enchanted units heal +5 <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> when they end their turn in {GLOBAL.DefenseModeConcept.Hyperlink}. <<m:{GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink}>> units also heal adjacent allies.\n"
"\n"
"Healing is doubled for Non-Racials"

msgid "TOME_SHELTERING_BOUGHS@UNIT1@ABILITY1@NAME"
msgstr "Entangling Roots"

msgid "TOME_SHELTERING_BOUGHS@SKILL_2@NAME"
msgstr "Entwined Sentinel"

msgid "TOME_SHELTERING_BOUGHS@SKILL_2@DESCRIPTION"
msgstr "Sentinels that act as Disciples of the Druid of the Cycle."

msgid "TOME_SHELTERING_BOUGHS@SKILL_3@NAME"
msgstr "Canopy Cover"

msgid "TOME_SHELTERING_BOUGHS@SKILL_3@DESCRIPTION"
msgstr "Friendly units adjacent to target friendly {GLOBAL.PROPERTIES.PLANT.Hyperlink} unit gain:[bulletlist][bullet/]2 {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]2 {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}. [bullet/]{GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

msgid "TOME_SHELTERING_BOUGHS@SKILL_4@NAME"
msgstr "Sapping Roots"

msgid "TOME_SHELTERING_BOUGHS@SKILL_4@DESCRIPTION"
msgstr "Enemy units in a 2-hex radius:[bulletlist][bullet/]Gain 1 {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[bullet/]Gain 1 {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} if they are {GLOBAL.PROPERTIES.POISONED.Hyperlink}, {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}, {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}, or {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "TOME_SHELTERING_BOUGHS@SKILL_5@NAME"
msgstr "Armour of Thorns"

msgid "TOME_SHELTERING_BOUGHS@SKILL_5@DESCRIPTION"
msgstr "For 3 turns, target friendly unit is cocooned in thorns, granting:[bulletlist] [bullet/]2 {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}. [bullet/]Enters {GLOBAL.DefenseModeConcept.Hyperlink} at the end of its turn.[bullet/]Melee attackers have a 60% chance of suffering {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}."

msgid "TOME_SHELTERING_BOUGHS@SKILL_6@NAME"
msgstr "Garden Tenders"

msgid "TOME_SHELTERING_BOUGHS@SKILL_6@DESCRIPTION"
msgstr ""
"Granted gifts from Mother Gaia, your race can strengthens plant life around them. \n"
"At the end of each turn, adjacent {GLOBAL.PROPERTIES.PLANT.Hyperlink}, {GLOBAL.PROPERTIES.ANIMAL.Hyperlink}, and {GLOBAL.PROPERTIES.FEY.Hyperlink} creatures gain {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}. (Does not stack.)"

msgid "TOME_SHELTERING_BOUGHS@HERO_SKILL@NAME"
msgstr "Bark Armour"

msgid "TOME_SHELTERING_BOUGHS@HERO_SKILL@DESCRIPTION"
msgstr "Target unit gains:[bulletlist][bullet/]3 {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]Counts as a {GLOBAL.PROPERTIES.PLANT.Hyperlink} (if a Racial Unit) until end of combat."

msgid "TOME_SHELTERING_BOUGHS@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[Forester/] Sheltering Grove"

msgid "TOME_SHELTERING_BOUGHS@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+5 {GLOBAL.FoodConcept.Hyperlink}.[bullet/]+3 {GLOBAL.StructureProductionConcept.Hyperlink}. [bullet/]+2 {GLOBAL.ManaConcept.Hyperlink}.[bullet/]Spawns an {GLOBAL.UNITS.ENTWINED_PROTECTOR_UNIT.Hyperlink} unit on the owner's side for {GLOBAL.CombatConcept.Hyperlink} in this {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.ForesterConcept.Hyperlink}."

msgid "TOME_SHELTERING_BOUGHS@ENTHRALLED@NAME"
msgstr "Enthralled"

msgid "TOME_SHELTERING_BOUGHS@ENTHRALLED@DESCRIPTION"
msgstr "All attacks targeting this unit are {GLOBAL.FlankingConcept.Hyperlink} attacks."

msgid "TOME_SHELTERING_BOUGHS@ABILITY1@DESCRIPTION"
msgstr "Units in a 1 hex radius sustain damage:"

msgid "TOME_SHELTERING_BOUGHS@UNIT1@ABILITY2@NAME"
msgstr "Hypnotize"

msgid "TOME_SHELTERING_BOUGHS@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Grants a base 60% chance of making target {GLOBAL.PROPERTIES.ENTHRALLED.Hyperlink} enemy unit become {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} for 3 turns. If the effect fails, or the target is not {GLOBAL.PROPERTIES.ENTHRALLED.Hyperlink}, the target is {GLOBAL.PROPERTIES.ENTHRALLED.Hyperlink} instead."

msgid "TOME_SHELTERING_BOUGHS@UNIT2@ABILITY1@NAME"
msgstr "Frost Breath"

msgid "TOME_SHELTERING_BOUGHS@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Frost Breath"

msgid "TOME_SHELTERING_BOUGHS@UNIT2@ABILITY2@NAME"
msgstr "Armour of Thorns"

msgid "TOME_SHELTERING_BOUGHS@UNIT2@ABILITY2@DESCRIPTION"
msgstr "Armour of Thorns"

msgid "TOME_SHELTERING_BOUGHS@UNIT2@ABILITY3@NAME"
msgstr "Ancient Blessing"

msgid "TOME_SHELTERING_BOUGHS@UNIT2@ABILITY3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain +30 {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Has negative status effects removed.[bullet/]Enters defense mode."

msgid "TOME_SHELTERING_BOUGHS@UNIT1@NAME_OVERRIDE"
msgstr "Thorn Strike"
