msgid "TOME_SKULLS@TOME@NAME"
msgstr "Tome of the Blood God"

msgid "TOME_SKULLS@TOME@LORE_DESCRIPTION"
msgstr "\"My God grants me all I need in life. He lets me fight, pillage, and scour the world. He lets me fulfill every desire my dark heart could ever want for and He asks for naught but the blood that flows from the wounds inflicted upon me and those I strike down in His name. When I kill you, your blood will fill His chalice and He will drink deeply from it, and I will know that I am truly blessed.\""

msgid "TOME_SKULLS@TOME@LORE_AUTHOR"
msgstr "Dhonleif the Berserker"

msgid "TOME_SKULLS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Revel in the madness of warfare. Let blood fill the goblet of the Lord of Murder and pile high the skulls of all who dare stand before you."

msgid "TOME_SKULLS@SKILL_1@NAME"
msgstr "Bloodletter"

msgid "TOME_SKULLS@SKILL_1@DESCRIPTION"
msgstr "Bloodletter"

msgid "TOME_SKULLS@UNIT1@ABILITY1@NAME"
msgstr "Gore Cleave"

msgid "TOME_SKULLS@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Gore Cleave's Description"

msgid "TOME_SKULLS@SKILL_2@NAME"
msgstr "Exsanguinating Blades"

msgid "TOME_SKULLS@SKILL_2@DESCRIPTION"
msgstr "Makes base {GLOBAL.MeleeConcept.Hyperlink} and {GLOBAL.RangedConcept.Hyperlink} attacks of enchanted units:[bulletlist][bullet/]Deal +2 {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Gain base 90% chance of inflicting {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}."

msgid "TOME_SKULLS@SKILL_3@NAME"
msgstr "Blood for the Blood God"

msgid "TOME_SKULLS@SKILL_3@DESCRIPTION"
msgstr "Units in a 1 hex radius sustain:[bulletlist][bullet/]25 {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Suffer the {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} status condition."

msgid "TOME_SKULLS@SKILL_4@NAME"
msgstr "Skulls for the Skull Throne"

msgid "TOME_SKULLS@SKILL_4@DESCRIPTION"
msgstr "Friendly units in a 1 hex radius sustain:[bulletlist][bullet/]5 {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]5 {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink} for 3 {GLOBAL.TurnConcept}."

msgid "TOME_SKULLS@SKILL_5@NAME"
msgstr "Vessels of Blood"

msgid "TOME_SKULLS@SKILL_5@DESCRIPTION"
msgstr "Your race becomes vessels of adrenaline and lovers of blood, your race gains:[bulletlist][bullet/]Melee attackers have 60% chance to be inflicted with {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}.[bullet/]+1 {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Cities of this race gains +1 {GLOBAL.UnitProductionConcept.Hyperlink} per {GLOBAL.PopulationConcept.Hyperlink}."

msgid "TOME_SKULLS@SKILL_6@NAME"
msgstr "Sanguine Cult"

msgid "TOME_SKULLS@SKILL_6@DESCRIPTION"
msgstr "For each concurrent war, gain:[bulletlist][bullet/]+10 {GLOBAL.UnitProductionConcept.Hyperlink}[bullet/]+10 {GLOBAL.CityStabilityConcept.Hyperlink}.[br/][br/]Grants {GLOBAL.SKILLS.BARBARIC_WARLORD_BERSERKER_RAGE.Hyperlink} to every {GLOBAL.UnitConcept.Hyperlink} produced in this {GLOBAL.CityConcept.Hyperlink}."

msgid "TOME_SKULLS@HERO_SKILL@NAME"
msgstr "Fight to the Death"

msgid "TOME_SKULLS@HERO_SKILL@DESCRIPTION"
msgstr "Target enemy and the caster are both taunted by each other for 3 {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_SKULLS@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[forester/] Daemon Forge"

msgid "TOME_SKULLS@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+10 {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+3 {GLOBAL.UnitProductionConcept.Hyperlink} per adjacent Ashlands {GLOBAL.ProvinceConcept.Hyperlink} and {GLOBAL.ForesterConcept.Hyperlink}.[bullet/]+3 {GLOBAL.GoldConcept.Hyperlink} per adjacent Ashlands {GLOBAL.ProvinceConcept.Hyperlink} and {GLOBAL.ForesterConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.ForesterConcept.Hyperlink}.[bullet/]{GLOBAL.UnitConcept.Hyperlink} deployment location."

