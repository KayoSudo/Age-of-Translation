msgid "TOME_FATEWEAVERS@TOME@NAME"
msgstr "Tome of the Fateweaver"

msgid "TOME_FATEWEAVERS@TOME@LORE_DESCRIPTION"
msgstr "\"The Watcher sits atop his perch enacting plan, upon plan, upon plan. He incites rebellion, inspires conspiracy, and calls upon his followers to seek ambition, sorcery, and mutation. His followers burn their foes to dust before them, all while acting as puppets on His string.\""

msgid "TOME_FATEWEAVERS@TOME@LORE_AUTHOR"
msgstr "Chi'an Chi, the Eagle"

msgid "TOME_FATEWEAVERS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Bring the force of change to your enemies. Melt their armor. Warp their bodies. Turn them to dust. And bring forth ruin upon your foes."

msgid "TOME_FATEWEAVERS@SKILL_1@NAME"
msgstr "Fateweaver"

msgid "TOME_FATEWEAVERS@SKILL_1@DESCRIPTION"
msgstr "Fateweaver"

msgid "TOME_FATEWEAVERS@UNIT1@ABILITY1@NAME"
msgstr "Entangling Roots"

msgid "TOME_FATEWEAVERS@SKILL_2@NAME"
msgstr "Fires of Change"

msgid "TOME_FATEWEAVERS@SKILL_2@DESCRIPTION"
msgstr "Units in a 1 hex radius sustain:[bulletlist] [bullet/]25 {GLOBAL.FireDamageConcept.Hyperlink}. [bullet/]{GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}. [bullet/]{GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "TOME_FATEWEAVERS@SKILL_3@NAME"
msgstr "Vile Transmutation"

msgid "TOME_FATEWEAVERS@SKILL_3@DESCRIPTION"
msgstr "Has a chance of turning target enemy non-hero, non-mythic unit into a {GLOBAL.UNITS.FATEWEAVER_ASTRAL_SPAWN_UNIT.Hyperlink}. Chance increases on targets with lower {GLOBAL.HitPointConcept.Hyperlink}."

msgid "TOME_FATEWEAVERS@SKILL_4@NAME"
msgstr "Mark of the Fateweaver"

msgid "TOME_FATEWEAVERS@SKILL_4@DESCRIPTION"
msgstr "The Eagle God grants you his mark, attuning you to the very flow of magic, granting the race:[bulletlist] [bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_BARRIER.Hyperlink}, healing units whenever spells are cast."

msgid "TOME_FATEWEAVERS@SKILL_5@NAME"
msgstr "Eye of Destiny"

msgid "TOME_FATEWEAVERS@SKILL_5@DESCRIPTION"
msgstr "Target enemy army:[bulletlist] [bullet/]Loses 75% of its move points on the {GLOBAL.WorldMapConcept.Hyperlink}. [bullet/]Sustains 2 {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_FATEWEAVERS@SKILL_6@NAME"
msgstr "Cult of the Feathered God"

msgid "TOME_FATEWEAVERS@SKILL_6@DESCRIPTION"
msgstr "[bulletlist][bullet/]+10 {GLOBAL.ManaConcept.Hyperlink}. [bullet/]+10 {GLOBAL.KnowledgeConcept.Hyperlink}.[br/][br/]Grants {GLOBAL.PROPERTIES.CULT_FEATHERED_GOD_THRESHOLD_EVENT.Hyperlink} to all units produced in the city."

msgid "TOME_FATEWEAVERS@HERO_SKILL@NAME"
msgstr "Chaotic Channeling"

msgid "TOME_FATEWEAVERS@HERO_SKILL@DESCRIPTION"
msgstr "Add 20 {GLOBAL.CombatCastingPointConcept.Hyperlink} to this combat, but suffer 2 random status ailments."

msgid "TOME_FATEWEAVERS@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[Teleporter/] Chaos Rift"

msgid "TOME_FATEWEAVERS@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+5 {GLOBAL.ManaConcept.Hyperlink}. [bullet/]+3 {GLOBAL.ManaConcept.Hyperlink} per adjacent {GLOBAL.ConduitConcept.Hyperlink} and ashlands province. [bullet/]Counts as a {GLOBAL.TeleporterConcept.Hyperlink}."

msgid "TOME_FATEWEAVERS@ENTHRALLED@NAME"
msgstr "Enthralled"

msgid "TOME_FATEWEAVERS@ENTHRALLED@DESCRIPTION"
msgstr "All attacks targeting this unit are {GLOBAL.FlankingConcept.Hyperlink} attacks."

msgid "TOME_FATEWEAVERS@ABILITY1@DESCRIPTION"
msgstr "Units in a 1 hex radius sustain:[bulletlist][bullet/]22 {GLOBAL.PhysicalDamageConcept.Hyperlink}. [bullet/]Have a base 40% chance of becoming {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}. If unsuccessful, they become {GLOBAL.PROPERTIES.SLOWED.Hyperlink}."

msgid "TOME_FATEWEAVERS@UNIT1@ABILITY2@NAME"
msgstr "Chaotic Boons"

msgid "TOME_FATEWEAVERS@UNIT1@ABILITY2@DESCRIPTION"
msgstr "When this unit has less than 75% of its health remaining at the start of each turn:[bulletlist] [bullet/]70% chance of gaining a random beneficial status effect. [bullet/]30% chance of receiving a random negative status effect."

msgid "TOME_FATEWEAVERS@UNIT2@ABILITY1@NAME"
msgstr "Chaotic Rage"

msgid "TOME_FATEWEAVERS@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Driven mad by chaotic energy, this unit is uncontrollable and will only attack the closest enemy."

msgid "TOME_FATEWEAVERS@UNIT2@ABILITY2@NAME"
msgstr "Astral Spawn"

msgid "TOME_FATEWEAVERS@UNIT2@ABILITY2@DESCRIPTION"
msgstr "Astral Spawn"

msgid "TOME_FATEWEAVERS@UNIT2@ABILITY3@NAME"
msgstr "Attunement: Flow"

msgid "TOME_FATEWEAVERS@UNIT2@ABILITY3@DESCRIPTION"
msgstr "Regain 10 <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> whenever a friendly spell is cast."

msgid "TOME_FATEWEAVERS@WEAVER@NAME"
msgstr ""

msgid "TOME_FATEWEAVERS@WEAVER@DESCRIPTION"
msgstr ""