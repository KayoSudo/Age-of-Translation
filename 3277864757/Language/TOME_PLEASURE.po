msgid "TOME_PLEASURE@TOME@NAME"
msgstr "Tome of Excess"

msgid "TOME_PLEASURE@TOME@LORE_DESCRIPTION"
msgstr "\"There is nothing my Prince cannot give you. No desire that he cannot fulfill. You will forget everything that once held you back; your family, your gods, your inhibitions. We can give you everything you could ever dream of. You will taste the sweetest wine, the most delicious food, and your heart will be filled with love. Take my hand, feel how soft it is against yours, stay with me, forever...\""

msgid "TOME_PLEASURE@TOME@LORE_AUTHOR"
msgstr "Anok, Princess of Temptation"

msgid "TOME_PLEASURE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Fill your heart with bliss and know the sensation of clashing blades. Dance across the battlefield at lightning speeds, and make your enemies understand the thrill of battle."

msgid "TOME_PLEASURE@SKILL_1@NAME"
msgstr "Whip of the Masochists"

msgid "TOME_PLEASURE@SKILL_1@DESCRIPTION"
msgstr ""
"Target friendly unit:[bulletlist][bullet/]Sustain 10 {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Gain {GLOBAL.PROPERTIES.VEC_MAXIMUM_TENACITY.Hyperlink} for 2 turns[bullet/]Gain 15 {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]Gain {GLOBAL.PROPERTIES.HASTENED.Hyperlink}[/bulletlist]\n"
"Target friendly units in a 1-hex radius:[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.FORTUNE.Hyperlink}[bullet/]Remove 1 Negative Status effect if they have {GLOBAL.PROPERTIES.BLISSFUL_CRUELTY.Hyperlink}[/bulletlist]"

msgid "TOME_PLEASURE@SKILL_2@NAME"
msgstr "Cult of Excess"

msgid "TOME_PLEASURE@SKILL_2@DESCRIPTION"
msgstr "For each {GLOBAL.CityStabilityConcept.Hyperlink} level above neutral the city gains:[bulletlist][bullet/]+5 {GLOBAL.GoldConcept.Hyperlink}.[bullet/]+5 {GLOBAL.ManaConcept.Hyperlink}. [/bulletlist][br/]For each {GLOBAL.CityStabilityConcept.Hyperlink} level below neutral the city gains:[bulletlist][bullet/]+7 {GLOBAL.GoldConcept.Hyperlink}.[bullet/]+7 {GLOBAL.ManaConcept.Hyperlink}.[/bulletlist] [br/]Grants {GLOBAL.PROPERTIES.BLISSFUL_CRUELTY.Hyperlink} to every {GLOBAL.UnitConcept.Hyperlink} produced in this {GLOBAL.CityConcept.Hyperlink}."

msgid "TOME_PLEASURE@SKILL_3@NAME"
msgstr "Prince of Excess"

msgid "TOME_PLEASURE@SKILL_3@DESCRIPTION"
msgstr "Prince of Excess live for the thrill of battle, rushing as quickly into combat without regard for their own safety, hoping to be the first to make the clash of steel ring."

msgid "TOME_PLEASURE@SKILL_4@NAME"
msgstr "Mark of the Sadistic"

msgid "TOME_PLEASURE@SKILL_4@DESCRIPTION"
msgstr "Granted the Mark of the Silver Prince, your race gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink}[bullet/]Flanking attacks bypass 1 {GLOBAL.DefenseConcept.Hyperlink} and {GLOBAL.ResistanceConcept.Hyperlink}"

msgid "TOME_PLEASURE@SKILL_5@NAME"
msgstr "Festival of Mindless Ecstasy"

msgid "TOME_PLEASURE@SKILL_5@DESCRIPTION"
msgstr "Units recruited through {GLOBAL.RequestMilitaryAidConcept.Hyperlink} from the target {GLOBAL.PvEVassalConcept.Hyperlink} have {GLOBAL.PROPERTIES.BLISSFUL_CRUELTY.Hyperlink}.[br/]The Vassal city grants the player 10 {GLOBAL.GoldConcept.Hyperlink} each {GLOBAL.TurnConcept}."

msgid "TOME_PLEASURE@SKILL_6@NAME"
msgstr "Aroma of Excess"

msgid "TOME_PLEASURE@SKILL_6@DESCRIPTION"
msgstr "Enemy units in 1 hex radius sustain:[bulletlist][bullet/]15 {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Have a 90% chance to suffer the {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} status condition."

msgid "TOME_PLEASURE@HERO_SKILL@NAME"
msgstr "Distracting Pheremones"

msgid "TOME_PLEASURE@HERO_SKILL@DESCRIPTION"
msgstr "Adjacent enemies have a base 60% chance to become {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} at the start of each turn."

msgid "TOME_PLEASURE@PROVINCE_IMPROVEMENT1@NAME"
msgstr "[mine/] Chamber of Hedonism"

msgid "TOME_PLEASURE@PROVINCE_IMPROVEMENT1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+7 {GLOBAL.GoldConcept.Hyperlink}.[bullet/]+7 {GLOBAL.FoodConcept.Hyperlink}. [bullet/]+3 {GLOBAL.GoldConcept.Hyperlink} and {GLOBAL.FoodConcept.Hyperlink} per adjacent ashlands province and {GLOBAL.ResearchPostConcept.Hyperlink}. [bullet/] +3 {GLOBAL.GoldConcept.Hyperlink} and {GLOBAL.FoodConcept.Hyperlink} for each {GLOBAL.AlignmentConcept.Hyperlink} below Neutral. [bullet/]Counts as a {GLOBAL.MineConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_PLEASURE@UNIT1@ABILITY1@NAME"
msgstr "Chaotic Flanker"

msgid "TOME_PLEASURE@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Flanking attacks have a 60% chance of inflicting a random negative status ailment."

msgid "TOME_PLEASURE@UNIT1@ABILITY2@NAME"
msgstr "Prince's Gaze"

msgid "TOME_PLEASURE@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Grant enemy unit the notice of your Prince."

msgid "TOME_PLEASURE@UNIT2@ABILITY1@NAME"
msgstr ""

msgid "TOME_PLEASURE@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Frost Breath"

msgid "TOME_PLEASURE@UNIT2@ABILITY2@NAME"
msgstr "Maximum Tenacity"

msgid "TOME_PLEASURE@UNIT2@ABILITY2@DESCRIPTION"
msgstr "Ignore <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>."

msgid "TOME_PLEASURE@UNIT2@ABILITY3@NAME"
msgstr "Ancient Blessing"

msgid "TOME_PLEASURE@UNIT2@ABILITY3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain +30 {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Has negative status effects removed.[bullet/]Enters defense mode."

msgid "TOME_PLEASURE@UNIT1@NAME_OVERRIDE"
msgstr "Thorn Strike"

msgid "TOME_PLEASURE@STATUS1@NAME"
msgstr "Blissful Cruelty"

msgid "TOME_PLEASURE@STATUS2@NAME"
msgstr "When this unit takes damage:[bulletlist][bullet/]Once per turn, gain {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and suffer {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}[bullet/]Gain 10 {GLOBAL.MoraleConcept.Hyperlink}.[bullet/]."

msgid "TOME_PLEASURE@STATUS1@DESCRIPTION"
msgstr "When this unit takes damage:[bulletlist][bullet/]Once per turn, gain {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and suffer {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}[bullet/]Gain 10 {GLOBAL.MoraleConcept.Hyperlink}.[bullet/]."

