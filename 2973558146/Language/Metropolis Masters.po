msgid "SMST@METROPOLISMASTERS@NAME"
msgstr "Metropolis Masters"

msgid "SMST@METROPOLISMASTERS@DESCRIPTION"
msgstr ""
"They are builders of a city so glorious, they have no need for another. \n"
"Added from So Many Society Traits mod."

msgid "SMST@METROPOLISMASTERS@TOOLTIP"
msgstr ""

msgid "SMST@METROPOLISMASTERS@EFFECT1"
msgstr "Cannot obtain new [hyperlink,GLOBAL.CityConcept]Cities[/hyperlink]."

msgid "SMST@METROPOLISMASTERS@EFFECT2"
msgstr "-25% {GLOBAL.PvEVassalConcept.Hyperlink} Income."

msgid "SMST@METROPOLISMASTERS@EFFECT3"
msgstr "Your {GLOBAL.ThroneCityConcept.Hyperlink} has +3 {GLOBAL.FoodConcept.Hyperlink}, +1 {GLOBAL.GoldConcept.Hyperlink}, +1 {GLOBAL.UnitProductionConcept.Hyperlink}, +1 {GLOBAL.ManaConcept.Hyperlink}, and +1 {GLOBAL.KnowledgeConcept.Name} per {GLOBAL.CityStructureConcept.Hyperlink} built, and per {GLOBAL.PopulationConcept.Hyperlink}. Additionally, your {GLOBAL.ThroneCityConcept.Hyperlink} has +25 {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "SMST@METROPOLISMASTERS@EFFECT4"
msgstr "[hyperlink,GLOBAL.CityConcept]Cities[/hyperlink] can perform {GLOBAL.ProvinceAnnexationConcept.Hyperlink} +5 [hyperlink,GLOBAL.ProvinceConcept]Provinces[/hyperlink] further away."

msgid "SMST@METROPOLISMASTERS@EFFECT5"
msgstr ""
