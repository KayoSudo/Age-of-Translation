msgid "SMST@ARACHNIDBREEDERS@NAME"
msgstr "Arachnid Breeders"

msgid "SMST@ARACHNIDBREEDERS@DESCRIPTION"
msgstr ""
"They are obsessed with the fang, venom, and web.\n"
"Added from So Many Society Traits mod."

msgid "SMST@ARACHNIDBREEDERS@TOOLTIP"
msgstr "[bulletlist][bullet/]Cities can train two types of unique {GLOBAL.PROPERTIES.SPIDER.Hyperlink}s.[bullet/]{GLOBAL.PROPERTIES.SPIDER.Hyperlink}s regenerate an additional +5 {GLOBAL.HitPointConcept.Hyperlink} while {GLOBAL.UndergroundConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}.[bullet/]Start with an extra unique {GLOBAL.PROPERTIES.SPIDER.Hyperlink}.[/bulletlist]"

msgid "SMST@ARACHNIDBREEDERS@EFFECT1"
msgstr "Cities can train two types of unique [hyperlink,GLOBAL.PROPERTIES.SPIDER]Spiders[/hyperlink]."

msgid "SMST@ARACHNIDBREEDERS@EFFECT2"
msgstr "[hyperlink,GLOBAL.PROPERTIES.SPIDER]Spiders[/hyperlink] regenerate an additional +10 [hyperlink,GLOBAL.HitPointConcept][hp/] Hit Points[/hyperlink] per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}."

msgid "SMST@ARACHNIDBREEDERS@EFFECT3"
msgstr "[hyperlink,GLOBAL.PROPERTIES.SPIDER]Spiders[/hyperlink] have +2 Rank."

msgid "SMST@ARACHNIDBREEDERS@EFFECT4"
msgstr "Start with an extra unique [hyperlink,GLOBAL.PROPERTIES.SPIDER]Spider[/hyperlink]."

msgid "SMST@ARACHNIDBREEDERS@EFFECT5"
msgstr ""
