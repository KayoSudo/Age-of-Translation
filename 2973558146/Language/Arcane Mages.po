msgstr "Arcane Mages"

msgid "SMST@ARCANEMAGES@DESCRIPTION"
msgstr ""
"They are unmatched in their ability to harness magic.\n"
"Added from So Many Society Traits mod."

msgid "SMST@ARCANEMAGES@TOOLTIP"
msgstr ""

msgid "SMST@ARCANEMAGES@EFFECT1"
msgstr "[hyperlink,GLOBAL.CombatSpellConcept]Combat Spells[/hyperlink] cost 15% more {GLOBAL.ManaConcept.Hyperlink}."

