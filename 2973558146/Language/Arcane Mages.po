msgid "SMST@ARCANEMAGES@EFFECT3"
msgstr "All Non-{GLOBAL.PhysicalDamageConcept.Hyperlink} your units and spells deal is increased by 15%."

msgid "SMST@ARCANEMAGES@EFFECT4"
msgstr "Units have +2 {GLOBAL.FireResistanceConcept.Hyperlink}, {GLOBAL.FrostResistanceConcept.Hyperlink}, and {GLOBAL.LightningResistanceConcept.Hyperlink}."

