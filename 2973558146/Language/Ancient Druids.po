msgid "SMST@ANCIENTDRUIDS@NAME"
msgstr "Ancient Druids"

msgid "SMST@ANCIENTDRUIDS@DESCRIPTION"
msgstr ""
"They create mighty forests and tend to all who call them home.\n"
"Added from So Many Society Traits mod."

msgid "SMST@ANCIENTDRUIDS@TOOLTIP"
msgstr ""

msgid "SMST@ANCIENTDRUIDS@EFFECT1"
msgstr ""
"Forest Temples [hyperlink,GLOBAL.TerraformingSpellConcept]Terraform[/"
"hyperlink] 1 {GLOBAL.ProvinceConcept.Hyperlink} per 2 {GLOBAL."
"WorldMapConcept.Hyperlink} [turn/] [hyperlink,GLOBAL.TurnConcept]Turns[/"
"hyperlink] into a Forest; the distance is 1 {GLOBAL.ProvinceConcept."
"Hyperlink} beyond your {GLOBAL.DomainConcept.Hyperlink}. Cannot work {GLOBAL."
"UndergroundConcept.Hyperlink}."

msgid "SMST@ANCIENTDRUIDS@EFFECT2"
msgstr ""
"Units gain {GLOBAL.PROPERTIES.EXPEDITED_FOREST.Hyperlink} for faster "
"movement across Forests."

msgid "SMST@ANCIENTDRUIDS@EFFECT3"
msgstr ""
"[forester/][/hyperlink][GLOBAL.ForesterConcept.Hyperlink]Foresters[/"
"hyperlink] have +1 {GLOBAL.ManaConcept.Hyperlink} and benefit from "
"[food/]Soiltenders."

msgid "SMST@ANCIENTDRUIDS@EFFECT4"
msgstr "[hyperlink,GLOBAL.PROPERTIES.ANIMAL]Animals[/hyperlink] have +1 Rank."

msgid "SMST@ANCIENTDRUIDS@EFFECT5"
msgstr ""
"Cities can build a Forest Temple {GLOBAL.CityStructureConcept.Hyperlink}."

msgid "SMST@ANCIENTDRUIDS@EFFECT6"
msgstr ""

msgid "SMST@ANCIENTDRUIDS@EFFECT7"
msgstr "Forest Temple"

msgid "SMST@ANCIENTDRUIDS@EFFECT8"
msgstr ""
"[hyperlink,GLOBAL.TerraformingSpellConcept]Terraforms[/hyperlink] 1 {GLOBAL."
"ProvinceConcept.Hyperlink} per 2 {GLOBAL.WorldMapConcept.Hyperlink} [turn/] "
"[hyperlink,GLOBAL.TurnConcept]Turns[/hyperlink] into a Forest; the distance "
"is 1 {GLOBAL.ProvinceConcept.Hyperlink} beyond your {GLOBAL.DomainConcept."
"Hyperlink}. Cannot work {GLOBAL.UndergroundConcept.Hyperlink}."

msgid "SMST@ANCIENTDRUIDS@EFFECT9"
msgstr ""
