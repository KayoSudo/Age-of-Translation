msgid "SMST@HELLCULTISTS@NAME"
msgstr "Harbingers of Ruin [evilact/]"

msgid "SMST@HELLCULTISTS@DESCRIPTION"
msgstr ""
"They seek to incinerate the whole world into ashes.\n"
"Added from So Many Society Traits mod."

msgid "SMST@HELLCULTISTS@TOOLTIP"
msgstr ""

msgid "SMST@HELLCULTISTS@EFFECT1"
msgstr ""
"Ritual Sites [hyperlink,GLOBAL.TerraformingSpellConcept]Terraform[/"
"hyperlink] 1 {GLOBAL.ProvinceConcept.Hyperlink} each {GLOBAL."
"WorldMapConcept.Hyperlink} [turn/] [hyperlink,GLOBAL.TurnConcept]Turn[/"
"hyperlink] into Ashlands; spreads to [hyperlink,GLOBAL."
"ProvinceConcept]Provinces[/hyperlink] beyond your {GLOBAL.DomainConcept."
"Hyperlink} equal to your [hyperlink,GLOBAL.CityCenterConcept]City Center[/"
"hyperlink] level."

msgid "SMST@HELLCULTISTS@EFFECT2"
msgstr ""
"{GLOBAL.PROPERTIES.LAND_MOVEMENT.Hyperlink} through Ashlands costs -1 "
"[hyperlink,GLOBAL.MovePointConcept]Move Point[/hyperlink]."

msgid "SMST@HELLCULTISTS@EFFECT3"
msgstr ""
"+2 {GLOBAL.UnitProductionConcept.Hyperlink} in Ashland [hyperlink,GLOBAL."
"ProvinceConcept]Provinces[/hyperlink]."

msgid "SMST@HELLCULTISTS@EFFECT4"
msgstr ""
"[hut/] [hyperlink,GLOBAL.HutConcept]Huts[/hyperlink] have +3 {GLOBAL."
"FoodConcept.Hyperlink} and +3 {GLOBAL.StructureProductionConcept.Hyperlink}."

msgid "SMST@HELLCULTISTS@EFFECT5"
msgstr "-10 [evilact/] Alignment."

msgid "SMST@HELLCULTISTS@EFFECT6"
msgstr ""
"Cities can build a Ritual Site {GLOBAL.CityStructureConcept.Hyperlink}."

msgid "SMST@HELLCULTISTS@EFFECT7"
msgstr "Ritual Site"

msgid "SMST@HELLCULTISTS@EFFECT8"
msgstr ""
"[hyperlink,GLOBAL.TerraformingSpellConcept]Terraforms[/hyperlink] 1 {GLOBAL."
"ProvinceConcept.Hyperlink} each {GLOBAL.WorldMapConcept.Hyperlink} [turn/] "
"[hyperlink,GLOBAL.TurnConcept]Turn[/hyperlink] into Ashlands; the distance "
"is 2 [hyperlink,GLOBAL.ProvinceConcept]Provinces[/hyperlink] beyond your "
"{GLOBAL.DomainConcept.Hyperlink}."

msgid "SMST@HELLCULTISTS@EFFECT9"
msgstr ""
"Units gain {GLOBAL.PROPERTIES.DESOLATE_WALK.Hyperlink} for faster movement "
"across Ashlands."
