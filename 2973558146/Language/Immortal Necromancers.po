msgid "SMST@IMMORTALNECROMANCERS@NAME"
msgstr "Immortal Necromancers"

msgid "SMST@IMMORTALNECROMANCERS@DESCRIPTION"
msgstr ""
"They do not fear death - they rule it as its master.\n"
"Added from So Many Society Traits mod."

msgid "SMST@IMMORTALNECROMANCERS@TOOLTIP"
msgstr ""

msgid "SMST@IMMORTALNECROMANCERS@EFFECT1"
msgstr "Start with 2 extra Tier 1 {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}."

msgid "SMST@IMMORTALNECROMANCERS@EFFECT2"
msgstr "[hyperlink,GLOBAL.PROPERTIES.SUPPORT_UNIT]Support Units[/hyperlink] and [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Battle Mage Units[/hyperlink] transform into a temporary {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} unit upon dying. It is lost at the end of combat."

msgid "SMST@IMMORTALNECROMANCERS@EFFECT3"
msgstr "{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units cost 25% less {GLOBAL.ManaConcept.Hyperlink} to maintain."

